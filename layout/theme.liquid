{%- capture direction -%}{% render 'direction' %}{%- endcapture -%}
<!doctype html>
<html class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}" lang="{{ request.locale.iso_code }}" dir="{{ direction }}">
  <head>
    <meta name="google-site-verification" content="sUlwiwxCvqAifCPVhgdaRZk8z6DHVvwkHkpQzKftpLQ" />
    <meta name="google-site-verification" content="MtrggpmmV_j7s-aBIWnHJ-IMQlxf866ovpfpv2s8HIo" />
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_button_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- comment %}theme-check-disable RemoteAsset{% endcomment %}
    <link rel="dns-prefetch" href="https://ajax.googleapis.com">
    <link rel="dns-prefetch" href="https://maps.googleapis.com">
    <link rel="dns-prefetch" href="https://maps.gstatic.com">
    {%- comment %}theme-check-enable RemoteAsset{% endcomment %}

    {%- if settings.favicon != blank -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png" />
    {%- endif -%}

    <script
      src="https://studio.contona.ai/js/contona-loader.js"
      data-api-key="ZtrRpUyoKjp7mgrBN1Z2iaSbHaVRO8Ro"
      data-base-url="https://studio.contona.ai"
      async
    ></script>

    <title>
      {{- page_title -}}
      {%- if current_tags -%}
        {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
      {%- endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- if request.page_type == 'password' -%}
        {{- shop.name -}}
      {%- else -%}
        {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
      {%- endif -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- liquid
      render 'social-meta-tags'
      
      render 'css-variables'
      echo 'theme.css' | asset_url | stylesheet_tag: preload: true

      assign wave_help = false
      if request.page_type == 'page'
        if template.suffix == 'shipping-returns' or template.suffix == 'warranty'
          assign wave_help = true
        endif
      endif

      if request.page_type == 'policy' or wave_help
        echo 'wave-policy.css' | asset_url | stylesheet_tag
      endif
      if request.page_type == 'policy'
        assign wave_doc_js = 'wave-doc.js' | asset_url
        echo '<script src="' | append: wave_doc_js | append: '" defer="defer"></script>'
      endif

      if direction == 'rtl'
        echo 'rtl.css' | asset_url | stylesheet_tag: preload: true
      endif
    -%}

    <link rel="stylesheet" href="{{ 'apps.css' | asset_url }}" media="print" fetchpriority="low" onload="this.media='all'">

    {%- comment -%}
      Zendesk embedded mode: on the contact template, stop the messaging widget
      from auto-rendering as a floating bubble so the "Zendesk Chat Bot" section
      can render it inline in the page. Must run before the Zendesk snippet
      (injected via content_for_header below).
    {%- endcomment -%}
    {%- if template.suffix == 'contact' -%}
      <script>
        window.zEMessenger = window.zEMessenger || {};
        window.zEMessenger.autoRender = false;
        window.zEMessenger.autorender = false;
      </script>
    {%- endif -%}

    {%- comment -%}
      Hreflang for regional product listings.
      Shopify's automatic hreflang tags (inside content_for_header) drop the
      markets whose catalog doesn't carry the product, but they always keep the
      root (UK) alternates: x-default, en, /de and /fr. Regional listings such as
      garda-hot-tub-ce (EU) and garda-hot-tub-etl (US) aren't in the UK catalog,
      so those four URLs 404 and then 301 via the shop's URL redirects. Semrush
      flagged 2,775 of these "hreflang redirect" links on 2026-11-10.

      A product isn't sold on the root when its custom.uk_override_url points to
      a different listing (EU/US variants all carry the UK handle there). For
      those products, remove every alternate whose path has no market subfolder
      (/products/..., /de/products/..., /fr/products/...). The /en-xx market
      alternates are left untouched. This works by matching strings only, so if
      Shopify changes its markup the tags pass through unchanged.
    {%- endcomment -%}
    {%- liquid
      assign strip_root_hreflang = false
      if template.name == 'product'
        assign uk_listing = product.metafields.custom.uk_override_url.value | default: ''
        assign own_listing = 'products/' | append: product.handle
        if uk_listing != blank and uk_listing != own_listing
          assign strip_root_hreflang = true
        endif
      endif
    -%}
    {%- if strip_root_hreflang -%}
      {%- assign alt_marker = '<link rel="alternate" hreflang="' -%}
      {%- assign alt_chunks = content_for_header | split: alt_marker -%}
      {%- capture filtered_header -%}
        {%- for chunk in alt_chunks -%}
          {%- if forloop.first -%}
            {{- chunk -}}
            {%- continue -%}
          {%- endif -%}
          {%- assign alt_tag = chunk | split: '>' | first -%}
          {%- assign alt_href = alt_tag | split: 'href="' | last | split: '"' | first -%}
          {%- assign first_segment = alt_href | split: '/' | slice: 3 | first -%}
          {%- if first_segment contains '-' -%}
            {{- alt_marker -}}{{- chunk -}}
          {%- else -%}
            {{- chunk | remove_first: alt_tag | remove_first: '>' -}}
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {{ filtered_header }}
    {%- else -%}
      {{ content_for_header }}
    {%- endif -%}

    <script src="{{ 'vendor.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {%- if settings.enable_tab_attention -%}
      <script src="{{ 'tab-attention.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if request.page_type contains 'customers/' -%}
      <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- render 'js-variables' -%}
   <meta name="google-site-verification" content="f57o3N79goUNxocJABrxU8MIGEQ4qIhZoBvqlvEjN6c" />
  </head>

  <body class="template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }}{% if request.path == '/challenge' %} template-challange{% endif %}" data-rounded-button="{{ settings.rounded_button }}" data-rounded-input="{{ settings.rounded_input }}" data-rounded-block="{{ settings.rounded_block }}" data-rounded-card="{{ settings.rounded_card }}" data-button-hover="{{ settings.buttons_hover }}"{% if settings.enable_page_transition %} data-page-transition{% endif %}{% if settings.enable_lazy_image %} data-lazy-image{% endif %}{% unless settings.show_modal_close_button %} data-modal-swipe-only{% endunless %}{% unless settings.show_trustpilot_logo %} data-hide-trustpilot-logo{% endunless %} data-title-animation data-page-rendering>
    <a class="sr-only skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- liquid
      if settings.enable_page_transition
        render 'loading-bar'
      endif
      
      render 'mouse-cursor'

      sections 'header-group'
      sections 'overlay-group'
    -%}

    <div class="page-container" id="PageContainer">
      <main class="main-content relative{% if wave_help %} wh--doc{% endif %}" id="MainContent" role="main">
        {%- if request.page_type == 'policy' -%}{%- render 'wave-policy', part: 'start' -%}{%- endif -%}
        {{ content_for_layout }}
        {%- if request.page_type == 'policy' -%}{%- render 'wave-policy', part: 'end' -%}{%- endif -%}
      </main>

      <footer class="footer-group block w-full" is="footer-group">
        {%- sections 'footer-group' -%}
      </footer>
    </div>

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'general.accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'general.accessibility.link_messages.new_window' | t }}</li>
    </ul>

    {%- if request.design_mode == false and settings.preload_links -%}
      <script src="{{ 'instant-page.js' | asset_url }}" type="module" fetchpriority="low" defer="defer"></script>
    {%- endif -%}
  </body>
</html>
