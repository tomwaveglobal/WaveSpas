<style>
  #shopify-section-{{ section.id }} {
    --gradient-background: {% if section.settings.gradient_background != blank %}{{ section.settings.gradient_background }}{% else %}{{ section.settings.color_background }}{% endif %};
    --color-background: {{ section.settings.color_background.rgb }};
    --color-foreground: {{ section.settings.color_text.rgb }};
  }
</style>

<div class="section{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded{% endif %}"{% if section.settings.enable_parallax %} is="footer-parallax"{% endif %}>
  <div class="footer-copyright page-width{% if section.settings.full_width %} page-width--full{% endif %} w-full flex flex-col items-center justify-between gap-4 lg:gap-0 lg:flex-row relative">
    <div class="rte credits text-center">
      {%- liquid
        if section.settings.show_copyright
          echo '&copy;&nbsp;'
          echo 'now' | date: '%Y'
          echo '&nbsp;'
          echo shop.name
          if section.settings.copyright_text != blank
            echo '&nbsp;'
            echo section.settings.copyright_text
          endif
          echo '.&nbsp;'
        endif
        echo powered_by_link
      -%}
      {%- if section.settings.show_policy -%}
        <ul class="flex flex-wrap gap-3 justify-center lg:justify-start">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li>
                <small>
                  <a href="{{ policy.url }}" class="block reversed-link">{{ policy.title }}</a>
                </small>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- liquid
      if section.settings.enable_language_selector and localization.available_languages.size > 1
        assign enable_language_selector = true
      endif
      if section.settings.enable_country_selector and localization.available_countries.size > 1
        assign enable_country_selector = true
      endif

      assign section_rendering_api = false
      if section.index == nil
        assign section_rendering_api = true
      endif
    -%}
    {%- if enable_language_selector or enable_country_selector -%}
      <div class="localization flex items-center justify-center flex-col md:flex-row">
        {%- if enable_language_selector -%}
          <div class="grid gap-2">
            {%- form 'localization', id: 'footer_localization_language_form', class: 'localization__form flex items-center relative', is: 'localization-form' -%}
              <label class="sr-only" for="FooterLocalizationLanguageList">
                {{- 'localization.language_label' | t -}}
              </label>
              {%- render 'icon', icon: 'language', size: 'xs', class: 'stroke-1 absolute pointer-events-none' -%}
              <button type="button" class="localization__item cursor-pointer leading-tight w-full">
                {%- unless section_rendering_api -%}
                  <api-button class="api-only" data-id="FooterLocalizationLanguageList" data-section-id="{{ section.id }}"></api-button>
                {%- endunless -%}
                {{- localization.language.endonym_name | capitalize -}}
              </button>
              {%- unless section_rendering_api -%}
                <select class="localization__item cursor-pointer absolute top-0 left-0 w-full h-full opacity-0" name="locale_code" id="FooterLocalizationLanguageList">
                  <option value="{{ localization.language.iso_code }}" selected>
                    {{- localization.language.endonym_name | capitalize -}}
                  </option>
                </select>
              {%- else -%}
                <select class="localization__item cursor-pointer absolute top-0 left-0 w-full h-full opacity-0" name="locale_code" id="FooterLocalizationLanguageList">
                  {%- for language in localization.available_languages -%}
                    <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                      {{- language.endonym_name | capitalize -}}
                    </option>
                  {%- endfor -%}
                </select>
              {%- endunless -%}
              {%- render 'icon', icon: 'chevron-down', size: 'xs', class: 'absolute pointer-events-none' -%}
            {%- endform -%}
          </div>
        {%- endif -%}
        {%- if enable_country_selector -%}
          <div class="grid gap-2">
            {%- liquid
              assign uk_override = ''
              assign eu_override = ''
              assign us_override = ''
              if product.metafields.custom.uk_override_url != blank or product.metafields.custom.eu_override_url != blank or product.metafields.custom.us_override_url != blank
                assign uk_override = product.metafields.custom.uk_override_url
                assign eu_override = product.metafields.custom.eu_override_url
                assign us_override = product.metafields.custom.us_override_url
              endif
            -%}
            {%- comment -%}
              Deliberately no `is: 'localization-form'`. That component submitted
              the form on change, and Shopify then returned the visitor to the
              Liquid-rendered `return_to` — the path of the market being *left*.
              Switching country from /en-us/products/<x>-etl therefore asked for a
              US-only URL as a UK shopper and landed on the homepage. Each option
              now carries the resolved market URL in `data-url` (same resolver as
              every other country selector) and the script below navigates to it.
            {%- endcomment -%}
            {%- form 'localization', id: 'footer_localization_country_form', class: 'localization__form flex items-center relative' -%}
              <label class="sr-only" for="FooterLocalizationCountryList">
                {{- 'localization.country_label' | t -}}
              </label>
              {%- render 'icon', icon: 'currency', size: 'xs', class: 'stroke-1 absolute pointer-events-none' -%}
              <button type="button" class="localization__item cursor-pointer leading-tight w-full">
                {{- localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})
              </button>
              {%- comment -%}
                Rendered inline rather than through `api-button`. APIButton fetches
                `routes.root_url?section_id=...` — the market root, never the current
                page — and caches that response for the whole site, so the options it
                returned always pointed at market roots (/, /en-de) instead of the
                page you were on. Inline, `request.path` and `product` are correct,
                so each option carries the same target as every other selector.
              {%- endcomment -%}
              <select class="localization__item cursor-pointer absolute top-0 left-0 w-full h-full opacity-0" name="country_code" id="FooterLocalizationCountryList">
                {%- render 'localization-countries-ordered',
                  render_as: 'select_options',
                  current_country_iso: localization.country.iso_code,
                  eu_override: eu_override,
                  us_override: us_override,
                  uk_override: uk_override
                -%}
              </select>
              {%- render 'icon', icon: 'chevron-down', size: 'xs', class: 'absolute pointer-events-none' -%}
            {%- endform -%}

            {%- comment -%}
              The options are injected later by the Section Rendering API
              (`api-button` above), so bind on the document rather than the
              select, and guard against the section being re-rendered more than
              once. Falls back to submitting the form if an option somehow has no
              resolved URL, so the control is never a dead end.
            {%- endcomment -%}
            <script>
              (() => {
                if (window.__waveFooterCountryNav) return;
                window.__waveFooterCountryNav = true;
                document.addEventListener('change', (event) => {
                  const select = event.target;
                  if (!select || select.id !== 'FooterLocalizationCountryList') return;
                  const option = select.options[select.selectedIndex];
                  const url = option && option.dataset ? option.dataset.url : '';
                  if (url) {
                    window.location.href = url;
                    return;
                  }
                  const form = select.closest('form');
                  if (form) form.submit();
                });
              })();
            </script>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_payment_icons -%}
      {%- unless shop.enabled_payment_types == empty -%}
        <ul class="payment-icons{% if section.settings.monochrome_payment_icons %} payment-icons--gray{% endif %} flex flex-wrap justify-center gap-2 xl:gap-3">
          {%- for type in shop.enabled_payment_types -%}
            <li>
              {{- type | payment_type_svg_tag -}}
            </li>
          {%- endfor -%}
        </ul>
      {%- endunless -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.footer-copyright.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.footer-copyright.settings.header__language_selector.content",
      "info": "t:sections.footer-copyright.settings.header__language_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "t:sections.footer-copyright.settings.enable_language_selector.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.footer-copyright.settings.header__country_selector.content",
      "info": "t:sections.footer-copyright.settings.header__country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "t:sections.footer-copyright.settings.enable_country_selector.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.footer-copyright.settings.header__policy.content",
      "info": "t:sections.footer-copyright.settings.header__policy.info"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "label": "t:sections.footer-copyright.settings.show_policy.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.footer-copyright.settings.header__payment_methods.content"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer-copyright.settings.show_payment_icons.label",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.show_payment_icons == true }}",
      "type": "checkbox",
      "id": "monochrome_payment_icons",
      "label": "t:sections.footer-copyright.settings.monochrome_payment_icons.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.footer-copyright.settings.header__additional_content.content"
    },
    {
      "type": "checkbox",
      "id": "show_copyright",
      "label": "t:sections.footer-copyright.settings.show_copyright.label"
    },
    {
      "visible_if": "{{ section.settings.show_copyright == true }}",
      "type": "text",
      "id": "copyright_text",
      "label": "t:sections.footer-copyright.settings.copyright_text.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__colors.content",
      "info": "t:sections.global.settings.header__colors.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.global.settings.color_text.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.global.settings.color_background.label",
      "default": "#171717"
    },
    {
      "type": "color_background",
      "id": "gradient_background",
      "label": "t:sections.global.settings.gradient_background.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__section.content"
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "t:sections.global.settings.divider.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.global.settings.full_width.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "default": false,
      "label": "t:sections.global.settings.rounded.label"
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "t:sections.global.settings.enable_parallax.label",
      "default": true
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  }
}
{% endschema %}
