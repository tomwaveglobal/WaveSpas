{{ 'wave-fy27.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wave-fy27.js' | asset_url }}" defer></script>
<wf-section class="wf" id="wf-{{ section.id }}" data-wf-nav="{{ section.settings.nav_label | escape }}">
  <div class="wf__inner">
    <div class="wf-qa">
      <div class="wf-qa__intro">
        <p class="wf-eyebrow" data-wf-reveal>{{ section.settings.eyebrow }}</p>
        <h2 class="wf-h2" data-wf-reveal style="--wf-delay: .08s">{{ section.settings.heading }}</h2>
        <p class="wf-lede" data-wf-reveal style="--wf-delay: .16s">{{ section.settings.lede }}</p>
        {%- if section.settings.contact_text != blank -%}
          <p class="wf-body" data-wf-reveal style="--wf-delay: .24s;margin-top:28px">
            {{ section.settings.contact_text }}
            {%- if section.settings.contact_link != blank %}<br><a class="wf-link" href="{{ section.settings.contact_link }}">{{ section.settings.contact_label }}</a>{% endif %}
          </p>
        {%- endif -%}
      </div>

      <div class="wf-qa__list" data-wf-reveal style="--wf-delay: .1s">
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
            <summary><span class="wf-h3">{{ block.settings.question }}</span><i aria-hidden="true"></i></summary>
            <div class="wf-qa__a">
              {%- if block.settings.topic != blank -%}<span class="wf-qa__tag">{{ block.settings.topic }}</span>{%- endif -%}
              {{ block.settings.answer }}
            </div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</wf-section>

{%- if section.settings.faq_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FY27 questions",
  "settings": [
    { "type": "text", "id": "nav_label", "label": "Nav label", "default": "Questions" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before you buy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your questions, answered." },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "The things people ask us most before choosing a hot tub." },
    { "type": "textarea", "id": "contact_text", "label": "Contact text", "default": "Still deciding? Our UK team is here Monday to Friday 8:30 to 5:30, and Saturday 8 to 4." },
    { "type": "url", "id": "contact_link", "label": "Contact link" },
    { "type": "text", "id": "contact_label", "label": "Contact link label", "default": "Talk to us" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": false },
    { "type": "checkbox", "id": "faq_schema", "label": "Add FAQ structured data for search", "info": "Turn off if another FAQ section on this page already outputs FAQ schema.", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "topic", "label": "Topic", "info": "Optional small label, e.g. Running costs." },
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
