{{ 'wave-fy27.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wave-fy27.js' | asset_url }}" defer></script>
{%- liquid
  assign tier = 'lush'
  if product.tags contains 'Lite'
    assign tier = 'lite'
  elsif product.tags contains 'Luxe'
    assign tier = 'luxe'
  endif
  case tier
    when 'lite'
      assign signature = section.settings.lite_signature
      assign lede = section.settings.lite_lede
    when 'luxe'
      assign signature = section.settings.luxe_signature
      assign lede = section.settings.luxe_lede
    else
      assign signature = section.settings.lush_signature
      assign lede = section.settings.lush_lede
  endcase

  assign name = product.title | split: '|' | first | strip
  assign kf = product.metafields.custom.key_features | metafield_text
  assign is_ice = false
  if product.tags contains 'Ice Bath' or product.tags contains 'cold plunge'
    assign is_ice = true
  endif

  assign seats = 0
  assign size_option = product.options_by_name['Size']
  for value in size_option.values
    assign n = value | split: ' ' | first | plus: 0
    if n > seats
      assign seats = n
    endif
  endfor

  assign rate = section.settings.rate_gbp
  assign cur_symbol = '£'
  case cart.currency.iso_code
    when 'EUR'
      assign rate = section.settings.rate_eur
      assign cur_symbol = '€'
    when 'USD'
      assign rate = section.settings.rate_usd
      assign cur_symbol = '$'
  endcase
  assign kwh = product.metafields.specs.kwh_per_day.value
  assign month_cost = nil
  if kwh != blank
    assign month_cost = kwh | times: section.settings.usage_days | times: rate | divided_by: 100.0 | round
  endif
  assign setup_minutes = product.metafields.specs.setup_minutes.value | default: section.settings.setup_minutes

  assign hero = section.settings.image | default: product.featured_media.preview_image
-%}
<style>
  #shopify-section-{{ section.id }} .wf-ov__stage { background-color: {{ section.settings.stage_color }}; }
</style>
<wf-section class="wf" id="wf-{{ section.id }}" data-wf-nav="{{ section.settings.nav_label | escape }}">
  <div class="wf__inner">
    <div class="wf-ov__top">
      <div class="wf-head">
        <p class="wf-eyebrow wf-eyebrow--accent" data-wf-reveal>{{ name }}</p>
        <h2 class="wf-display" data-wf-reveal style="--wf-delay: .08s">{{ signature }}</h2>
        <p class="wf-lede" data-wf-reveal style="--wf-delay: .16s">{{ lede }}</p>
      </div>

      <ul class="wf-facts" role="list" data-wf-reveal style="--wf-delay: .24s">
        {%- if seats > 0 -%}
          <li><span class="wf-fig"><span data-wf-count="{{ seats }}">{{ seats }}</span></span><p class="wf-small">{% if tier == 'lite' or seats == 1 %}{{ section.settings.people_label }}{% else %}{{ section.settings.seats_label }}{% endif %}</p></li>
        {%- endif -%}
        {%- unless is_ice -%}
          <li><span class="wf-fig"><span data-wf-count="40">40</span><small>°C</small></span><p class="wf-small">{{ section.settings.heat_label }}</p></li>
        {%- endunless -%}
        {%- if month_cost != nil -%}
          <li><span class="wf-fig"><span data-wf-count="{{ month_cost }}" data-prefix="{{ cur_symbol }}">{{ cur_symbol }}{{ month_cost }}</span><small>/month</small></span><p class="wf-small">{{ section.settings.cost_label }}</p></li>
        {%- endif -%}
        {%- if setup_minutes != blank and setup_minutes > 0 -%}
          <li><span class="wf-fig"><span data-wf-count="{{ setup_minutes }}">{{ setup_minutes }}</span><small>min</small></span><p class="wf-small">{{ section.settings.setup_label }}</p></li>
        {%- endif -%}
      </ul>
    </div>

    {%- liquid
      assign glb = blank
      assign usdz = blank
      assign poster = blank
      assign model_media = product.media | where: 'media_type', 'model' | first
      if model_media
        for src in model_media.sources
          if src.format == 'glb'
            assign glb = src.url
          elsif src.format == 'usdz'
            assign usdz = src.url
          endif
        endfor
        assign poster = model_media.preview_image | image_url: width: 1600
      elsif section.settings.model_url != blank and section.settings.model_match != blank and product.title contains section.settings.model_match
        assign glb = section.settings.model_url
        assign usdz = section.settings.model_usdz
        assign poster = section.settings.model_poster
      endif
    -%}
    {%- if glb != blank -%}
      <wf-model class="wf-ov__stage wf-ov__stage--model" data-wf-reveal>
        {%- if poster != blank -%}
          <img class="wf-model__poster" src="{{ poster }}" alt="{{ name | escape }}" loading="lazy" width="1024" height="1024">
        {%- endif -%}
        <div class="wf-model__viewer" data-viewer></div>
        <template>
          <model-viewer
            src="{{ glb }}"
            {% if usdz != blank %}ios-src="{{ usdz }}"{% endif %}
            alt="{{ section.settings.model_alt | replace: '[product]', name | escape }}"
            camera-controls
            auto-rotate
            auto-rotate-delay="0"
            rotation-per-second="12deg"
            interaction-prompt="none"
            disable-zoom
            shadow-intensity="1"
            shadow-softness="0.8"
            exposure="1.05"
            environment-image="neutral"
            camera-orbit="35deg 72deg auto"
            ar
            ar-modes="webxr scene-viewer quick-look"
          >
            <button slot="ar-button" class="wf-model__ar">{{ section.settings.ar_label }}</button>
          </model-viewer>
        </template>
        <button type="button" class="wf-model__load" data-load>
          {%- render 'wave-fy27-glyph', name: 'cube', class: 'wf-model__icon' -%}
          <span>{{ section.settings.load_label }}</span>
        </button>
        <span class="wf-model__spinner" aria-hidden="true"></span>
        <p class="wf-model__hint">{{ section.settings.drag_label }}</p>
      </wf-model>
    {%- elsif hero != blank -%}
      <div class="wf-ov__stage{% if section.settings.contain %} wf-ov__stage--contain{% endif %}" data-wf-reveal>
        {{- hero | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '(min-width: 1280px) 1240px, 100vw', widths: '750, 1100, 1500, 2000, 2400', alt: name -}}
      </div>
    {%- endif -%}

    <div class="wf-cols" style="--cols: 3">
      {%- assign shown = 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          if block.settings.tier != 'all' and block.settings.tier != tier
            continue
          endif
          if block.settings.requires != blank
            unless kf contains block.settings.requires or product.tags contains block.settings.requires
              continue
            endunless
          endif
          assign shown = shown | plus: 1
          assign delay = shown | minus: 1 | modulo: 4 | times: 0.08
        -%}
        <article data-wf-reveal style="--wf-delay: {{ delay }}s" {{ block.shopify_attributes }}>
          {%- render 'wave-fy27-glyph', name: block.settings.glyph, class: 'wf-glyph' -%}
          <h3 class="wf-h3">{{ block.settings.title }}</h3>
          <p class="wf-body">{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_notes -%}
      <p class="wf-note">Test note: running cost = {{ kwh | default: '—' }} kWh a day × {{ section.settings.usage_days }} days × {{ rate }}{% if cur_symbol == '£' %}p{% else %}c{% endif %}, the same method as the Wave running cost calculator page, for the largest size. The 3D model is Garda.glb from Shopify Files (43.7 MB, the FY26 Garda), so swap it for an FY27 model when one exists. Setup minutes come from <code>specs.setup_minutes</code> when set, otherwise the section setting ({{ section.settings.setup_minutes }}). Benefit cards filter by tier tag, and by "Only when the product mentions". Turn these notes off before launch.</p>
    {%- endif -%}
  </div>
</wf-section>

{% schema %}
{
  "name": "FY27 overview",
  "settings": [
    { "type": "text", "id": "nav_label", "label": "Nav label", "default": "Overview" },
    { "type": "image_picker", "id": "image", "label": "Hero image", "info": "Leave empty to use the product's featured image." },
    { "type": "checkbox", "id": "contain", "label": "Fit whole image (use for cut-out product shots)", "default": false },
    { "type": "header", "content": "3D model" },
    { "type": "paragraph", "content": "A product's own 3D media is used first. Otherwise the model below shows on products whose title contains the match text. The image above is used when neither applies." },
    { "type": "text", "id": "model_match", "label": "Show the model when the product title contains", "default": "Garda" },
    { "type": "text", "id": "model_url", "label": "Model file (.glb URL)" },
    { "type": "text", "id": "model_usdz", "label": "iPhone AR file (.usdz URL)" },
    { "type": "text", "id": "model_poster", "label": "Poster image URL", "info": "Shown until the model loads." },
    { "type": "text", "id": "model_alt", "label": "Model description", "default": "3D model of the [product] hot tub" },
    { "type": "text", "id": "load_label", "label": "Load button", "default": "View in 3D" },
    { "type": "text", "id": "drag_label", "label": "Hint", "default": "Drag to turn it around" },
    { "type": "text", "id": "ar_label", "label": "AR button", "default": "See it in your garden" },
    { "type": "color", "id": "stage_color", "label": "Stage colour", "default": "#fafafa" },
    { "type": "header", "content": "Lite" },
    { "type": "text", "id": "lite_signature", "label": "Headline", "default": "Light work." },
    { "type": "textarea", "id": "lite_lede", "label": "Intro", "default": "Room to stretch out, water at 40°C and nothing to learn. Lift the lid, step in, and let the evening go." },
    { "type": "header", "content": "Lush" },
    { "type": "text", "id": "lush_signature", "label": "Headline", "default": "Turn it down." },
    { "type": "textarea", "id": "lush_lede", "label": "Intro", "default": "Seats that hold you, bubbles with two speeds, and an app that warms it up before you're home. Turn it up for a full massage, or right down and hear the garden again." },
    { "type": "header", "content": "Luxe" },
    { "type": "text", "id": "luxe_signature", "label": "Headline", "default": "Where you want it." },
    { "type": "textarea", "id": "luxe_lede", "label": "Intro", "default": "Hydro-massage jets aimed where you carry the day, bubbles that climb the wall behind you, and a control for each. Pressure exactly where you want it." },
    { "type": "header", "content": "Key facts" },
    { "type": "text", "id": "seats_label", "label": "Seats label", "default": "moulded seats" },
    { "type": "text", "id": "people_label", "label": "People label (Lite, 1-person)", "default": "people, floor free" },
    { "type": "text", "id": "heat_label", "label": "Heat label", "default": "heated, all year round" },
    { "type": "text", "id": "cost_label", "label": "Cost label", "default": "to run, used most days" },
    { "type": "range", "id": "usage_days", "label": "Days used a month (for the cost fact)", "min": 4, "max": 30, "step": 1, "default": 15 },
    { "type": "number", "id": "rate_gbp", "label": "Electricity price, GBP (pence per kWh)", "default": 28 },
    { "type": "number", "id": "rate_eur", "label": "Electricity price, EUR (cents per kWh)", "default": 30 },
    { "type": "number", "id": "rate_usd", "label": "Electricity price, USD (cents per kWh)", "default": 17 },
    { "type": "number", "id": "setup_minutes", "label": "Setup time (minutes)", "info": "Used when the product has no specs.setup_minutes metafield. Set to 0 to hide.", "default": 20 },
    { "type": "text", "id": "setup_label", "label": "Setup label", "default": "to set up, no tools" },
    { "type": "checkbox", "id": "show_notes", "label": "Show test notes", "default": true }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "tier",
          "label": "Show on",
          "options": [
            { "value": "all", "label": "Every tier" },
            { "value": "lite", "label": "Lite" },
            { "value": "lush", "label": "Lush" },
            { "value": "luxe", "label": "Luxe" }
          ],
          "default": "all"
        },
        { "type": "text", "id": "requires", "label": "Only when the product mentions", "info": "Optional. A word from key features or a tag, e.g. VertaAir, WiFi, LED strip." },
        {
          "type": "select",
          "id": "glyph",
          "label": "Icon",
          "options": [
            { "value": "bubbles", "label": "Bubbles" },
            { "value": "seat", "label": "Seat" },
            { "value": "wifi", "label": "WiFi" },
            { "value": "light", "label": "Light" },
            { "value": "jets", "label": "Jets" },
            { "value": "zones", "label": "Two zones" },
            { "value": "floor", "label": "Open floor" },
            { "value": "heat", "label": "Heat" },
            { "value": "filter", "label": "Filter" },
            { "value": "plug", "label": "Plug" },
            { "value": "quiet", "label": "Quiet" }
          ],
          "default": "bubbles"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "What it means for the person in the water." }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
