{{ 'wave-fy27.css' | asset_url | stylesheet_tag }}
{{ 'wave-fy27b.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wave-fy27.js' | asset_url }}" defer></script>
{%- liquid
  comment
    Specs are the product's own key features: each rich-text heading becomes a
    spec name and the paragraph under it becomes the detail. Five are shown
    around the product shot, the rest below it.
  endcomment
  assign html = product.metafields.custom.key_features | metafield_tag
  assign chunks = html | split: '<h6'
  assign img = section.settings.image | default: product.featured_media.preview_image
  assign use_diagram = false
  if section.settings.diagram_match != blank and product.title contains section.settings.diagram_match
    assign use_diagram = true
  endif
-%}
{%- if chunks.size > 1 -%}
<wf-section class="wf{% if section.settings.soft %} wf--soft{% endif %}" id="wf-{{ section.id }}" data-wf-nav="{{ section.settings.nav_label | escape }}">
  <div class="wf__inner">
    <div class="wfb-head">
      <h2 class="wf-h2" data-wf-reveal>{{ section.settings.heading }}</h2>
    </div>

    {%- capture data -%}
      {%- for chunk in chunks offset: 1 -%}
        {%- liquid
          assign title = chunk | split: '>' | slice: 1, 20 | join: '>' | split: '</h6>' | first | strip_html | strip
          assign text = chunk | split: '</h6>' | last | strip_html | strip
          assign probe = title | downcase
          assign icon = 'check'
          if probe contains 'seat'
            assign icon = 'seat'
          elsif probe contains 'bubble' or probe contains 'speed' or probe contains 'vertaair'
            assign icon = 'bubbles'
          elsif probe contains 'jet'
            assign icon = 'jets'
          elsif probe contains 'heat' or probe contains 'season' or probe contains 'frost'
            assign icon = 'heat'
          elsif probe contains 'light'
            assign icon = 'light'
          elsif probe contains 'control' or probe contains 'wifi'
            assign icon = 'wifi'
          elsif probe contains 'construction' or probe contains 'foam' or probe contains 'frame' or probe contains 'insulation' or probe contains 'stitch'
            assign icon = 'foam'
          elsif probe contains 'floor'
            assign icon = 'floor'
          elsif probe contains 'filter' or probe contains 'finish'
            assign icon = 'filter'
          elsif probe contains 'chiller' or probe contains 'depth' or probe contains 'two-in-one'
            assign icon = 'quiet'
          endif
        -%}
        {%- unless title == blank -%}{{ icon }}¦{{ title }}¦{{ text }}§{%- endunless -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- assign entries = data | split: '§' -%}

    <div class="wfb-specs">
      <div class="wfb-specs__col">
        {%- for entry in entries limit: 2 -%}
          {%- render 'wave-fy27b-spec', entry: entry, words: section.settings.words -%}
        {%- endfor -%}
      </div>
      <div class="wfb-specs__media{% if use_diagram %} wfb-specs__media--diagram{% endif %}" data-wf-reveal>
        {%- if use_diagram -%}
          {%- render 'wave-fy27-explode', uid: section.id, label: section.settings.diagram_label -%}
        {%- elsif img != blank -%}
          {{ img | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 480px, 90vw', widths: '500, 800, 1100, 1400', alt: product.title }}
        {%- endif -%}
      </div>
      <div class="wfb-specs__col">
        {%- for entry in entries offset: 2 limit: 2 -%}
          {%- render 'wave-fy27b-spec', entry: entry, words: section.settings.words -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if entries.size > 4 -%}
      <div class="wfb-specs__full">
        {%- for entry in entries offset: 4 -%}
          {%- render 'wave-fy27b-spec', entry: entry, words: section.settings.words -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.link_label != blank and section.settings.link != blank -%}
      <p class="wf-small" style="margin-top:32px;text-align:center"><a class="wf-link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a></p>
    {%- endif -%}
  </div>
</wf-section>
{%- endif -%}

{% schema %}
{
  "name": "FY27-2 specifications",
  "settings": [
    { "type": "paragraph", "content": "Built from the product's Key features metafield: each heading is a spec, each paragraph the detail." },
    { "type": "text", "id": "nav_label", "label": "Tab label", "default": "Specifications" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Specifications" },
    { "type": "text", "id": "diagram_match", "label": "Show the exploded diagram when the title contains", "default": "Garda" },
    { "type": "text", "id": "diagram_label", "label": "Diagram description (for screen readers)", "default": "Exploded view of the spa: lid and cover, eco foam walls with built-in heater, liner with seats, and insulated base" },
    { "type": "image_picker", "id": "image", "label": "Centre image", "info": "Used when the diagram is off. Falls back to the product's featured image." },
    { "type": "range", "id": "words", "label": "Words per spec", "min": 10, "max": 60, "step": 5, "default": 30 },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Full specification" },
    { "type": "checkbox", "id": "soft", "label": "Off-white background", "default": true }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
