{{ 'wave-pdp.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }
</style>
<div class="wpdp section section--padding{% if section.settings.divider %} section--divider{% endif %}">
  <div class="page-width relative grid gap-8 lg:gap-10">
    {%- render 'section-heading', section: section -%}
    {%- liquid
      assign topics = section.settings.topics | split: ','
    -%}
    <ul class="wpdp-grid wpdp-owners" role="list">
      {%- for i in (1..5) -%}
        {%- liquid
          assign key = 'product_image_' | append: i
          assign photo = product.metafields.custom[key].value
        -%}
        {%- if photo != blank -%}
          <li class="wpdp-owners__tile">
            {{- photo | image_url: width: 600 | image_tag: loading: 'lazy', alt: '' -}}
            {%- if section.settings.show_test_notes -%}<span class="wpdp-owners__tag">Placeholder: customer photo</span>{%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if topics.size > 0 -%}
      <div class="wpdp-stack" style="gap:.6rem;">
        <p class="wpdp-label">{{ section.settings.topics_heading }}</p>
        <div class="wpdp-chips">
          {%- for topic in topics -%}<span>{{ topic | strip }}</span>{%- endfor -%}
        </div>
      </div>
    {%- endif -%}
    {%- if section.settings.cta_link != blank -%}
      <a class="link" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}
    {%- if section.settings.show_test_notes -%}
      <p class="wpdp-note">Photos are our own product images standing in for customer photos. Topic chips need connecting to reviews.io filters.</p>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Wave: Owners' gardens",
  "tag": "section",
  "class": "wave-pdp-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Wave owners' gardens"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "title-sm",
          "label": "Small"
        },
        {
          "value": "title-md",
          "label": "Medium"
        },
        {
          "value": "title-lg tracking-heading",
          "label": "Large"
        }
      ],
      "default": "title-md"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "text-left md:items-end md:flex-row",
          "label": "Left"
        },
        {
          "value": "text-center md:items-center",
          "label": "Center"
        }
      ],
      "default": "text-left md:items-end md:flex-row"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "p",
          "label": "Paragraph"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "highlighted_text",
      "label": "Highlighted text",
      "info": "Wrap a word in italics to highlight it",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "full_text",
          "label": "Full text"
        },
        {
          "value": "half_text",
          "label": "Half text"
        },
        {
          "value": "underline",
          "label": "Underline"
        },
        {
          "value": "marker",
          "label": "Marker"
        },
        {
          "value": "stencil",
          "label": "Stencil"
        },
        {
          "value": "scribble",
          "label": "Scribble"
        }
      ],
      "default": "scribble"
    },
    {
      "type": "select",
      "id": "highlighted_scribble",
      "label": "Scribble",
      "options": [
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "basic-underline",
          "label": "Basic underline"
        },
        {
          "value": "sketch-underline",
          "label": "Sketch underline"
        },
        {
          "value": "squiggle-underline",
          "label": "Squiggle underline"
        },
        {
          "value": "squiggle-underline-2",
          "label": "Squiggle underline 2"
        }
      ],
      "default": "basic-underline"
    },
    {
      "type": "text",
      "id": "topics_heading",
      "label": "Topics heading",
      "default": "What owners talk about"
    },
    {
      "type": "text",
      "id": "topics",
      "label": "Review topics (comma separated)",
      "default": "Heating, Setup, Comfort, Running costs, Winter use"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "default": "Share your Wave"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Testing"
    },
    {
      "type": "checkbox",
      "id": "show_test_notes",
      "label": "Show test notes",
      "info": "Amber labels for figures that are still waiting on data. Turn off before launch.",
      "default": true
    },
    {
      "type": "header",
      "content": "Colours & spacing"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "color_highlight",
      "label": "Highlight"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "Show divider",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Wave: Owners' gardens"
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}
