{{ 'wave-fy27.css' | asset_url | stylesheet_tag }}
{{ 'wave-fy27b.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wave-fy27.js' | asset_url }}" defer></script>
<wf-section class="wf{% if section.settings.soft %} wf--soft{% endif %}" id="wf-{{ section.id }}" data-wf-nav="{{ section.settings.nav_label | escape }}">
  <div class="wf__inner">
    <div class="wfb-warranty">
      <h2 class="wf-h2" data-wf-reveal>{{ section.settings.heading }}</h2>
      <p class="wf-lede" data-wf-reveal style="--wf-delay: .08s">{{ section.settings.lede }}</p>

      {%- if section.blocks.size > 0 -%}
        <ul class="wfb-warranty__points" role="list" data-wf-reveal style="--cols: {{ section.blocks.size }};--wf-delay: .16s">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <h3 class="wf-h3">{{ block.settings.title }}</h3>
              <p class="wf-body">{{ block.settings.text }}</p>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.link != blank -%}
        <p class="wfb-warranty__cta" data-wf-reveal>
          <a class="button button--secondary" href="{{ section.settings.link }}"><span class="btn-fill" data-fill></span><span class="btn-text">{{ section.settings.link_label }}</span></a>
        </p>
      {%- endif -%}
    </div>
  </div>
</wf-section>

{% schema %}
{
  "name": "FY27-2 warranty",
  "settings": [
    { "type": "text", "id": "nav_label", "label": "Tab label", "default": "Warranty" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Warranty" },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "Every Wave spa comes with a two-year warranty, backed by our UK team." },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the warranty" },
    { "type": "checkbox", "id": "soft", "label": "Off-white background", "default": true }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Point" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Detail." }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
