<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --color-background: {{ section.settings.color_background.rgb }};
    --color-foreground: {{ section.settings.color_text.rgb }};
    --color-transparent: {{ section.settings.transparent_color_text.rgb }};
    --color-localization: {{ section.settings.color_localization.rgb }};
  }
</style>

{%- liquid
  assign header_layout = section.settings.header_layout
  assign main_menu = section.settings.menu
  assign link_count = main_menu.links.size

  if header_layout == 'center-split'
    assign link_count = link_count | divided_by: 2
  endif

  assign main_menu_class = 'lg:justify-start'
  case header_layout
    when 'center-split'
      assign main_menu_class = 'lg:justify-end'

    when 'center'
      assign main_menu_class = 'lg:justify-center'
  endcase

  assign show_toggle = false
  if header_layout == 'center'
    assign show_toggle = true
  endif

  render 'header-drawer', section: section
-%}

<header data-section-id="{{ section.id }}" class="header header--{{ header_layout }} mobile:header--{{ section.settings.logo_position_mobile }} page-width{% if section.settings.full_width %} page-width--full{% endif %} section{% if section.settings.rounded %} section--rounded{% endif %} section--padding grid items-center z-20 relative w-full"{% if section.settings.sticky_header_type != 'none' %} is="sticky-header" data-sticky-type="{{ section.settings.sticky_header_type }}"{% else %} is="custom-header"{% endif %}>
  {%- liquid
    render 'header-icons', section: section, show_search: true, show_hamburger: true, show_toggle: show_toggle, context: 'start'

    if header_layout != 'center-left' and header_layout != 'center-split'
      render 'header-logo', logo_h1: section.settings.logo_h1
    endif

    if header_layout == 'center'
      render 'header-icons', section: section, show_search: true, show_account: true, show_cart: true, show_hamburger: true, context: 'end'
    endif
  -%}
  
  <div class="header__navigation hidden lg:flex lg:gap-5 {{ main_menu_class }}"{% if header_layout == 'center' %} id="MenuToggle"{% endif %}>
    <nav class="header__menu hidden lg:flex" role="navigation" aria-label="Primary">
      {%- render 'header-nav-desktop', section: section, main_menu: main_menu, limit: link_count, context: 'start' -%}
    </nav>
  </div>

  {%- liquid
    if header_layout == 'center-left' or header_layout == 'center-split'
      render 'header-logo', logo_h1: section.settings.logo_h1
    endif
  -%}
  
  {%- if header_layout == 'center-split' -%}
    <div class="header__navigation header__navigation--split hidden lg:flex lg:gap-5 lg:justify-start">
      <nav class="header__menu hidden lg:flex" role="navigation" aria-label="Secondary">
        {%- render 'header-nav-desktop', section: section, main_menu: main_menu, offset: link_count, context: 'end' -%}
      </nav>
    </div>
  {%- endif -%}

  {%- liquid
    if header_layout != 'center'
      render 'header-icons', section: section, show_search: true, show_account: true, show_cart: true, show_hamburger: true, context: 'end'
    endif
  -%}

  {%- if section.settings.rounded -%}
    {%- render 'corner', dir: 'bottom', border: true, prefix: 'header' -%}
  {%- else -%}
    <span class="header__cutout cutout opacity-0 absolute left-0 top-100 w-full pointer-events-none"></span>
  {%- endif -%}
</header>

{%- if section.settings.hover_menu -%}
  <span class="overlay opacity-0 z-1 fixed left-0 w-full pointer-events-none"></span>
{%- else -%}
  <overlay-element class="overlay opacity-0 z-1 fixed left-0 w-full pointer-events-none"></overlay-element>
{%- endif -%}

{%- if request.design_mode -%}
  <script>
    document.documentElement.style.setProperty('--header-height', document.getElementById('shopify-section-{{ section.id }}').getBoundingClientRect().height.toFixed(1) + 'px');
  </script>
{%- endif -%}

{%- comment -%}
  Second click on an already-open mega menu tab opens its collection.

  TabsElement marks the active tab with `disabled`, and a disabled button
  dispatches no click at all, so there is nothing to listen for. This watches
  for that and swaps it for an .is-tab-active class, leaving the button
  clickable. Opt-in per menu via "Second click opens the collection".

  It lives in the section rather than the mega menu snippet because that
  snippet is delivered by the Section Rendering API and injected as markup —
  a script inside it would never run.
{%- endcomment -%}
<script>
  (function () {
    var RAIL = '.mega-menu__nav--tabs[data-tab-navigate]';

    // Derive the active tab from selected-index, not from `disabled`. Removing
    // `disabled` re-triggers the observer, and inferring from it would then see
    // an enabled button and strip the active class straight back off — which
    // left the open tab dimmed and swallowed the second click.
    function sync(rail) {
      var selected = parseInt(rail.getAttribute('selected-index'), 10) || 0;
      rail.querySelectorAll('button[role="tab"]').forEach(function (button, index) {
        var active = index === selected;
        // `disabled` was the only thing conveying the open tab to assistive
        // tech, so state it properly now that it is removed.
        if (button.disabled) button.disabled = false;
        button.classList.toggle('is-tab-active', active);
        button.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    }

    function bind(rail) {
      if (rail.dataset.navBound) return;
      rail.dataset.navBound = '1';
      sync(rail);
      // TabsElement re-applies `disabled` on every tab change, so keep watching.
      new MutationObserver(function () { sync(rail); }).observe(rail, {
        subtree: true, attributes: true, attributeFilter: ['disabled', 'selected-index']
      });
    }

    function scan(root) {
      if (!root || !root.querySelectorAll) return;
      if (root.matches && root.matches(RAIL)) bind(root);
      root.querySelectorAll(RAIL).forEach(bind);
    }

    // Capture phase, and read selected-index rather than the active class.
    // A microtask checkpoint runs between event listeners, so by the time a
    // bubbling listener sees the tab, TabsElement has already switched the
    // index and the observer has already marked it active — which made the
    // very first click navigate. In capture this runs before either.
    document.addEventListener('click', function (event) {
      if (!event.target.closest) return;
      var button = event.target.closest(RAIL + ' button[role="tab"]');
      if (!button) return;
      var rail = button.closest(RAIL);
      if (!rail) return;

      var buttons = Array.prototype.slice.call(rail.querySelectorAll('button[role="tab"]'));
      var selected = parseInt(rail.getAttribute('selected-index'), 10) || 0;
      // First click on a closed tab: let TabsElement load its products.
      if (buttons.indexOf(button) !== selected) return;

      var href = button.getAttribute('data-href');
      if (!href) return;
      event.preventDefault();
      event.stopPropagation();
      window.location.href = href;
    }, true);

    scan(document);
    // The menu arrives after load, so pick up rails as they are injected.
    new MutationObserver(function (mutations) {
      mutations.forEach(function (mutation) {
        Array.prototype.forEach.call(mutation.addedNodes, function (node) {
          if (node.nodeType === 1) scan(node);
        });
      });
    }).observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>

