{{ 'wave-pdp.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }
</style>
<div class="wpdp section section--padding{% if section.settings.divider %} section--divider{% endif %}">
  <div class="page-width relative grid gap-8 lg:gap-10">
    {%- render 'section-heading', section: section -%}
    {%- liquid
      assign size_option = product.options_by_name['Size']
      assign tbc = '<span class="wpdp-tbc">TBC</span>'
      assign shape = 'Square'
      if product.tags contains 'Round'
        assign shape = 'Round'
      elsif product.tags contains 'Octagonal'
        assign shape = 'Octagonal'
      elsif product.tags contains 'Oval'
        assign shape = 'Oval'
      endif
      assign largest = size_option.values | last
      assign largest_w = 0
      if largest contains '|'
        assign largest_w = largest | split: '|' | last | strip | remove: 'cm' | split: 'x' | first | plus: 0
      endif
      assign height = 0
      if largest contains '|'
        assign height = largest | split: '|' | last | strip | remove: 'cm' | split: 'x' | last | plus: 0
      endif
      assign cable = product.metafields.specs.cable_length_m.value
      assign filled = product.selected_or_first_available_variant.metafields.specs.filled_weight_kg.value
      assign model = product.media | where: 'media_type', 'model' | first
    -%}
    <div class="wpdp-fits">
      <svg class="wpdp-fits__plan" viewBox="0 0 120 120" aria-hidden="true">
        {%- case shape -%}
          {%- when 'Round' -%}<circle class="wpdp-fits__clear" cx="60" cy="60" r="56"/><circle class="wpdp-fits__shape" cx="60" cy="60" r="40"/>
          {%- when 'Octagonal' -%}<circle class="wpdp-fits__clear" cx="60" cy="60" r="56"/><polygon class="wpdp-fits__shape" points="45,20 75,20 100,45 100,75 75,100 45,100 20,75 20,45"/>
          {%- when 'Oval' -%}<ellipse class="wpdp-fits__clear" cx="60" cy="60" rx="58" ry="44"/><ellipse class="wpdp-fits__shape" cx="60" cy="60" rx="44" ry="28"/>
          {%- else -%}<rect class="wpdp-fits__clear" x="4" y="4" width="112" height="112" rx="10"/><rect class="wpdp-fits__shape" x="20" y="20" width="80" height="80" rx="8"/>
        {%- endcase -%}
      </svg>
      <dl class="wpdp-fits__facts">
        <div><dt class="wpdp-label">Footprint</dt><dd class="wpdp-value">{% if largest_w > 0 %}{{ largest_w }}{% if shape == 'Square' %} × {{ largest_w }}{% endif %} cm{% else %}{{ tbc }}{% endif %}</dd></div>
        <div><dt class="wpdp-label">Height</dt><dd class="wpdp-value">{% if height > 0 %}{{ height }} cm{% else %}{{ tbc }}{% endif %}</dd></div>
        <div><dt class="wpdp-label">Weight full</dt><dd class="wpdp-value">{% if filled != blank %}{{ filled | round }} kg{% else %}{{ tbc }}{% endif %}</dd></div>
        <div><dt class="wpdp-label">Power</dt><dd class="wpdp-value">{% if cable != blank %}{{ cable }} m cable{% else %}{{ tbc }}{% endif %}</dd></div>
      </dl>
      <div class="wpdp-fits__cta">
        <p class="wpdp-muted">{{ section.settings.note }}</p>
        {%- if model != blank -%}
          <button type="button" class="button button--secondary" data-shopify-xr data-shopify-model3d-id="{{ model.id }}" data-shopify-title="{{ product.title | escape }}" data-shopify-xr-hidden>
            <span class="btn-fill" data-fill></span><span class="btn-text">{{ section.settings.ar_button }}</span>
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Wave V2: Will it fit",
  "tag": "section",
  "class": "wave-pdp-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Will it <em>fit</em>?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Wave"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "title-sm",
          "label": "Small"
        },
        {
          "value": "title-md",
          "label": "Medium"
        },
        {
          "value": "title-lg tracking-heading",
          "label": "Large"
        }
      ],
      "default": "title-lg tracking-heading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "text-left md:items-end md:flex-row",
          "label": "Left"
        },
        {
          "value": "text-center md:items-center",
          "label": "Center"
        }
      ],
      "default": "text-left md:items-end md:flex-row"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "highlighted_text",
      "label": "Highlighted text",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "underline",
          "label": "Underline"
        },
        {
          "value": "marker",
          "label": "Marker"
        },
        {
          "value": "scribble",
          "label": "Scribble"
        }
      ],
      "default": "scribble"
    },
    {
      "type": "select",
      "id": "highlighted_scribble",
      "label": "Scribble",
      "options": [
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "basic-underline",
          "label": "Basic underline"
        },
        {
          "value": "sketch-underline",
          "label": "Sketch underline"
        },
        {
          "value": "squiggle-underline",
          "label": "Squiggle underline"
        }
      ],
      "default": "basic-underline"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "Set it on a flat, solid surface: patio slabs, concrete or decking rated for the weight. A weatherproof 13 A socket with RCD protection, and no extension leads."
    },
    {
      "type": "text",
      "id": "ar_button",
      "label": "AR button",
      "default": "View in your space"
    },
    {
      "type": "header",
      "content": "Testing"
    },
    {
      "type": "checkbox",
      "id": "show_test_notes",
      "label": "Show test notes",
      "default": true
    },
    {
      "type": "header",
      "content": "Colours & spacing"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "color_highlight",
      "label": "Highlight"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "Show divider",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Wave V2: Will it fit"
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}
