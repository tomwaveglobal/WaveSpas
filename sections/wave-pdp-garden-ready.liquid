{{ 'wave-pdp.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }
</style>
<div class="wpdp section section--padding{% if section.settings.divider %} section--divider{% endif %}">
  <div class="page-width relative grid gap-8 lg:gap-10">
    {%- render 'section-heading', section: section -%}
{%- liquid
  assign size_option = product.options_by_name['Size']
  assign size_labels = ''
  assign size_widths = ''
  assign size_variant_ids = ''
  assign seen_sizes = '~'
  if size_option
    assign size_index = size_option.position | minus: 1
    for variant in product.variants
      assign size_value = variant.options[size_index]
      assign size_key = '~' | append: size_value | append: '~'
      if seen_sizes contains size_key
        continue
      endif
      assign seen_sizes = seen_sizes | append: size_value | append: '~'
      assign size_label = size_value | split: '|' | first | strip
      assign size_labels = size_labels | append: size_label | append: '^'
      assign size_variant_ids = size_variant_ids | append: forloop.index0 | append: '^'
      if size_value contains '|'
        assign size_dims = size_value | split: '|' | last | strip | remove: 'cm'
        assign size_w = size_dims | split: 'x' | first | strip
        assign size_widths = size_widths | append: size_w | append: '^'
      else
        assign size_widths = size_widths | append: '' | append: '^'
      endif
    endfor
  endif
  assign size_label_list = size_labels | split: '^'
  assign size_width_list = size_widths | split: '^'
  assign size_id_list = size_variant_ids | split: '^'
  assign shape = 'Square'
  if product.tags contains 'Round'
    assign shape = 'Round'
  elsif product.tags contains 'Octagonal'
    assign shape = 'Octagonal'
  elsif product.tags contains 'Oval'
    assign shape = 'Oval'
  endif
-%}
    {%- liquid
      assign tbc = '<span class="wpdp-tbc">TBC</span>'
      assign any_tbc = false
      assign largest_w = size_width_list | last
      assign power = product.metafields.specs.power_supply.value
      assign cable = product.metafields.specs.cable_length_m.value
    -%}
    <div class="wpdp-garden">
      <figure class="wpdp-footprint">
        <svg viewBox="0 0 320 340" role="img" aria-label="Top-down footprint of the {{ product.title | escape }}, {{ largest_w }} cm">
          {%- case shape -%}
            {%- when 'Round' -%}
              <circle class="wpdp-svg-clear" cx="160" cy="160" r="140"/>
              <circle class="wpdp-svg-shape" cx="160" cy="160" r="100"/>
            {%- when 'Octagonal' -%}
              <circle class="wpdp-svg-clear" cx="160" cy="160" r="145"/>
              <polygon class="wpdp-svg-shape" points="118.6,60 201.4,60 260,118.6 260,201.4 201.4,260 118.6,260 60,201.4 60,118.6"/>
            {%- when 'Oval' -%}
              <ellipse class="wpdp-svg-clear" cx="160" cy="160" rx="150" ry="110"/>
              <ellipse class="wpdp-svg-shape" cx="160" cy="160" rx="110" ry="70"/>
            {%- else -%}
              <rect class="wpdp-svg-clear" x="20" y="20" width="280" height="280" rx="16"/>
              <rect class="wpdp-svg-shape" x="60" y="60" width="200" height="200" rx="10"/>
          {%- endcase -%}
          <path class="wpdp-svg-dim" d="M60 318 H260 M60 312 V324 M260 312 V324"/>
          <text class="wpdp-svg-text" x="160" y="312" text-anchor="middle">{% if largest_w != blank %}{{ largest_w }} cm{% else %}TBC{% endif %}</text>
          <text class="wpdp-svg-text" x="160" y="165" text-anchor="middle" style="font-size:12px;opacity:.7">{{ size_label_list | last }}</text>
        </svg>
        <figcaption class="wpdp-muted text-sm">Largest size shown. Dashed line: space to walk around and reach the controls.</figcaption>
      </figure>

      <ul class="wpdp-grid wpdp-garden__checks" role="list">
        <li class="wpdp-card">
          <span class="wpdp-label">1 · Space</span>
          <h3>Room to walk round it</h3>
          {%- for label in size_label_list -%}
            {%- assign w = size_width_list[forloop.index0] -%}
            <p><strong>{{ label }}:</strong> {% if w != blank %}{{ w }} cm {% case shape %}{% when 'Round' %}across{% when 'Octagonal' %}across{% when 'Oval' %}long{% else %}× {{ w }} cm{% endcase %}{% else %}{{ tbc }}{% endif %}</p>
          {%- endfor -%}
          <p class="wpdp-muted">{{ section.settings.space_text }}</p>
        </li>
        <li class="wpdp-card">
          <span class="wpdp-label">2 · Surface</span>
          <h3>Flat, level and strong enough</h3>
          {%- for vid in size_id_list -%}
            {%- liquid
              assign vid_i = vid | plus: 0
              assign v = product.variants[vid_i]
              assign filled = v.metafields.specs.filled_weight_kg.value
              assign w = size_width_list[forloop.index0] | times: 1.0
              assign w_m = w | divided_by: 100.0
              case shape
                when 'Round'
                  assign radius = w_m | divided_by: 2.0
                  assign area = radius | times: radius | times: 3.14159
                when 'Octagonal'
                  assign area = w_m | times: w_m | times: 0.8284
                when 'Oval'
                  assign area = 0
                else
                  assign area = w_m | times: w_m
              endcase
            -%}
            <p><strong>{{ size_label_list[forloop.index0] }}:</strong>
              {% if filled != blank %}{{ filled | round }} kg full{% if area > 0 %} · about {{ filled | divided_by: area | round }} kg per m²{% endif %}{% else %}{{ tbc }} kg full{% assign any_tbc = true %}{% endif %}
            </p>
          {%- endfor -%}
          <p class="wpdp-muted">{{ section.settings.surface_text }}</p>
        </li>
        <li class="wpdp-card">
          <span class="wpdp-label">3 · Power</span>
          <h3>A safe outdoor socket</h3>
          <p><strong>Supply:</strong> {% if power != blank %}{{ power }}{% else %}{{ tbc }}{% assign any_tbc = true %}{% endif %}</p>
          <p><strong>Cable:</strong> {% if cable != blank %}{{ cable }} m{% else %}{{ tbc }}{% assign any_tbc = true %}{% endif %}</p>
          <p class="wpdp-muted">{{ section.settings.power_text }}</p>
        </li>
        <li class="wpdp-card">
          <span class="wpdp-label">4 · Access</span>
          <h3>Getting the box in</h3>
          {%- for vid in size_id_list -%}
            {%- liquid
              assign vid_i = vid | plus: 0
              assign v = product.variants[vid_i]
              assign box_dims = v.metafields.specs.carton_dimensions.value
              assign box_kg = v.metafields.specs.carton_weight_kg.value
            -%}
            <p><strong>{{ size_label_list[forloop.index0] }}:</strong>
              {% if box_dims != blank %}{{ box_dims }}{% else %}{{ tbc }}{% assign any_tbc = true %}{% endif %} ·
              {% if box_kg != blank %}{{ box_kg }} kg{% else %}{{ tbc }} kg{% endif %}
            </p>
          {%- endfor -%}
          <p class="wpdp-muted">{{ section.settings.access_text }}</p>
        </li>
      </ul>
    </div>
    {%- if section.settings.planning_text != blank -%}
      <div class="wpdp-card"><span class="wpdp-label">Planning permission</span><div class="rte">{{ section.settings.planning_text }}</div></div>
    {%- endif -%}
    {%- if section.settings.show_test_notes and any_tbc -%}
      <p class="wpdp-note">TBC figures come from variant metafields (Filled weight, Box dimensions, Box weight) and product metafields (Power supply, Cable length).</p>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Wave: Garden ready",
  "tag": "section",
  "class": "wave-pdp-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Is your garden ready?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "title-sm",
          "label": "Small"
        },
        {
          "value": "title-md",
          "label": "Medium"
        },
        {
          "value": "title-lg tracking-heading",
          "label": "Large"
        }
      ],
      "default": "title-md"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "text-left md:items-end md:flex-row",
          "label": "Left"
        },
        {
          "value": "text-center md:items-center",
          "label": "Center"
        }
      ],
      "default": "text-left md:items-end md:flex-row"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "p",
          "label": "Paragraph"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "highlighted_text",
      "label": "Highlighted text",
      "info": "Wrap a word in italics to highlight it",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "full_text",
          "label": "Full text"
        },
        {
          "value": "half_text",
          "label": "Half text"
        },
        {
          "value": "underline",
          "label": "Underline"
        },
        {
          "value": "marker",
          "label": "Marker"
        },
        {
          "value": "stencil",
          "label": "Stencil"
        },
        {
          "value": "scribble",
          "label": "Scribble"
        }
      ],
      "default": "scribble"
    },
    {
      "type": "select",
      "id": "highlighted_scribble",
      "label": "Scribble",
      "options": [
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "basic-underline",
          "label": "Basic underline"
        },
        {
          "value": "sketch-underline",
          "label": "Sketch underline"
        },
        {
          "value": "squiggle-underline",
          "label": "Squiggle underline"
        },
        {
          "value": "squiggle-underline-2",
          "label": "Squiggle underline 2"
        }
      ],
      "default": "basic-underline"
    },
    {
      "type": "text",
      "id": "space_text",
      "label": "Space text",
      "default": "Leave enough room to walk around the spa and reach the controls and cover."
    },
    {
      "type": "text",
      "id": "surface_text",
      "label": "Surface text",
      "default": "Patio slabs, concrete or decking rated for the weight. Avoid soft lawn."
    },
    {
      "type": "text",
      "id": "power_text",
      "label": "Power text",
      "default": "Use a weatherproof outdoor socket with RCD protection. Never use an extension lead."
    },
    {
      "type": "text",
      "id": "access_text",
      "label": "Access text",
      "default": "Check your side gate or doorway before delivery day."
    },
    {
      "type": "richtext",
      "id": "planning_text",
      "label": "Planning text",
      "default": "<p>A portable hot tub on a patio or lawn doesn't usually need planning permission. Raised decking over 30 cm, a listed building or a conservation area can change that, so check with your local council if any apply.</p>"
    },
    {
      "type": "header",
      "content": "Testing"
    },
    {
      "type": "checkbox",
      "id": "show_test_notes",
      "label": "Show test notes",
      "info": "Amber labels for figures that are still waiting on data. Turn off before launch.",
      "default": true
    },
    {
      "type": "header",
      "content": "Colours & spacing"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "color_highlight",
      "label": "Highlight"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "Show divider",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Wave: Garden ready"
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}
