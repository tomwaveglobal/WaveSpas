{{ 'wave-pdp.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }
</style>
<div class="wpdp section section--padding{% if section.settings.divider %} section--divider{% endif %}">
  <div class="page-width relative grid gap-8 lg:gap-10">
    {%- render 'section-heading', section: section -%}
    {%- liquid
      assign size_option = product.options_by_name['Size']
      assign tbc = '<span class="wpdp-tbc">TBC</span>'
      assign kwh_day = product.metafields.specs.kwh_per_day.value
      assign cable = product.metafields.specs.cable_length_m.value
      assign kf = product.metafields.custom.key_features | metafield_text
      assign ts = product.metafields.custom.tech_specs | metafield_text
      assign unit_label = 'p'
      if cart.currency.iso_code != 'GBP'
        assign unit_label = 'c'
      endif
      assign shape = 'Square'
      if product.tags contains 'Round'
        assign shape = 'Round'
      elsif product.tags contains 'Octagonal'
        assign shape = 'Octagonal'
      elsif product.tags contains 'Oval'
        assign shape = 'Oval'
      endif
      assign setup_minutes = product.metafields.specs.setup_minutes.value
      if setup_minutes == blank
        assign collage_title = product.metafields.custom.product_collage_image_2_title.value
        if collage_title contains 'Minute'
          assign setup_minutes = collage_title | split: ' ' | first
        endif
      endif

      assign control = 'Wired controller'
      if kf contains 'WiFi'
        assign control = 'WiFi app control'
      endif
      assign massage = 'AquaBubble™ bubbles'
      if kf contains 'VertaAir'
        assign massage = 'Wave VertaAir™'
      endif
      if product.tags contains 'hydro-jets'
        assign massage = 'VertaJet™ + VertaAir™'
      endif
      assign seating = 'Air Foam seats'
      if product.tags contains 'Lite'
        assign seating = 'Open floor'
      endif
      assign heating = 'Integrated heater'
      if product.tags contains 'external heater'
        assign heating = 'External heater'
      endif
      assign lighting = 'Spa light ready'
      if kf contains 'LED strip'
        assign lighting = 'LED strip compatible'
      endif
      assign wall = ''
      if ts contains '15cm' or kf contains '15cm'
        assign wall = '15 cm foam wall'
      elsif ts contains '8cm' or kf contains '8cm'
        assign wall = '8 cm foam wall'
      elsif ts contains '20cm' or kf contains '20cm'
        assign wall = '20 cm I-beam wall'
      elsif ts contains '6cm' or kf contains '6cm'
        assign wall = '6 cm insulated wall'
      endif

    -%}
    <wave-size-costs class="wpdp-cs" data-currency="{{ cart.currency.iso_code }}" data-saving="{{ section.settings.energysave_saving }}">
      <script type="application/json" data-sizes>
        [
          {%- for value in size_option.values -%}
            {%- liquid
              assign size_index = size_option.position | minus: 1
              assign label = value | split: '|' | first | strip
              assign std_price = 0
              assign es_price = 0
              assign std_img = blank
              assign es_img = blank
              for variant in product.variants
                if variant.options[size_index] == value
                  assign edition = variant.options | last
                  assign gang = variant.metafields.theme.gang_media.value
                  if edition contains 'EnergySave'
                    if es_price == 0 or variant.price < es_price
                      assign es_price = variant.price
                    endif
                    if es_img == blank and gang != blank
                      assign es_img = gang.first
                    endif
                  else
                    if std_price == 0 or variant.price < std_price
                      assign std_price = variant.price
                    endif
                    if std_img == blank and gang != blank
                      assign std_img = gang.first
                    endif
                  endif
                endif
              endfor
              if std_img == blank
                assign std_img = product.featured_image
              endif
              assign std_src = std_img | image_url: width: 900
              assign es_src = ''
              if es_img != blank
                assign es_src = es_img | image_url: width: 900
              endif
            -%}
            {"label": {{ label | json }}, "price": {{ std_price | json }}, "es": {{ es_price | json }}, "img": {{ std_src | json }}, "esImg": {{ es_src | json }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>

      <div class="wpdp-cs__bar">
        {%- if size_option.values.size > 1 -%}
          <div class="wpdp-seg wpdp-cs__sizes" role="group" aria-label="{{ section.settings.size_label | escape }}">
            {%- for value in size_option.values -%}
              <button type="button" data-size="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ value | split: '|' | first | strip }}</button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <p class="wpdp-cs__from"><span class="wpdp-label">From</span> <span class="wpdp-value" data-out="price">{{ product.price | money }}</span></p>
      </div>

      <div class="wpdp-cs__grid">
        <div class="wpdp-cs__size">
          {%- liquid
            assign first_size = size_option.values | first
            assign size_index = size_option.position | minus: 1
            assign opening_img = blank
            for variant in product.variants
              if variant.options[size_index] == first_size and opening_img == blank
                assign gang = variant.metafields.theme.gang_media.value
                if gang != blank
                  assign opening_img = gang.first
                endif
              endif
            endfor
            if opening_img == blank
              assign opening_img = product.featured_image
            endif
          -%}
          {%- if opening_img != blank -%}
            <div class="wpdp-cs__shot{% if section.settings.hide_badge %} wpdp-cs__shot--clip{% endif %}">
              <img src="{{ opening_img | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" height="900" loading="lazy" data-hero>
            </div>
          {%- endif -%}
          {%- for value in size_option.values -%}
            {%- liquid
              assign size_index = size_option.position | minus: 1
              assign label = value | split: '|' | first | strip
              assign seats = label | split: ' ' | first | plus: 0
              assign w = 0
              assign h = 0
              if value contains '|'
                assign dims = value | split: '|' | last | strip | remove: 'cm'
                assign w = dims | split: 'x' | first | plus: 0
                assign h = dims | split: 'x' | last | plus: 0
              endif
              assign first_variant = nil
              for variant in product.variants
                if variant.options[size_index] == value and first_variant == nil
                  assign first_variant = variant
                endif
              endfor
              assign litres = first_variant.metafields.specs.water_litres.value
              assign filled = first_variant.metafields.specs.filled_weight_kg.value
              case seats
                when 2
                  assign best_for = section.settings.best_for_2
                when 4
                  assign best_for = section.settings.best_for_4
                when 6
                  assign best_for = section.settings.best_for_6
                else
                  assign best_for = ''
              endcase
            -%}
            <div class="wpdp-cs__panel" data-size-panel="{{ forloop.index0 }}"{% unless forloop.first %} hidden{% endunless %}>
              <p class="wpdp-cs__title">{{ label }}</p>
              {%- if best_for != blank -%}<p class="wpdp-cs__bestfor">{{ best_for }}</p>{%- endif -%}
              <dl class="wpdp-cs__facts">
                <div><dt class="wpdp-label">Seats</dt><dd class="wpdp-value">{{ seats }}</dd></div>
                <div><dt class="wpdp-label">Footprint</dt><dd class="wpdp-value">{% if w > 0 %}{{ w }}{% if shape == 'Square' %} × {{ w }}{% endif %} cm{% else %}{{ tbc }}{% endif %}</dd></div>
                <div><dt class="wpdp-label">Height</dt><dd class="wpdp-value">{% if h > 0 %}{{ h }} cm{% else %}{{ tbc }}{% endif %}</dd></div>
                <div><dt class="wpdp-label">Water</dt><dd class="wpdp-value">{% if litres != blank %}{{ litres }} L{% else %}{{ tbc }}{% endif %}</dd></div>
                <div><dt class="wpdp-label">Weight full</dt><dd class="wpdp-value">{% if filled != blank %}{{ filled | round }} kg{% else %}{{ tbc }}{% endif %}</dd></div>
              </dl>
            </div>
          {%- endfor -%}

          <ul class="wpdp-cs__glance" role="list">
            <li><span class="wpdp-label">Massage</span><span>{{ massage }}</span></li>
            <li><span class="wpdp-label">Seating</span><span>{{ seating }}</span></li>
            <li><span class="wpdp-label">Heating</span><span>{{ heating }} · up to 40 °C</span></li>
            <li><span class="wpdp-label">Controls</span><span>{{ control }}</span></li>
            <li><span class="wpdp-label">Lighting</span><span>{{ lighting }}</span></li>
            <li><span class="wpdp-label">Filtration</span><span>WaveFlow™ dual filtration</span></li>
            {%- if wall != blank -%}<li><span class="wpdp-label">Construction</span><span>{{ wall }}</span></li>{%- endif -%}
            <li><span class="wpdp-label">Setup</span><span>{% if setup_minutes != blank %}{{ setup_minutes }} minutes, no tools{% else %}{{ tbc }}{% endif %}</span></li>
            <li><span class="wpdp-label">Power</span><span>{% if cable != blank %}{{ cable }} m cable{% else %}{{ tbc }}{% endif %}</span></li>
          </ul>
        </div>

        <div class="wpdp-cs__cost"{% if kwh_day == blank %} hidden{% endif %} data-kwh="{{ kwh_day }}">
          <div class="wpdp-cs__glow" aria-hidden="true"></div>
          <div class="wpdp-cs__cost-inner">
            <p class="wpdp-label">{{ section.settings.cost_label }}</p>
            <p class="wpdp-cs__big"><span data-out="month">—</span></p>
            <p class="wpdp-cs__big-sub">a month to run</p>
            <div class="wpdp-seg wpdp-seg--dark wpdp-cs__usage" role="group" aria-label="How often you use it">
              <button type="button" data-days="6" aria-pressed="false">Occasional</button>
              <button type="button" data-days="15" aria-pressed="true">Often</button>
              <button type="button" data-days="30" aria-pressed="false">Every day</button>
            </div>
            <div class="wpdp-cs__edition" data-edition-wrap hidden>
              <div class="wpdp-seg wpdp-seg--dark" role="group" aria-label="Edition">
                <button type="button" data-edition="standard" aria-pressed="true">Standard</button>
                <button type="button" data-edition="es" aria-pressed="false">{{ section.settings.energysave_label }}</button>
              </div>
              <p class="wpdp-cs__saving" data-saving-note hidden>{{ section.settings.energysave_note }}</p>
            </div>
            <div class="wpdp-cs__split">
              <div><span class="wpdp-label">Each soak</span><span class="wpdp-value" data-out="day">—</span></div>
              <div><span class="wpdp-label">A year</span><span class="wpdp-value" data-out="year">—</span></div>
            </div>
            <div class="wpdp-cs__price-input">
              <label class="wpdp-label" for="WaveUnit-{{ section.id }}">Your electricity price</label>
              <div><input id="WaveUnit-{{ section.id }}" type="number" inputmode="decimal" min="1" max="200" step="0.01" value="{{ section.settings.unit_price }}"><span class="wpdp-muted">{{ unit_label }} per kWh</span></div>
            </div>
            <p class="wpdp-muted wpdp-cs__basis" data-basis></p>
            {%- if section.settings.calculator_link != blank -%}
              <a class="wpdp-cs__calc-link" href="{{ section.settings.calculator_link }}">{{ section.settings.calculator_label }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- if section.settings.footnote != blank -%}<div class="rte wpdp-muted text-sm">{{ section.settings.footnote }}</div>{%- endif -%}
      {%- if kwh_day == blank and section.settings.show_test_notes -%}
        <p class="wpdp-note">No kWh a day set for this spa, so the running cost panel is hidden.</p>
      {%- endif -%}
    </wave-size-costs>
    <script>
      if (!customElements.get('wave-size-costs')) {
        customElements.define('wave-size-costs', class extends HTMLElement {
          connectedCallback() {
            this.sizes = JSON.parse(this.querySelector('[data-sizes]').textContent);
            this.money = new Intl.NumberFormat(undefined, { style: 'currency', currency: this.dataset.currency || 'GBP' });
            this.saving = Number(this.dataset.saving || 30) / 100;
            this.cost = this.querySelector('.wpdp-cs__cost');
            this.kwh = this.cost ? parseFloat(this.cost.dataset.kwh) : NaN;
            this.price = this.querySelector('input[type="number"]');
            this.state = { size: 0, days: 15, edition: 'standard' };
            this.querySelectorAll('[data-size]').forEach((b) => b.addEventListener('click', () => { this.state.size = Number(b.dataset.size); this.render(); }));
            this.querySelectorAll('[data-days]').forEach((b) => b.addEventListener('click', () => { this.state.days = Number(b.dataset.days); this.render(true); }));
            this.querySelectorAll('[data-edition]').forEach((b) => b.addEventListener('click', () => { this.state.edition = b.dataset.edition; this.render(true); }));
            if (this.price) this.price.addEventListener('input', () => this.render());
            this.render();
            if (this.cost && 'IntersectionObserver' in window) {
              const io = new IntersectionObserver((entries) => { entries.forEach((e) => { if (e.isIntersecting) { this.countUp(); io.disconnect(); } }); }, { threshold: 0.35 });
              io.observe(this.cost);
            }
          }
          monthly() {
            const rate = parseFloat(this.price && this.price.value) / 100;
            const base = this.kwh * this.state.days * rate;
            return this.state.edition === 'es' ? base * (1 - this.saving) : base;
          }
          set(key, value) {
            const el = this.querySelector(`[data-out="${key}"]`);
            if (el) el.textContent = Number.isFinite(value) ? this.money.format(value) : '—';
          }
          render(animate) {
            const size = this.sizes[this.state.size] || {};
            this.querySelectorAll('[data-size-panel]').forEach((panel) => { panel.hidden = Number(panel.dataset.sizePanel) !== this.state.size; });
            this.querySelectorAll('[data-size]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.size) === this.state.size)));
            this.querySelectorAll('[data-days]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.days) === this.state.days)));
            this.querySelectorAll('[data-edition]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.edition === this.state.edition)));
            const hasEs = Number(size.es) > 0;
            const wrap = this.querySelector('[data-edition-wrap]');
            if (wrap) wrap.hidden = !hasEs;
            if (!hasEs && this.state.edition === 'es') this.state.edition = 'standard';
            const note = this.querySelector('[data-saving-note]');
            if (note) note.hidden = this.state.edition !== 'es';
            const price = this.state.edition === 'es' && hasEs ? size.es : size.price;
            this.set('price', Number(price) / 100);
            const hero = this.querySelector('[data-hero]');
            if (hero) {
              const next = this.state.edition === 'es' && size.esImg ? size.esImg : size.img;
              if (next && hero.getAttribute('src') !== next) {
                hero.classList.add('is-swapping');
                const swap = () => { hero.src = next; hero.classList.remove('is-swapping'); };
                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { swap(); } else { setTimeout(swap, 140); }
              }
            }
            if (!this.cost || !Number.isFinite(this.kwh)) return;
            const month = this.monthly();
            if (animate) { this.countUp(); } else { this.set('month', month); }
            const rate = parseFloat(this.price.value) / 100;
            const perDay = this.state.edition === 'es' ? this.kwh * rate * (1 - this.saving) : this.kwh * rate;
            this.set('day', perDay);
            this.set('year', month * 12);
            const basis = this.querySelector('[data-basis]');
            if (basis) {
              const kwhShown = this.state.edition === 'es' ? (this.kwh * (1 - this.saving)).toFixed(1) : this.kwh;
              basis.textContent = `${kwhShown} kWh a day, used ${this.state.days} days a month, at ${this.price.value}p per kWh.`;
            }
          }
          countUp() {
            const target = this.monthly();
            const out = this.querySelector('[data-out="month"]');
            if (!out || !Number.isFinite(target)) return;
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { this.set('month', target); return; }
            const start = performance.now();
            const step = (now) => {
              const progress = Math.min((now - start) / 900, 1);
              out.textContent = this.money.format(target * (1 - Math.pow(1 - progress, 3)));
              if (progress < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }
        });
      }
    </script>
  </div>
</div>
{% schema %}
{
  "name": "Wave V2: Size & costs",
  "tag": "section",
  "class": "wave-pdp-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Pick your size, see what it <em>costs</em>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Wave"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "title-sm",
          "label": "Small"
        },
        {
          "value": "title-md",
          "label": "Medium"
        },
        {
          "value": "title-lg tracking-heading",
          "label": "Large"
        }
      ],
      "default": "title-md"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "text-left md:items-end md:flex-row",
          "label": "Left"
        },
        {
          "value": "text-center md:items-center",
          "label": "Center"
        }
      ],
      "default": "text-left md:items-end md:flex-row"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "p",
          "label": "Paragraph"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "highlighted_text",
      "label": "Highlighted text",
      "info": "Wrap a word in italics to highlight it",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "underline",
          "label": "Underline"
        },
        {
          "value": "marker",
          "label": "Marker"
        },
        {
          "value": "scribble",
          "label": "Scribble"
        }
      ],
      "default": "scribble"
    },
    {
      "type": "select",
      "id": "highlighted_scribble",
      "label": "Scribble",
      "options": [
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "basic-underline",
          "label": "Basic underline"
        },
        {
          "value": "sketch-underline",
          "label": "Sketch underline"
        },
        {
          "value": "squiggle-underline",
          "label": "Squiggle underline"
        },
        {
          "value": "squiggle-underline-2",
          "label": "Squiggle underline 2"
        }
      ],
      "default": "basic-underline"
    },
    {
      "type": "text",
      "id": "size_label",
      "label": "Size label",
      "default": "Choose your size"
    },
    {
      "type": "text",
      "id": "best_for_2",
      "label": "2 person: best for",
      "default": "Couples and smaller gardens"
    },
    {
      "type": "text",
      "id": "best_for_4",
      "label": "4 person: best for",
      "default": "Couples and small families"
    },
    {
      "type": "text",
      "id": "best_for_6",
      "label": "6 person: best for",
      "default": "Families and entertaining friends"
    },
    {
      "type": "text",
      "id": "cost_label",
      "label": "Cost label",
      "default": "Running cost"
    },
    {
      "type": "text",
      "id": "unit_price",
      "label": "Electricity price (pence per kWh)",
      "default": "28",
      "info": "Matches the Wave running cost calculator"
    },
    {
      "type": "text",
      "id": "calculator_label",
      "label": "Calculator link label",
      "default": "Full running cost calculator"
    },
    {
      "type": "url",
      "id": "calculator_link",
      "label": "Calculator link"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote",
      "default": "<p>Estimated with the same figures as our running cost calculator. Your cost depends on your tariff, the weather, and keeping the lid on between soaks.</p>"
    },
    {
      "type": "text",
      "id": "energysave_label",
      "label": "EnergySave label",
      "default": "EnergySave Bundle"
    },
    {
      "type": "text",
      "id": "energysave_note",
      "label": "EnergySave note",
      "default": "Thermal cover and foam mat included — cuts running costs by about 30%."
    },
    {
      "type": "range",
      "id": "energysave_saving",
      "label": "EnergySave saving",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "hide_badge",
      "label": "Hide award badge corner",
      "info": "Crops the bottom-left corner of the product shot",
      "default": true
    },
    {
      "type": "header",
      "content": "Testing"
    },
    {
      "type": "checkbox",
      "id": "show_test_notes",
      "label": "Show test notes",
      "default": true
    },
    {
      "type": "header",
      "content": "Colours & spacing"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "color_highlight",
      "label": "Highlight"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "Show divider",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Wave V2: Size & costs"
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}
