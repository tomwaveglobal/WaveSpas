{{ 'wave-fy27.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wave-fy27.js' | asset_url }}" defer></script>
{%- liquid
  assign name = product.title | split: '|' | first | strip
  assign variant = product.selected_or_first_available_variant
-%}
<style>
  #shopify-section-{{ section.id }} {
    position: sticky;
    top: 0;
    z-index: 20;
  }
</style>
<div class="wf-nav">
  <wf-localnav class="wf-nav__inner" data-currency="{{ cart.currency.iso_code }}">
    <p class="wf-nav__title">{{ name }}</p>
    <ul class="wf-nav__links" data-links role="list"></ul>
    <div class="wf-nav__buy">
      <span class="wf-nav__price" data-price>{{ variant.price | money }}</span>
      <button type="button" class="wf-btn" data-buy>{{ section.settings.buy_label }}</button>
    </div>
  </wf-localnav>
</div>

{% schema %}
{
  "name": "FY27 local nav",
  "class": "wf-nav-wrap",
  "settings": [
    {
      "type": "paragraph",
      "content": "Sticky bar under the buy box. Its links build themselves from every FY27 section on the page that has a nav label."
    },
    {
      "type": "text",
      "id": "buy_label",
      "label": "Button label",
      "default": "Buy"
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
