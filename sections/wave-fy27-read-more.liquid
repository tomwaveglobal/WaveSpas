{%- comment -%}
  FY27 "Quiet read more": a single centred column on a soft grey band, cut off with a fade and a
  Read more / Read less button. The whole text is always in the page source, so search engines read
  all of it; without JavaScript it simply shows in full.

  Copy comes from the collection (custom.uk_seo_description, or custom.us_seo_description in the US
  market, falling back to UK) or from the section's own text. [collection] in the heading is replaced
  with the collection title.
{%- endcomment -%}
{%- liquid
  assign body = blank
  if section.settings.source == 'collection' and collection != blank
    assign about = collection.metafields.custom.uk_seo_description
    if localization.market.handle == section.settings.us_market_handle and collection.metafields.custom.us_seo_description != blank
      assign about = collection.metafields.custom.us_seo_description
    endif
    if about != blank
      assign body = about | metafield_tag
    endif
  else
    assign body = section.settings.text
  endif

  assign heading = section.settings.heading
  if collection != blank
    assign heading = heading | replace: '[collection]', collection.title
  endif
  assign uid = 'WfReadMore-' | append: section.id
-%}
{%- if body != blank -%}
  <style>
    #shopify-section-{{ section.id }} {
      --wfrm-bg: {{ section.settings.color_background }};
      --wfrm-collapsed: {{ section.settings.collapsed_height }}px;
      --section-padding-top: {{ section.settings.padding_top }}px;
      --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  </style>

  <div class="section section--padding">
    <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
      <div class="wfrm{% if section.settings.full_width %} wfrm--full{% endif %}">
        <div class="wfrm__col">
          {%- if heading != blank -%}
            <h2 class="wfrm__heading">{{ heading }}</h2>
          {%- endif -%}

          <wf-read-more class="wfrm__wrap">
            <div class="wfrm__body" id="{{ uid }}">{{ body }}</div>
            <button type="button" class="wfrm__toggle button button--secondary" aria-expanded="false" aria-controls="{{ uid }}" hidden>
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">
                <span data-more>{{ section.settings.more_label }}</span>
                <span data-less hidden>{{ section.settings.less_label }}</span>
                <svg class="wfrm__chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
              </span>
            </button>
          </wf-read-more>
        </div>
      </div>
    </div>
  </div>

  <style>
    #shopify-section-{{ section.id }} .wfrm {
      /* Positioned so it sits above the theme's .section::before background layer */
      position: relative;
      border-radius: clamp(16px, 1.6vw, 24px);
      background: var(--wfrm-bg);
      padding: clamp(48px, 7vw, 120px) clamp(20px, 5vw, 64px);
    }
    /* Full width: the band runs edge to edge; the text column stays the same */
    #shopify-section-{{ section.id }} .wfrm--full {
      border-radius: 0;
      padding-inline: var(--page-padding, 20px);
    }
    #shopify-section-{{ section.id }} .wfrm__col {
      max-width: 820px;
      margin-inline: auto;
      color: #171717;
    }
    #shopify-section-{{ section.id }} .wfrm__heading {
      margin: 0 0 clamp(20px, 2.4vw, 32px);
      font-family: var(--font-heading-family);
      font-weight: var(--font-heading-weight);
      font-size: clamp(2.25rem, 4.4vw, 4rem);
      line-height: 1.02;
      letter-spacing: -0.025em;
    }
    #shopify-section-{{ section.id }} .wfrm__body {
      position: relative;
      font-size: var(--text-base);
      line-height: 1.65;
    }
    @media screen and (min-width: 768px) {
      #shopify-section-{{ section.id }} .wfrm__body { font-size: var(--text-lg); }
    }
    #shopify-section-{{ section.id }} .wfrm__body > :first-child { margin-top: 0; }
    #shopify-section-{{ section.id }} .wfrm__body p,
    #shopify-section-{{ section.id }} .wfrm__body ul,
    #shopify-section-{{ section.id }} .wfrm__body ol { margin: 0 0 16px; }
    #shopify-section-{{ section.id }} .wfrm__body ul,
    #shopify-section-{{ section.id }} .wfrm__body ol { padding-inline-start: 1.2em; }
    #shopify-section-{{ section.id }} .wfrm__body ul { list-style: disc; }
    #shopify-section-{{ section.id }} .wfrm__body ol { list-style: decimal; }
    #shopify-section-{{ section.id }} .wfrm__body li::marker { color: #a1a1aa; }
    #shopify-section-{{ section.id }} .wfrm__body li { margin-bottom: 6px; }
    #shopify-section-{{ section.id }} .wfrm__body a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    #shopify-section-{{ section.id }} .wfrm__body :is(h2, h3, h4, h5, h6) {
      margin: 36px 0 12px;
      font-family: var(--font-heading-family);
      font-weight: var(--font-heading-weight);
      font-size: clamp(1.25rem, 1.6vw, 1.5rem);
      line-height: 1.25;
      letter-spacing: -0.01em;
      color: inherit;
    }

    /* Collapsed: cut off at the set height with a fade into the band colour */
    #shopify-section-{{ section.id }} .wfrm__wrap.is-collapsible:not(.is-open) .wfrm__body {
      max-height: var(--wfrm-collapsed);
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .wfrm__wrap.is-collapsible:not(.is-open) .wfrm__body::after {
      content: '';
      position: absolute;
      inset: auto 0 0 0;
      height: min(140px, 60%);
      background: linear-gradient(to bottom, transparent, var(--wfrm-bg));
      pointer-events: none;
    }
    #shopify-section-{{ section.id }} .wfrm__toggle {
      margin-top: 28px;
    }
    #shopify-section-{{ section.id }} .wfrm__toggle .btn-text {
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    #shopify-section-{{ section.id }} .wfrm__chev { transition: transform .25s ease; }
    #shopify-section-{{ section.id }} .wfrm__wrap.is-open .wfrm__chev { transform: rotate(180deg); }
  </style>

  <script>
    if (!customElements.get('wf-read-more')) {
      customElements.define('wf-read-more', class extends HTMLElement {
        connectedCallback() {
          const body = this.querySelector('.wfrm__body');
          const btn = this.querySelector('.wfrm__toggle');
          if (!body || !btn) return;
          const limit = parseFloat(getComputedStyle(this).getPropertyValue('--wfrm-collapsed')) || 320;
          // Only collapse when there's meaningfully more text than the collapsed height
          if (body.scrollHeight <= limit + 80) return;
          this.classList.add('is-collapsible');
          btn.hidden = false;
          btn.addEventListener('click', () => {
            const open = !this.classList.contains('is-open');
            this.classList.toggle('is-open', open);
            btn.setAttribute('aria-expanded', String(open));
            btn.querySelector('[data-more]').hidden = open;
            btn.querySelector('[data-less]').hidden = !open;
            if (!open) this.closest('.wfrm').scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          });
        }
      });
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FY27 read more",
  "tag": "section",
  "class": "wf-read-more-section",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Text",
      "options": [
        { "value": "collection", "label": "Collection's About copy" },
        { "value": "custom", "label": "Text below" }
      ],
      "default": "collection",
      "info": "Collection's About copy uses custom.uk_seo_description, or custom.us_seo_description in the US market."
    },
    { "type": "text", "id": "heading", "label": "Heading", "info": "[collection] is replaced with the collection title.", "default": "[collection]" },
    { "type": "richtext", "id": "text", "label": "Text", "visible_if": "{{ section.settings.source == 'custom' }}", "default": "<p>Add your text here.</p>" },
    { "type": "range", "id": "collapsed_height", "label": "Height before Read more", "min": 120, "max": 600, "step": 20, "unit": "px", "default": 300 },
    { "type": "text", "id": "more_label", "label": "Read more label", "default": "Read more" },
    { "type": "text", "id": "less_label", "label": "Read less label", "default": "Read less" },
    { "type": "color", "id": "color_background", "label": "Band colour", "default": "#f4f4f4" },
    { "type": "checkbox", "id": "full_width", "label": "Full width band", "info": "The grey band runs edge to edge; the text column stays the same width.", "default": true },
    { "type": "text", "id": "us_market_handle", "label": "US market handle", "default": "usa" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "FY27 read more" }]
}
{% endschema %}
