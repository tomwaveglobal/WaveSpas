{{ 'wave-fy27.css' | asset_url | stylesheet_tag }}
{{ 'wave-fy27b.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wave-fy27.js' | asset_url }}" defer></script>
{%- liquid
  assign kf = product.metafields.custom.key_features | metafield_text
-%}
{%- if section.blocks.size > 0 -%}
<wf-section class="wf{% if section.settings.soft %} wf--soft{% endif %}" id="wf-{{ section.id }}" data-wf-nav="{{ section.settings.nav_label | escape }}">
  <div class="wf__inner">
    <div class="wfb-head">
      <h2 class="wf-h2" data-wf-reveal>{{ section.settings.heading }}</h2>
      {%- if section.settings.lede != blank -%}<p class="wf-lede" data-wf-reveal style="--wf-delay: .08s">{{ section.settings.lede }}</p>{%- endif -%}
    </div>

    <div class="wfb-tiles">
      {%- for block in section.blocks -%}
        {%- liquid
          if block.settings.requires != blank
            unless kf contains block.settings.requires or product.tags contains block.settings.requires
              continue
            endunless
          endif
          assign img = block.settings.image | default: product.media[block.settings.media_index].preview_image
        -%}
        <article class="wfb-tile" data-wf-reveal style="--wf-delay: {{ forloop.index0 | modulo: 2 | times: 0.08 }}s" {{ block.shopify_attributes }}>
          <div class="wfb-tile__media">
            {%- if img != blank -%}
              {{ img | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 45vw, 90vw', widths: '600, 900, 1200, 1400', alt: block.settings.title }}
            {%- endif -%}
          </div>
          <h3 class="wf-h3">{{ block.settings.title }}</h3>
          <p class="wf-body">{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</wf-section>
{%- endif -%}

{% schema %}
{
  "name": "FY27-2 design details",
  "settings": [
    { "type": "text", "id": "nav_label", "label": "Tab label", "default": "Design details" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Design details" },
    { "type": "textarea", "id": "lede", "label": "Intro" },
    { "type": "checkbox", "id": "soft", "label": "Off-white background", "default": false }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "range", "id": "media_index", "label": "Or gallery image number", "min": 0, "max": 20, "step": 1, "default": 1 },
        { "type": "text", "id": "title", "label": "Title", "default": "Detail" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "What it does for you." },
        { "type": "text", "id": "requires", "label": "Only when the product mentions", "info": "Optional. A word from key features or a tag, e.g. VertaAir, LED strip." }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
