{{ 'wave-fy27.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wave-fy27.js' | asset_url }}" defer></script>
{%- liquid
  assign name = product.title | split: '|' | first | strip
  assign variant = product.selected_or_first_available_variant
  assign img = section.settings.image | default: product.featured_media.preview_image
  assign heading = section.settings.heading | replace: '[product]', name
-%}
<wf-section class="wf{% if section.settings.dark %} wf--dark{% endif %}" id="wf-{{ section.id }}">
  <div class="wf__inner wf-cl">
    <p class="wf-eyebrow wf-eyebrow--accent" data-wf-reveal>{{ name }}</p>
    <h2 class="wf-display" data-wf-reveal style="--wf-delay: .08s">{{ heading }}</h2>

    {%- if img != blank -%}
      <div class="wf-cl__img" data-wf-reveal style="--wf-delay: .16s">
        {{- img | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 880px, 100vw', widths: '600, 900, 1200, 1800', alt: name -}}
      </div>
    {%- endif -%}

    <wf-price style="display:block" data-currency="{{ cart.currency.iso_code }}" data-wf-reveal>
      <p class="wf-cl__price">
        <span data-now>{{ variant.price | money }}</span>
        <s data-was{% unless variant.compare_at_price > variant.price %} hidden{% endunless %}>{{ variant.compare_at_price | money }}</s>
      </p>
    </wf-price>

    <div class="wf-cl__ctas" data-wf-reveal style="--wf-delay: .08s">
      <wf-buy><button type="button" class="wf-btn">{{ section.settings.button_label }}</button></wf-buy>
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="wf-trust" role="list" data-wf-reveal style="--wf-delay: .16s">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <b>{{ block.settings.title }}</b>
            <span>{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</wf-section>

{% schema %}
{
  "name": "FY27 closer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "[product] becomes the product name.", "default": "Tonight could look like this." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the product's featured image." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Choose yours" },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Reason",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Reason" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Detail." }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
