{{ 'wave-fy27.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wave-fy27.js' | asset_url }}" defer></script>
{%- liquid
  assign name = product.title | split: '|' | first | strip
  assign variant = product.selected_or_first_available_variant
  assign img = section.settings.image | default: product.featured_media.preview_image
  assign img_mobile = section.settings.image_mobile | default: img
  assign heading = section.settings.heading | replace: '[product]', name
-%}
<style>
  #shopify-section-{{ section.id }} .wf-cl__scrim { opacity: {{ section.settings.overlay | divided_by: 100.0 }}; }
</style>
<wf-section class="wf wf--dark" id="wf-{{ section.id }}">
  <div class="wf-cl">
    {%- if img != blank -%}
      <picture class="wf-cl__media">
        <source media="(max-width: 749px)" srcset="{{ img_mobile | image_url: width: 900 }} 900w, {{ img_mobile | image_url: width: 1400 }} 1400w" sizes="100vw">
        {{- img | image_url: width: 3000 | image_tag: loading: 'lazy', sizes: '100vw', widths: '1200, 1800, 2400, 3000', alt: section.settings.image_alt -}}
      </picture>
    {%- endif -%}
    <div class="wf-cl__scrim" aria-hidden="true"></div>

    <div class="wf-cl__content">
      <p class="wf-eyebrow" data-wf-reveal>{{ name }}</p>
      <h2 class="wf-display" data-wf-reveal style="--wf-delay: .08s">{{ heading }}</h2>
      <wf-price class="wf-cl__price" data-currency="{{ cart.currency.iso_code }}" data-wf-reveal style="--wf-delay: .16s">
        <span data-now>{{ variant.price | money }}</span>
        <s data-was{% unless variant.compare_at_price > variant.price %} hidden{% endunless %}>{{ variant.compare_at_price | money }}</s>
      </wf-price>
      <div class="wf-cl__ctas" data-wf-reveal style="--wf-delay: .24s">
        <wf-buy><button type="button" class="button button--primary" is="hover-button"><span class="btn-fill" data-fill></span><span class="btn-text">{{ section.settings.button_label }}</span></button></wf-buy>
      </div>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="wf__inner wf__inner--tight">
      <ul class="wf-trust" role="list" data-wf-reveal style="--n: {{ section.blocks.size }}">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <h3 class="wf-h3" style="font-size:16px">{{ block.settings.title }}</h3>
            <p class="wf-body">{{ block.settings.text }}</p>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</wf-section>

{% schema %}
{
  "name": "FY27 closer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "[product] becomes the product name.", "default": "Tonight could look like this." },
    { "type": "image_picker", "id": "image", "label": "Image (desktop)", "info": "A wide lifestyle photo. Leave empty to use the product's featured image." },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)", "info": "Optional portrait crop." },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "A Wave hot tub in a garden at dusk" },
    { "type": "range", "id": "overlay", "label": "Darken image", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 45 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Choose yours" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Reason",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Reason" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Detail." }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
