{{ 'wave-fy27.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wave-fy27.js' | asset_url }}" defer></script>
{%- liquid
  assign kf = product.metafields.custom.key_features | metafield_text
  assign ts = product.metafields.custom.tech_specs | metafield_text
  assign spec_text = kf | append: ' ' | append: ts | newline_to_br | replace: '<br />', ' '

  comment
    Wall comes from the key features text, e.g. "Rigid 8cm PE foam wall at 40kg/cm³".
  endcomment
  assign wall_t = 0
  assign density = 0
  if spec_text contains 'cm PE foam wall'
    assign wall_t = spec_text | split: 'cm PE foam wall' | first | split: ' ' | last | plus: 0
    if spec_text contains 'foam wall at '
      assign density = spec_text | split: 'foam wall at ' | last | split: 'kg' | first | strip | plus: 0
    endif
  endif

  assign show = false
  if wall_t > 0
    if section.settings.scope == 'any' or product.tags contains 'eco foam'
      assign show = true
    endif
  endif

  assign old_t = section.settings.old_thickness
  assign thinner = false
  if wall_t < old_t and product.tags contains 'eco foam'
    assign thinner = true
  endif
  assign gain = old_t | minus: wall_t | times: 2

  assign rate = section.settings.rate_gbp
  case cart.currency.iso_code
    when 'EUR'
      assign rate = section.settings.rate_eur
    when 'USD'
      assign rate = section.settings.rate_usd
  endcase
  assign kwh = product.metafields.specs.kwh_per_day.value
  assign saving_month = 0
  assign saving_pct = 0
  if kwh != blank and section.settings.inflatable_kwh > kwh
    assign saving_month = section.settings.inflatable_kwh | minus: kwh | times: section.settings.usage_days | times: rate | divided_by: 100.0 | round
    assign saving_pct = kwh | times: 100 | divided_by: section.settings.inflatable_kwh | round
    assign saving_pct = 100 | minus: saving_pct
  endif
  assign saving_money = saving_month | times: 100 | money_without_trailing_zeros
-%}
{%- if show -%}
<wf-section class="wf" id="wf-{{ section.id }}" data-wf-nav="{{ section.settings.nav_label | escape }}">
  <div class="wf__inner">
    <div class="wf-head">
      <p class="wf-eyebrow wf-eyebrow--accent" data-wf-reveal>{{ section.settings.eyebrow }}</p>
      <h2 class="wf-h2" data-wf-reveal style="--wf-delay: .08s">{{ section.settings.heading }}</h2>
      <p class="wf-lede" data-wf-reveal style="--wf-delay: .16s">{{ section.settings.lede }}{% if thinner %} {{ section.settings.lede_thinner }}{% endif %}</p>
    </div>

    <div class="wf-th" data-toggle-root data-state="eco" data-wf-reveal>
      <svg viewBox="0 0 1200 620" role="img" aria-label="{{ section.settings.image_label | escape }}">
        <defs>
          <linearGradient id="wfSky-{{ section.id }}" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0a1330"/><stop offset=".6" stop-color="#101f45"/><stop offset="1" stop-color="#16295a"/>
          </linearGradient>
          <radialGradient id="wfCore-{{ section.id }}" cx=".5" cy=".45" r=".6">
            <stop offset="0" stop-color="#fff4c2"/><stop offset=".25" stop-color="#ffd166"/><stop offset=".55" stop-color="#ff8a3c"/><stop offset=".85" stop-color="#e2463a"/><stop offset="1" stop-color="#b3265a"/>
          </radialGradient>
          <radialGradient id="wfLeak-{{ section.id }}" cx=".5" cy=".5" r=".5">
            <stop offset="0" stop-color="#ff7a3c" stop-opacity=".85"/><stop offset=".55" stop-color="#d9376b" stop-opacity=".45"/><stop offset="1" stop-color="#6a2bd9" stop-opacity="0"/>
          </radialGradient>
          <linearGradient id="wfSide-{{ section.id }}" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#1f4c8f"/><stop offset="1" stop-color="#152f63"/>
          </linearGradient>
          <linearGradient id="wfSideHot-{{ section.id }}" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#e2463a"/><stop offset="1" stop-color="#8a2a8f"/>
          </linearGradient>
          <linearGradient id="wfScale-{{ section.id }}" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#16295a"/><stop offset=".3" stop-color="#2f6fd0"/><stop offset=".55" stop-color="#b3265a"/><stop offset=".8" stop-color="#ff8a3c"/><stop offset="1" stop-color="#fff4c2"/>
          </linearGradient>
          <filter id="wfBlur-{{ section.id }}" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="18"/></filter>
          <filter id="wfSoft-{{ section.id }}"><feGaussianBlur stdDeviation="6"/></filter>
        </defs>

        <rect width="1200" height="620" fill="url(#wfSky-{{ section.id }})"/>

        {%- comment -%} heat escaping into the night: only when uninsulated {%- endcomment -%}
        <ellipse class="wf-th__leak" cx="600" cy="360" rx="470" ry="230" fill="url(#wfLeak-{{ section.id }})" filter="url(#wfBlur-{{ section.id }})"/>

        {%- comment -%} ground {%- endcomment -%}
        <ellipse cx="600" cy="500" rx="560" ry="90" fill="#0c1a3d" opacity=".8"/>

        {%- comment -%} tub body {%- endcomment -%}
        <path d="M280 330 v110 a320 120 0 0 0 640 0 v-110" fill="url(#wfSide-{{ section.id }})"/>
        <path class="wf-th__hot" d="M280 330 v110 a320 120 0 0 0 640 0 v-110" fill="url(#wfSideHot-{{ section.id }})"/>
        <ellipse cx="600" cy="330" rx="320" ry="120" fill="#23569e"/>
        <ellipse class="wf-th__hot" cx="600" cy="330" rx="320" ry="120" fill="#d9376b"/>
        <ellipse cx="600" cy="330" rx="320" ry="120" fill="none" stroke="rgba(255,255,255,.18)"/>

        {%- comment -%} water: the warm core {%- endcomment -%}
        <ellipse cx="600" cy="326" rx="262" ry="94" fill="url(#wfCore-{{ section.id }})"/>
        <ellipse class="wf-th__shimmer" cx="600" cy="316" rx="150" ry="44" fill="#fff4c2" opacity=".35" filter="url(#wfSoft-{{ section.id }})"/>

        {%- comment -%} heat turning back at the wall {%- endcomment -%}
        <g class="wf-th__bounce" fill="none" stroke="#fff4c2" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M470 326 q-60 0 -80 -26 l14 -2 m-14 2 l4 13"/>
          <path d="M730 326 q60 0 80 -26 l-14 -2 m14 2 l-4 13"/>
        </g>
        <g class="wf-th__escape" fill="none" stroke="#ff9a5c" stroke-width="3" stroke-linecap="round" stroke-dasharray="6 10">
          <path d="M270 330 q-60 -10 -140 -60"/><path d="M930 330 q60 -10 140 -60"/><path d="M420 470 q-40 50 -110 80"/><path d="M780 470 q40 50 110 80"/>
        </g>

        {%- comment -%} steam {%- endcomment -%}
        <g class="wf-th__steam" fill="none" stroke="rgba(255,255,255,.55)" stroke-width="3" stroke-linecap="round">
          <path d="M540 280 c-16 -30 16 -50 0 -90" style="--t:0s"/>
          <path d="M610 270 c-16 -30 16 -50 0 -100" style="--t:1.2s"/>
          <path d="M675 285 c-16 -30 16 -50 0 -80" style="--t:2.3s"/>
        </g>

        {%- comment -%} snow {%- endcomment -%}
        <g class="wf-th__snow" fill="#fff">
          {%- for i in (1..34) -%}
            {%- liquid
              assign x = i | times: 97 | modulo: 1180 | plus: 10
              assign y = i | times: 53 | modulo: 260
              assign r = i | modulo: 3 | plus: 1.5
              assign d = i | modulo: 5 | plus: 7
              assign t = i | modulo: 7 | times: 1.3
            -%}
            <circle cx="{{ x }}" cy="{{ y | minus: 60 }}" r="{{ r }}" opacity=".7" style="--d:{{ d }}s;--t:-{{ t }}s"/>
          {%- endfor -%}
        </g>

        {%- comment -%} readings {%- endcomment -%}
        <text x="600" y="338" text-anchor="middle" font-size="34" font-weight="700" fill="#3a1a00">40°C</text>
        <g>
          <rect x="60" y="56" width="190" height="66" rx="14" fill="rgba(255,255,255,.1)" stroke="rgba(255,255,255,.25)"/>
          <text x="84" y="84" font-size="14" fill="rgba(255,255,255,.7)">{{ section.settings.outside_label }}</text>
          <text x="84" y="109" font-size="22" font-weight="700" fill="#fff">{{ section.settings.outside_temp }}</text>
        </g>

        {%- comment -%} thermal scale {%- endcomment -%}
        <g transform="translate(900 64)">
          <rect width="240" height="10" rx="5" fill="url(#wfScale-{{ section.id }})"/>
          <text x="0" y="34" font-size="13" fill="rgba(255,255,255,.65)">{{ section.settings.cold_label }}</text>
          <text x="240" y="34" font-size="13" fill="rgba(255,255,255,.65)" text-anchor="end">{{ section.settings.warm_label }}</text>
        </g>
      </svg>

      <div class="wf-th__bar">
        <wf-toggle class="wf-seg" data-attr="state" role="group" aria-label="{{ section.settings.toggle_label | escape }}">
          <button type="button" data-value="leak" aria-pressed="false">{{ section.settings.leak_label }}</button>
          <button type="button" data-value="eco" aria-pressed="true">{{ section.settings.eco_label }}</button>
        </wf-toggle>
        <p class="wf-th__caption wf-th__caption--eco">{{ section.settings.eco_caption }}</p>
        <p class="wf-th__caption wf-th__caption--leak">{{ section.settings.leak_caption }}</p>
      </div>
    </div>

    <div class="wf-ben3">
      <div data-wf-reveal>
        {%- render 'wave-fy27-glyph', name: 'heat', class: 'wf-ben3__glyph' -%}
        <h3 class="wf-h3">{{ section.settings.b1_title }}</h3>
        <p class="wf-body">{{ section.settings.b1_text }}</p>
      </div>
      {%- if saving_month > 0 -%}
        <div data-wf-reveal style="--wf-delay: .08s">
          <p class="wf-ben3__big">{{ saving_money }}<small> {{ section.settings.b2_per }}</small></p>
          <h3 class="wf-h3">{{ section.settings.b2_title | replace: '[pct]', saving_pct }}</h3>
          <p class="wf-body">{{ section.settings.b2_text | replace: '[pct]', saving_pct }}</p>
        </div>
      {%- endif -%}
      {%- if thinner and gain > 0 -%}
        <div data-wf-reveal style="--wf-delay: .16s">
          <p class="wf-ben3__big">+{{ gain }}<small> cm</small></p>
          <h3 class="wf-h3">{{ section.settings.b3_title }}</h3>
          <p class="wf-body">{{ section.settings.b3_text }}</p>
        </div>
      {%- else -%}
        <div data-wf-reveal style="--wf-delay: .16s">
          {%- render 'wave-fy27-glyph', name: 'seat', class: 'wf-ben3__glyph' -%}
          <h3 class="wf-h3">{{ section.settings.b4_title }}</h3>
          <p class="wf-body">{{ section.settings.b4_text }}</p>
        </div>
      {%- endif -%}
    </div>

    <p class="wf-small wf-th__foot">
      {{ wall_t }} cm {{ section.settings.foot_wall }}{% if density > 0 %}, {{ density }} kg/m³{% endif %}.
      {%- if saving_month > 0 %} {{ section.settings.footnote | replace: '[kwh]', kwh | replace: '[ikwh]', section.settings.inflatable_kwh | replace: '[days]', section.settings.usage_days | replace: '[rate]', rate }}{% endif %}
    </p>

    {%- if section.settings.show_notes -%}
      <p class="wf-note">Test note: the thermal picture is an illustration, not a real thermal image. A real thermal-camera shot of an FY27 spa on a cold night would be stronger if product can get one. "+{{ gain }} cm more room" only shows on eco foam spas thinner than the {{ old_t }} cm previous-wall setting, so confirm that figure. The monthly saving uses the Wave calculator figures ({{ kwh | default: '—' }} vs {{ section.settings.inflatable_kwh }} kWh a day, {{ section.settings.usage_days }} days, {{ rate }}p). The spec data says "kg/cm³"; the correct unit is kg/m³.</p>
    {%- endif -%}
  </div>
</wf-section>
{%- endif -%}

{% schema %}
{
  "name": "FY27 eco foam",
  "settings": [
    { "type": "text", "id": "nav_label", "label": "Nav label", "default": "Eco foam" },
    {
      "type": "select",
      "id": "scope",
      "label": "Show on",
      "options": [
        { "value": "eco", "label": "Eco foam spas only" },
        { "value": "any", "label": "Any spa with a foam wall (incl. frame)" }
      ],
      "default": "any"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Eco foam walls" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The warmth stays with you." },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "Eco foam wraps the water on every side, so it's still warm when you lift the lid, the heater has less to do, and the bills stay small." },
    { "type": "textarea", "id": "lede_thinner", "label": "Extra line (slimmer wall)", "default": "And this year's wall is slimmer and denser, so there's more room inside without losing any warmth." },
    { "type": "header", "content": "Picture" },
    { "type": "text", "id": "image_label", "label": "Picture description (for screen readers)", "default": "A hot tub on a snowy night, shown like a thermal camera: the water glows warm while the eco foam wall keeps the heat from escaping" },
    { "type": "text", "id": "outside_label", "label": "Outside label", "default": "Winter night" },
    { "type": "text", "id": "outside_temp", "label": "Outside temperature", "default": "2°C" },
    { "type": "text", "id": "cold_label", "label": "Scale, cold", "default": "Cold" },
    { "type": "text", "id": "warm_label", "label": "Scale, warm", "default": "Warm" },
    { "type": "text", "id": "toggle_label", "label": "Toggle description", "default": "Compare an uninsulated wall with eco foam" },
    { "type": "text", "id": "leak_label", "label": "Uninsulated label", "default": "Uninsulated" },
    { "type": "text", "id": "eco_label", "label": "Eco foam label", "default": "Eco foam" },
    { "type": "text", "id": "eco_caption", "label": "Eco foam caption", "default": "The foam keeps the heat in the water, where you are." },
    { "type": "text", "id": "leak_caption", "label": "Uninsulated caption", "default": "Without insulation, warmth drains out into the night." },
    { "type": "header", "content": "Benefits" },
    { "type": "text", "id": "b1_title", "label": "Benefit 1 title", "default": "Ready when you are" },
    { "type": "textarea", "id": "b1_text", "label": "Benefit 1 text", "default": "The water holds its heat between soaks, so there's no long wait before you can get back in." },
    { "type": "text", "id": "b2_per", "label": "Benefit 2 figure suffix", "default": "a month" },
    { "type": "text", "id": "b2_title", "label": "Benefit 2 title", "info": "[pct] becomes the energy saving.", "default": "Less to keep warm" },
    { "type": "textarea", "id": "b2_text", "label": "Benefit 2 text", "default": "Around [pct]% less energy than an inflatable to keep at temperature, on our running cost estimates." },
    { "type": "text", "id": "b3_title", "label": "Benefit 3 title (slimmer wall)", "default": "More room inside" },
    { "type": "textarea", "id": "b3_text", "label": "Benefit 3 text (slimmer wall)", "default": "Slimmer, denser walls give you more water across in the same footprint." },
    { "type": "text", "id": "b4_title", "label": "Benefit 3 title (other walls)", "default": "Solid to lean on" },
    { "type": "textarea", "id": "b4_text", "label": "Benefit 3 text (other walls)", "default": "Rigid walls stand up on their own and feel firm when you sit back against them." },
    { "type": "text", "id": "foot_wall", "label": "Footnote wall text", "default": "rigid eco foam wall" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Saving compares [kwh] kWh a day with [ikwh] kWh a day for an inflatable, used [days] days a month at [rate]p per kWh." },
    { "type": "header", "content": "Figures" },
    { "type": "number", "id": "old_thickness", "label": "Previous wall thickness (cm)", "default": 15 },
    { "type": "number", "id": "inflatable_kwh", "label": "Inflatable kWh a day (for comparison)", "default": 16 },
    { "type": "range", "id": "usage_days", "label": "Days used a month", "min": 4, "max": 30, "step": 1, "default": 15 },
    { "type": "number", "id": "rate_gbp", "label": "Electricity price, GBP (pence)", "default": 28 },
    { "type": "number", "id": "rate_eur", "label": "Electricity price, EUR (cents)", "default": 30 },
    { "type": "number", "id": "rate_usd", "label": "Electricity price, USD (cents)", "default": 17 },
    { "type": "checkbox", "id": "show_notes", "label": "Show test notes", "default": true }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
