{{ 'wave-fy27.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wave-fy27.js' | asset_url }}" defer></script>
{%- liquid
  assign kf = product.metafields.custom.key_features | metafield_text
  assign ts = product.metafields.custom.tech_specs | metafield_text
  assign spec_text = kf | append: ' ' | append: ts | newline_to_br | replace: '<br />', ' '

  comment
    Wall comes from the key features text, e.g. "Rigid 8cm PE foam wall at 40kg/cm³".
  endcomment
  assign wall_t = 0
  assign density = 0
  if spec_text contains 'cm PE foam wall'
    assign wall_t = spec_text | split: 'cm PE foam wall' | first | split: ' ' | last | plus: 0
    if spec_text contains 'foam wall at '
      assign density = spec_text | split: 'foam wall at ' | last | split: 'kg' | first | strip | plus: 0
    endif
  endif

  assign show = false
  if wall_t > 0
    if section.settings.scope == 'any' or product.tags contains 'eco foam'
      assign show = true
    endif
  endif

  assign old_t = section.settings.old_thickness
  assign thinner = false
  if wall_t < old_t and product.tags contains 'eco foam'
    assign thinner = true
  endif
  assign gain = old_t | minus: wall_t | times: 2

  assign rate = section.settings.rate_gbp
  case cart.currency.iso_code
    when 'EUR'
      assign rate = section.settings.rate_eur
    when 'USD'
      assign rate = section.settings.rate_usd
  endcase
  assign kwh = product.metafields.specs.kwh_per_day.value
  assign saving_month = 0
  assign saving_pct = 0
  if kwh != blank and section.settings.inflatable_kwh > kwh
    assign saving_month = section.settings.inflatable_kwh | minus: kwh | times: section.settings.usage_days | times: rate | divided_by: 100.0 | round
    assign saving_pct = kwh | times: 100 | divided_by: section.settings.inflatable_kwh | round
    assign saving_pct = 100 | minus: saving_pct
  endif
  assign saving_money = saving_month | times: 100 | money_without_trailing_zeros
-%}
{%- if show -%}
<wf-section class="wf" id="wf-{{ section.id }}" data-wf-nav="{{ section.settings.nav_label | escape }}">
  <div class="wf__inner">
    <div class="wf-head">
      <p class="wf-eyebrow wf-eyebrow--accent" data-wf-reveal>{{ section.settings.eyebrow }}</p>
      <h2 class="wf-h2" data-wf-reveal style="--wf-delay: .08s">{{ section.settings.heading }}</h2>
      <p class="wf-lede" data-wf-reveal style="--wf-delay: .16s">{{ section.settings.lede }}{% if thinner %} {{ section.settings.lede_thinner }}{% endif %}</p>
    </div>

    {%- liquid
      assign img = section.settings.image | default: product.featured_media.preview_image
      assign img_mobile = section.settings.image_mobile | default: img
    -%}
    {%- if img != blank -%}
      <div class="wf-ef__media" data-wf-reveal>
        <picture>
          <source media="(max-width: 749px)" srcset="{{ img_mobile | image_url: width: 900 }} 900w, {{ img_mobile | image_url: width: 1400 }} 1400w" sizes="100vw">
          {{- img | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '(min-width: 1280px) 1240px, 100vw', widths: '800, 1200, 1800, 2400', alt: section.settings.image_alt -}}
        </picture>
        <div class="wf-ef__chips">
          <span class="wf-chip wf-chip--warm"><b>40°C</b><span>{{ section.settings.inside_label }}</span></span>
          {%- if section.settings.outside_temp != blank -%}
            <span class="wf-chip"><b>{{ section.settings.outside_temp }}</b><span>{{ section.settings.outside_label }}</span></span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="wf-cols" style="--cols: 3">
      <div data-wf-reveal>
        {%- render 'wave-fy27-glyph', name: 'heat', class: 'wf-glyph' -%}
        <h3 class="wf-h3">{{ section.settings.b1_title }}</h3>
        <p class="wf-body">{{ section.settings.b1_text }}</p>
      </div>
      {%- if saving_month > 0 -%}
        <div data-wf-reveal style="--wf-delay: .08s">
          <span class="wf-fig wf-fig--accent">{{ saving_money }}<small>/month</small></span>
          <h3 class="wf-h3">{{ section.settings.b2_title | replace: '[pct]', saving_pct }}</h3>
          <p class="wf-body">{{ section.settings.b2_text | replace: '[pct]', saving_pct }}</p>
        </div>
      {%- endif -%}
      {%- if thinner and gain > 0 -%}
        <div data-wf-reveal style="--wf-delay: .16s">
          <span class="wf-fig wf-fig--accent">+{{ gain }}<small>cm</small></span>
          <h3 class="wf-h3">{{ section.settings.b3_title }}</h3>
          <p class="wf-body">{{ section.settings.b3_text }}</p>
        </div>
      {%- else -%}
        <div data-wf-reveal style="--wf-delay: .16s">
          {%- render 'wave-fy27-glyph', name: 'seat', class: 'wf-glyph' -%}
          <h3 class="wf-h3">{{ section.settings.b4_title }}</h3>
          <p class="wf-body">{{ section.settings.b4_text }}</p>
        </div>
      {%- endif -%}
    </div>

    <p class="wf-small wf-ef__foot">
      {{ wall_t }} cm {{ section.settings.foot_wall }}{% if density > 0 %}, {{ density }} kg/m³{% endif %}.
      {%- if saving_month > 0 %} {{ section.settings.footnote | replace: '[kwh]', kwh | replace: '[ikwh]', section.settings.inflatable_kwh | replace: '[days]', section.settings.usage_days | replace: '[rate]', rate }}{% endif %}
    </p>

    {%- if section.settings.show_notes -%}
      <p class="wf-note">Test note: the photo is FY26 Garda in the snow, a placeholder until FY27 photography exists. "+{{ gain }} cm more room" only shows on eco foam spas thinner than the {{ old_t }} cm previous-wall setting, so confirm that figure. The monthly saving uses the Wave calculator figures ({{ kwh | default: '—' }} vs {{ section.settings.inflatable_kwh }} kWh a day, {{ section.settings.usage_days }} days, {{ rate }}p). The spec data says "kg/cm³"; the correct unit is kg/m³.</p>
    {%- endif -%}
  </div>
</wf-section>
{%- endif -%}

{% schema %}
{
  "name": "FY27 eco foam",
  "settings": [
    { "type": "text", "id": "nav_label", "label": "Nav label", "default": "Eco foam" },
    {
      "type": "select",
      "id": "scope",
      "label": "Show on",
      "options": [
        { "value": "eco", "label": "Eco foam spas only" },
        { "value": "any", "label": "Any spa with a foam wall (incl. frame)" }
      ],
      "default": "any"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Eco foam walls" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The warmth stays with you." },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "Eco foam wraps the water on every side, so it's still warm when you lift the lid, the heater has less to do, and the bills stay small." },
    { "type": "textarea", "id": "lede_thinner", "label": "Extra line (slimmer wall)", "default": "And this year's wall is slimmer and denser, so there's more room inside without losing any warmth." },
    { "type": "header", "content": "Picture" },
    { "type": "image_picker", "id": "image", "label": "Image (desktop)", "info": "A spa holding its heat, ideally steam on a cold day." },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)" },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "A Wave eco foam hot tub steaming in a snowy garden" },
    { "type": "text", "id": "inside_label", "label": "Water chip label", "default": "in the water" },
    { "type": "text", "id": "outside_temp", "label": "Outside temperature chip", "default": "2°C" },
    { "type": "text", "id": "outside_label", "label": "Outside chip label", "default": "outside" },
    { "type": "header", "content": "Benefits" },
    { "type": "text", "id": "b1_title", "label": "Benefit 1 title", "default": "Ready when you are" },
    { "type": "textarea", "id": "b1_text", "label": "Benefit 1 text", "default": "The water holds its heat between soaks, so there's no long wait before you can get back in." },
    { "type": "text", "id": "b2_title", "label": "Benefit 2 title", "info": "[pct] becomes the energy saving.", "default": "Less to keep warm" },
    { "type": "textarea", "id": "b2_text", "label": "Benefit 2 text", "default": "Around [pct]% less energy than an inflatable to keep at temperature, on our running cost estimates." },
    { "type": "text", "id": "b3_title", "label": "Benefit 3 title (slimmer wall)", "default": "More room inside" },
    { "type": "textarea", "id": "b3_text", "label": "Benefit 3 text (slimmer wall)", "default": "Slimmer, denser walls give you more water across in the same footprint." },
    { "type": "text", "id": "b4_title", "label": "Benefit 3 title (other walls)", "default": "Solid to lean on" },
    { "type": "textarea", "id": "b4_text", "label": "Benefit 3 text (other walls)", "default": "Rigid walls stand up on their own and feel firm when you sit back against them." },
    { "type": "text", "id": "foot_wall", "label": "Footnote wall text", "default": "rigid eco foam wall" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Saving compares [kwh] kWh a day with [ikwh] kWh a day for an inflatable, used [days] days a month at [rate]p per kWh." },
    { "type": "header", "content": "Figures" },
    { "type": "number", "id": "old_thickness", "label": "Previous wall thickness (cm)", "default": 15 },
    { "type": "number", "id": "inflatable_kwh", "label": "Inflatable kWh a day (for comparison)", "default": 16 },
    { "type": "range", "id": "usage_days", "label": "Days used a month", "min": 4, "max": 30, "step": 1, "default": 15 },
    { "type": "number", "id": "rate_gbp", "label": "Electricity price, GBP (pence)", "default": 28 },
    { "type": "number", "id": "rate_eur", "label": "Electricity price, EUR (cents)", "default": 30 },
    { "type": "number", "id": "rate_usd", "label": "Electricity price, USD (cents)", "default": 17 },
    { "type": "checkbox", "id": "show_notes", "label": "Show test notes", "default": true }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
