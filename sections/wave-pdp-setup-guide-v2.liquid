{{ 'wave-pdp.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }
</style>
<div class="wpdp section section--padding{% if section.settings.divider %} section--divider{% endif %}">
  <div class="page-width relative grid gap-8 lg:gap-10">
    {%- render 'section-heading', section: section -%}
    {%- liquid
      assign setup_video = product.metafields.custom.setup_video.value
      assign manual = product.metafields.specs.owners_manual.value
      assign setup_minutes = product.metafields.specs.setup_minutes.value
      if setup_minutes == blank
        assign collage_title = product.metafields.custom.product_collage_image_2_title.value
        if collage_title contains 'Minute'
          assign setup_minutes = collage_title | split: ' ' | first
        endif
      endif
    -%}
    <div class="wpdp-setup">
      <div class="wpdp-setup__media">
        {%- if setup_video != blank -%}
          {{- setup_video | video_tag: controls: true, preload: 'none', playsinline: true, image_size: '1400x' -}}
        {%- elsif product.featured_image != blank -%}
          {{- product.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: product.title -}}
        {%- endif -%}
      </div>
      <div class="wpdp-setup__copy">
        {%- if setup_minutes != blank -%}
          <p class="wpdp-setup__time"><span>{{ setup_minutes }}</span> minutes</p>
          <p class="wpdp-label">from box to filling, no tools</p>
        {%- endif -%}
        <div class="rte">{{ section.settings.body }}</div>
        <ul class="wpdp-setup__steps" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><span class="wpdp-setup__num">{{ forloop.index }}</span><span>{{ block.settings.text }}</span></li>
          {%- endfor -%}
        </ul>
        <div class="wpdp-setup__links">
          {%- if manual != blank -%}
            <a class="button button--primary" href="{{ manual.url }}" target="_blank" rel="noopener"><span class="btn-fill" data-fill></span><span class="btn-text">{{ section.settings.manual_label }}</span></a>
          {%- else -%}
            <span class="wpdp-setup__pending">{{ section.settings.manual_label }} — coming soon</span>
          {%- endif -%}
          {%- if section.settings.guide_link != blank -%}
            <a class="link" href="{{ section.settings.guide_link }}">{{ section.settings.guide_label }}</a>
          {%- endif -%}
        </div>
        {%- if section.settings.show_test_notes and manual == blank -%}
          <p class="wpdp-note">Upload the owner's manual PDF to the product metafield (specs → Owner's manual) to switch the button on.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Wave V2: Setup & guide",
  "tag": "section",
  "class": "wave-pdp-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Set up in <em>minutes</em>, not afternoons"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Wave"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "title-sm",
          "label": "Small"
        },
        {
          "value": "title-md",
          "label": "Medium"
        },
        {
          "value": "title-lg tracking-heading",
          "label": "Large"
        }
      ],
      "default": "title-lg tracking-heading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "text-left md:items-end md:flex-row",
          "label": "Left"
        },
        {
          "value": "text-center md:items-center",
          "label": "Center"
        }
      ],
      "default": "text-left md:items-end md:flex-row"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "highlighted_text",
      "label": "Highlighted text",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "underline",
          "label": "Underline"
        },
        {
          "value": "marker",
          "label": "Marker"
        },
        {
          "value": "scribble",
          "label": "Scribble"
        }
      ],
      "default": "scribble"
    },
    {
      "type": "select",
      "id": "highlighted_scribble",
      "label": "Scribble",
      "options": [
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "basic-underline",
          "label": "Basic underline"
        },
        {
          "value": "sketch-underline",
          "label": "Sketch underline"
        },
        {
          "value": "squiggle-underline",
          "label": "Squiggle underline"
        }
      ],
      "default": "basic-underline"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "default": "<p>Clip it together, drop in the liner, connect the heater and fill. Most people are done before the kettle's boiled twice.</p>"
    },
    {
      "type": "text",
      "id": "manual_label",
      "label": "Manual button",
      "default": "Download the manual"
    },
    {
      "type": "text",
      "id": "guide_label",
      "label": "Guide link",
      "default": "Setup guides & videos"
    },
    {
      "type": "url",
      "id": "guide_link",
      "label": "Guide link URL"
    },
    {
      "type": "header",
      "content": "Testing"
    },
    {
      "type": "checkbox",
      "id": "show_test_notes",
      "label": "Show test notes",
      "default": true
    },
    {
      "type": "header",
      "content": "Colours & spacing"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "color_highlight",
      "label": "Highlight"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "Show divider",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Wave V2: Setup & guide"
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Step",
          "default": "Clip the panels together"
        }
      ]
    }
  ]
}
{% endschema %}
