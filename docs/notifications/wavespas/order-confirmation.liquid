                      {% if preorder_count == 1 %}
                        Your order contains a pre-order item
                      {% else %}
                        Your order contains pre-order items
                      {% endif %}
                    </strong>

                    <table style="width:100%; border-collapse:collapse; margin:10px 0 0 0;">
                      {% for line in subtotal_line_items %}
                        {% assign entry = preorder_entries[forloop.index0] %}
                        {% unless entry == 'NOPO' or entry == blank %}
                          {% assign entry_parts = entry | split: '::' %}
                          {% assign po_label = entry_parts[0] %}
                          {% assign po_date = entry_parts[1] %}

                          {% if line.product.title %}
                            {% assign preorder_title = line.product.title %}
                          {% else %}
                            {% assign preorder_title = line.title %}
                          {% endif %}

                          <tr>
                            <td style="padding:4px 0; font-family:Helvetica,Arial,sans-serif; font-size:14px; line-height:1.5; color:#3c3c3c;">
                              <strong>{{ preorder_title }}</strong>{% if line.variant.title != 'Default Title' and line.variant.title != blank %} &mdash; {{ line.variant.title }}{% endif %}<br>
                              {% if po_date != blank %}
                                {{ po_label }} <strong style="white-space:nowrap;">{{ po_date }}</strong>
                              {% else %}
                                This item is on pre-order. We'll email you as soon as we can confirm the expected date.
                              {% endif %}
                            </td>
                          </tr>
                        {% endunless %}
                      {% endfor %}
                    </table>

                    <p style="margin:12px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:14px; line-height:1.5; color:#3c3c3c;">
                      {% if preorder_dated_count > 0 %}
                        {% if preorder_count == 1 %}
                          This item will not be dispatched before the date shown above.
                        {% else %}
                          These items will not be dispatched before the dates shown above.
                        {% endif %}
                      {% endif %}
                      {% if preorder_count < subtotal_line_items.size %}
                        Any other items in your order will be dispatched as normal and may arrive separately.
                      {% endif %}
