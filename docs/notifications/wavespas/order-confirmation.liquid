{%- comment -%}
  ============================================================================
  PRE-ORDER RESOLUTION — single pass, two sources
  ----------------------------------------------------------------------------
  SOURCE 1 (preferred): the STOQ / Restock Rocket line item property.
    STOQ writes a VISIBLE property on each pre-order line where the property
    NAME is the sentence and the VALUE is the date, e.g.
      "This item is on pre-order with an expected shipping date of" => "31/08/26"
      "This item is on pre-order with an expected delivery date of" => "28/9/2026"
    Both wordings are in use, so match on the name CONTAINING "pre-order".
    STOQ wins when present: it is what the customer was shown at purchase.

  SOURCE 2 (fallback): the variant metafields, when STOQ wrote nothing.
    custom.pre_order_date_{uk,usa,eu}  e.g. "Pre-order | Ships 28/09/26"
    Gated on custom.pre_order_control_{uk,us,eu}: a populated date alone is NOT
    enough. Some variants carry a date while the control flag says "In Stock" or
    "Out of Stock" (all four populated dates on WaveSupBoards are like this,
    including a "Test Pre Order Date 4th July" value). Showing those would tell
    a customer an in-stock item is a pre-order, so they are excluded. A BLANK
    control flag is allowed through — the EU dates are maintained that way.

  Market is chosen from the shipping country, since notification templates have
  no `localization` object. No shipping address (e.g. digital-only) => UK.

  Dates are printed VERBATIM. Both sources mix d/m/y and m/d/y across markets
  ("28/9/2026" UK, "07/27/26" and "09/25/2026" US), so reformatting them would
  misstate the date.

  Misconfigured STOQ variants emit the literal text "{{ date }}"; those fall
  through to the metafield, and show an undated notice if that is empty too.

  If notification Liquid cannot read variant metafields, every metafield lookup
  is simply nil and the template degrades to STOQ-only behaviour — no breakage.
  ============================================================================
{%- endcomment -%}

{%- assign brace = '{' -%}
{%- assign stoq_placeholder = brace | append: brace -%}

{%- assign ship_country = shipping_address.country_code | upcase -%}
{%- assign uk_codes = "GB,GG,IM,JE" | split: "," -%}
{%- assign eu_codes = "AT,BE,BG,HR,CZ,DK,EE,FI,FR,DE,GR,HU,IE,IT,LV,LT,LU,NL,NO,PL,PT,RO,SK,SI,ES,SE,CH" | split: "," -%}

{%- assign preorder_date_key = 'pre_order_date_uk' -%}
{%- assign preorder_control_key = 'pre_order_control_uk' -%}
{%- if eu_codes contains ship_country -%}
  {%- assign preorder_date_key = 'pre_order_date_eu' -%}
  {%- assign preorder_control_key = 'pre_order_control_eu' -%}
{%- elsif uk_codes contains ship_country -%}
  {%- comment -%} keep the UK default {%- endcomment -%}
{%- elsif ship_country != blank -%}
  {%- assign preorder_date_key = 'pre_order_date_usa' -%}
  {%- assign preorder_control_key = 'pre_order_control_us' -%}
{%- endif -%}

{%- assign preorder_count = 0 -%}
{%- assign preorder_dated_count = 0 -%}
{%- assign preorder_from_metafield = 0 -%}
{%- assign preorder_entries = '' -%}

{%- for line in subtotal_line_items -%}
  {%- assign po_label = '' -%}
  {%- assign po_date = '' -%}
  {%- assign po_found = false -%}

  {%- comment -%} 1. STOQ line item property {%- endcomment -%}
  {%- for property in line.properties -%}
    {%- assign property_name = property.first | downcase -%}
    {%- if property_name contains 'pre-order' -%}
      {%- assign po_found = true -%}
      {%- assign po_label = property.first -%}
      {%- assign property_value = property.last | strip -%}
      {%- unless property_value contains stoq_placeholder -%}
        {%- assign po_date = property_value -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} 2. Variant metafield fallback {%- endcomment -%}
  {%- if po_date == blank -%}
    {%- assign mf_date = line.variant.metafields.custom[preorder_date_key] | strip -%}
    {%- assign mf_control = line.variant.metafields.custom[preorder_control_key] | strip | downcase | replace: '-', '' | replace: ' ', '' -%}
    {%- if mf_date != blank and mf_control != 'instock' and mf_control != 'outofstock' -%}
      {%- assign mf_clean = mf_date | split: '|' | last | strip -%}
      {%- assign mf_clean = mf_clean | remove_first: 'Ships' | remove_first: 'ships' | strip -%}
      {%- if mf_clean != blank -%}
        {%- assign po_date = mf_clean -%}
        {%- unless po_found -%}
          {%- assign preorder_from_metafield = preorder_from_metafield | plus: 1 -%}
        {%- endunless -%}
        {%- assign po_found = true -%}
        {%- if po_label == blank -%}
          {%- assign po_label = 'This item is on pre-order with an expected shipping date of' -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} 3. Record the result for this line, keyed by loop position {%- endcomment -%}
  {%- if po_found -%}
    {%- assign preorder_count = preorder_count | plus: 1 -%}
    {%- if po_date != blank -%}
      {%- assign preorder_dated_count = preorder_dated_count | plus: 1 -%}
    {%- endif -%}
    {%- assign preorder_entries = preorder_entries | append: po_label | append: '::' | append: po_date | append: '~|~' -%}
  {%- else -%}
    {%- assign preorder_entries = preorder_entries | append: 'NOPO' | append: '~|~' -%}
  {%- endif -%}
{%- endfor -%}

{%- assign preorder_entries = preorder_entries | split: '~|~' -%}

{% capture email_title %}Thank you for your purchase! {% endcapture %}
{% capture email_body %}
  {% if requires_shipping %}
  {% case delivery_method %}
      {% when 'pick-up' %}
        You'll receive an email when your order is ready for pickup.
      {% when 'local' %}
        Hi {{ customer.first_name }}, we're getting your order ready for delivery.
      {% else %}
        Hi {{ customer.first_name }}, we're getting your order ready to be shipped. We will notify you when it has been sent. Some items are shipped with different carriers therefore packages may arrive separately.
    {% endcase %}
      {% if delivery_instructions != blank  %}
        <p><b>Delivery information:</b> {{ delivery_instructions }}</p>
      {% endif %}
     {% if consolidated_estimated_delivery_time %}
       <p>
         Estimated delivery <b>{{ consolidated_estimated_delivery_time }}</b>
       </p>
     {% endif %}
  {% endif %}
{% endcapture %}

