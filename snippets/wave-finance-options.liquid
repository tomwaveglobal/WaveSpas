{%- doc -%}
  Renders a single "Spread the cost" finance panel under the price, replacing separate finance rows.
  Monthly figures update when the variant changes (listens for the theme's variant:change event).

  @param {object} product - Product being viewed
  @param {boolean} [show_test_notes] - Show amber notes for terms that still need confirming
  @param {boolean} [payl8r_confirmed] - Show a Payl8r monthly figure only once 24-month interest-free terms are confirmed
{%- enddoc -%}
{{ 'wave-pdp.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign price = variant.price
  assign dividebuy_min = 5000
  assign dividebuy_max = 600000
  assign dividebuy_ok = false
  if price >= dividebuy_min and price <= dividebuy_max
    assign dividebuy_ok = true
  endif
  assign pay3 = price | divided_by: 3 | money
  assign pay12 = price | divided_by: 12 | money
  assign pay24 = price | divided_by: 24 | money
  assign logo_klarna = images['Klarna_paypal.png']
  assign logo_dividebuy = images['DivideBuy.png']
  assign logo_payl8r = images['Payl8r.png']
-%}
<wave-finance class="wpdp wfin" data-currency="{{ cart.currency.iso_code }}" data-db-min="{{ dividebuy_min }}" data-db-max="{{ dividebuy_max }}" data-variant-ids="{{ product.variants | map: 'id' | join: ',' }}">
  <details class="wfin__panel">
    <summary class="wfin__summary">
      <p class="wfin__headline">
        <span data-fin-dividebuy{% unless dividebuy_ok %} hidden{% endunless %}>Spread the cost from <strong data-fin-split="12">{{ pay12 }}</strong> a month, interest-free</span>
        <span data-fin-fallback{% if dividebuy_ok %} hidden{% endif %}>Pay in 3 interest-free payments of <strong data-fin-split="3">{{ pay3 }}</strong></span>
      </p>
      <span class="wfin__logos" aria-hidden="true">
        {%- if logo_klarna != blank -%}{{ logo_klarna | image_url: height: 60 | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}
        {%- if logo_dividebuy != blank -%}{{ logo_dividebuy | image_url: height: 60 | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}
        {%- if logo_payl8r != blank -%}{{ logo_payl8r | image_url: height: 60 | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}
      </span>
      <span class="wfin__toggle"><span class="wfin__show">See all payment options</span><span class="wfin__hide">Hide payment options</span></span>
    </summary>

    <div class="wfin__body">
      <ul class="wfin__plans" role="list">
        <li>
          <p class="wfin__plan-name">Pay in 3 <span class="wfin__chip">Interest-free</span></p>
          <p class="wfin__amount"><strong data-fin-split="3">{{ pay3 }}</strong><span>× 3 payments</span></p>
          <ul class="wfin__facts" role="list">
            <li>With Klarna or PayPal</li>
            <li>First payment when your order is confirmed, then after 30 and 60 days</li>
            <li>Klarna's check won't affect your credit score</li>
          </ul>
          <a class="wfin__link link" href="/pages/klarna">How Pay in 3 works</a>
        </li>
        <li data-fin-dividebuy{% unless dividebuy_ok %} hidden{% endunless %}>
          <p class="wfin__plan-name">12 months with DivideBuy <span class="wfin__chip">0% interest</span></p>
          <p class="wfin__amount"><strong data-fin-split="12">{{ pay12 }}</strong><span>× 12 months</span></p>
          <ul class="wfin__facts" role="list">
            <li>No APR or hidden charges</li>
            <li>Check your eligibility without affecting your credit score</li>
            <li>UK residents aged 18 to 75, on orders from £50 to £6,000</li>
          </ul>
          <a class="wfin__link link" href="/pages/dividebuy">How DivideBuy works</a>
        </li>
        <li>
          {%- if payl8r_confirmed -%}
            <p class="wfin__plan-name">24 months with Payl8r <span class="wfin__chip">Interest-free</span></p>
            <p class="wfin__amount"><strong data-fin-split="24">{{ pay24 }}</strong><span>× 24 months</span></p>
          {%- else -%}
            <p class="wfin__plan-name">Up to 24 months with Payl8r <span class="wfin__chip wfin__chip--neutral">Flexible</span></p>
            <p class="wfin__amount"><span>Plans to suit<br>your budget</span></p>
          {%- endif -%}
          <ul class="wfin__facts" role="list">
            <li>Short or longer-term plans, with a quick online decision</li>
            {%- unless payl8r_confirmed -%}<li>Interest-free when available; interest may apply to some plans</li>{%- endunless -%}
          </ul>
          <a class="wfin__link link" href="/pages/payl8r-finance-powered-by-dopple" target="_blank" rel="noopener">Get a personalised quote</a>
        </li>
      </ul>

      <p class="wfin__how">Choose your plan at checkout. You'll see the full terms before you agree to anything.</p>
      <p class="wfin__legal">Pre-orders: payment is taken when you order, which starts any finance plan straight away.</p>
      <p class="wfin__legal">Klarna's Pay in 3 and DivideBuy credit agreements are not regulated by the Financial Conduct Authority. Borrowing more than you can afford or paying late may affect your ability to get credit. 18+, UK residents only, subject to status. Late fees may apply. T&amp;Cs apply.</p>
      {%- if show_test_notes and payl8r_confirmed == false -%}
        <p class="wpdp-note">Payl8r's page only promises interest-free plans "when available", so no 24-month monthly figure is shown. The old rows showed one with 0% APR markup. Confirm the terms, then set payl8r_confirmed to true.</p>
      {%- endif -%}
    </div>
  </details>
</wave-finance>
<script>
  if (!customElements.get('wave-finance')) {
    customElements.define('wave-finance', class extends HTMLElement {
      connectedCallback() {
        this.ids = (this.dataset.variantIds || '').split(',');
        this.money = new Intl.NumberFormat('en-GB', { style: 'currency', currency: this.dataset.currency || 'GBP' });
        this.onVariant = (event) => {
          const variant = event.detail && event.detail.variant;
          if (!variant || typeof variant.price !== 'number' || !this.ids.includes(String(variant.id))) return;
          this.update(variant.price);
        };
        document.addEventListener('variant:change', this.onVariant, true);
      }
      disconnectedCallback() {
        document.removeEventListener('variant:change', this.onVariant, true);
      }
      update(price) {
        this.querySelectorAll('[data-fin-split]').forEach((el) => {
          el.textContent = this.money.format(Math.floor(price / Number(el.dataset.finSplit)) / 100);
        });
        const eligible = price >= Number(this.dataset.dbMin) && price <= Number(this.dataset.dbMax);
        this.querySelectorAll('[data-fin-dividebuy]').forEach((el) => { el.hidden = !eligible; });
        this.querySelectorAll('[data-fin-fallback]').forEach((el) => { el.hidden = eligible; });
      }
    });
  }
</script>
