{%- comment -%}
  FY27 collection badge (Lite / Lush / Luxe), from assets/wave-badge-{tier}.svg. In the collection
  banner it sits to the left of the title and description (the banner adds .wf-tier-banner to its
  box when this renders). Size it with --wf-badge-w; the height follows the badge's shape.

  {% render 'wave-fy27-tier-badge', tier: 'luxe', image: block.settings.image, block: block %}
  {% render 'wave-fy27-tier-badge', tier: 'lush' %}

  Pass an image to use other artwork instead.
{%- endcomment -%}
{%- assign badge_file = 'wave-badge-' | append: tier | append: '.svg' -%}
<style>
  .wf-tier-banner {
    position: relative;
    box-sizing: border-box;
    min-width: 0;
    max-width: 100%;
    padding-inline-start: calc(var(--wf-badge-w) + var(--wf-badge-gap));
    min-height: calc(var(--wf-badge-w) * 1.4616 + 2 * clamp(var(--sp-10), 3.368vw, var(--sp-16)));
    --wf-badge-w: 3.5rem;
    --wf-badge-gap: 1rem;
  }

  .wf-tier-banner > .wf-tier-badge {
    position: absolute;
    inset-inline-start: 0;
    top: clamp(var(--sp-10), 3.368vw, var(--sp-16));
    margin: 0;
  }

  .wf-tier-banner > .wf-tier-badge + * {
    margin-block-start: 0;
  }

  .wf-tier-banner .rte {
    max-width: 38rem;
  }

  .wf-tier-badge {
    display: block;
    width: var(--wf-badge-w, 3.5rem);
    aspect-ratio: 137.06 / 200.32;
  }

  .wf-tier-badge img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media screen and (min-width: 768px) {
    .wf-tier-banner {
      --wf-badge-w: 5rem;
      --wf-badge-gap: 2.25rem;
    }
  }
</style>
<div class="wf-tier-badge"{% if block %} {{ block.shopify_attributes }}{% endif %}>
  {%- if image != blank -%}
    {{- image | image_url: width: 240 | image_tag: alt: '', loading: 'eager', widths: '120,160,240', sizes: '80px' -}}
  {%- else -%}
    <img src="{{ badge_file | asset_url }}" alt="" width="137" height="200" loading="eager">
  {%- endif -%}
</div>
