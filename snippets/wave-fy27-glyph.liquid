{%- comment -%}
  Line glyphs for the FY27 product page.
  Usage: {% render 'wave-fy27-glyph', name: 'bubbles', class: 'wf-bn__glyph' %}
{%- endcomment -%}
<svg class="{{ class }}" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'bubbles' -%}
      <circle cx="22" cy="44" r="6"/><circle cx="38" cy="30" r="8"/><circle cx="26" cy="20" r="4"/><circle cx="46" cy="50" r="3"/><circle cx="44" cy="12" r="2.5"/>
    {%- when 'seat' -%}
      <path d="M18 12c0 14 2 24 6 30h22"/><path d="M24 42v10M46 42v10"/><path d="M18 12c3-2 7-2 9 0"/><path d="M28 42c4-6 12-6 18-2"/>
    {%- when 'wifi' -%}
      <path d="M10 26c12-11 32-11 44 0"/><path d="M17 33c8-7 22-7 30 0"/><path d="M24 40c4-4 12-4 16 0"/><circle cx="32" cy="47" r="2.5"/>
    {%- when 'light' -%}
      <path d="M32 10v6M14 17l4 4M50 17l-4 4M8 34h6M50 34h6"/><path d="M22 36a10 10 0 1 1 20 0c0 4-3 6-4 9H26c-1-3-4-5-4-9Z"/><path d="M27 51h10"/>
    {%- when 'jets' -%}
      <circle cx="14" cy="32" r="5"/><path d="M22 28c8-3 18-3 30-8M22 32h32M22 36c8 3 18 3 30 8"/>
    {%- when 'zones' -%}
      <rect x="8" y="14" width="48" height="36" rx="8"/><path d="M32 14v36"/><circle cx="20" cy="32" r="4"/><path d="M40 38c2-4 4-8 8-12M44 40c2-3 3-5 6-7"/>
    {%- when 'floor' -%}
      <ellipse cx="32" cy="40" rx="24" ry="10"/><path d="M8 40V26M56 40V26"/><ellipse cx="32" cy="26" rx="24" ry="10"/><path d="M26 40h12M32 34v12"/>
    {%- when 'heat' -%}
      <path d="M22 50c-6-8 2-12 0-20M32 50c-6-8 2-12 0-20M42 50c-6-8 2-12 0-20"/><path d="M14 54h36"/><path d="M32 10v8M26 14h12"/>
    {%- when 'filter' -%}
      <rect x="20" y="10" width="24" height="44" rx="6"/><path d="M20 20h24M20 44h24M26 20v24M32 20v24M38 20v24"/>
    {%- when 'plug' -%}
      <rect x="18" y="20" width="28" height="22" rx="4"/><path d="M26 20v-8M38 20v-8M32 42v12"/><path d="M26 30h12"/>
    {%- when 'quiet' -%}
      <path d="M12 26h8l10-8v28l-10-8h-8Z"/><path d="M40 26c3 3 3 9 0 12"/><path d="M46 20c7 6 7 18 0 24" opacity=".4"/>
    {%- when 'foam' -%}
      <rect x="10" y="12" width="44" height="40" rx="4"/><path d="M22 12v40M42 12v40"/><circle cx="16" cy="22" r="1.4"/><circle cx="16" cy="32" r="1.4"/><circle cx="16" cy="42" r="1.4"/><circle cx="48" cy="26" r="1.4"/><circle cx="48" cy="38" r="1.4"/>
    {%- when 'truck' -%}
      <path d="M6 18h32v24H6zM38 26h10l8 8v8H38z"/><circle cx="16" cy="46" r="4"/><circle cx="46" cy="46" r="4"/>
    {%- when 'shield' -%}
      <path d="M32 8l20 8v14c0 12-8 20-20 26-12-6-20-14-20-26V16Z"/><path d="M24 32l6 6 11-12"/>
    {%- when 'chat' -%}
      <path d="M10 16h36v24H24l-10 8v-8h-4Z"/><path d="M20 26h16M20 32h10"/>
    {%- when 'card' -%}
      <rect x="8" y="16" width="48" height="32" rx="5"/><path d="M8 26h48M16 38h10"/>
    {%- when 'cube' -%}
      <path d="M32 8l22 12v24L32 56 10 44V20Z"/><path d="M10 20l22 12 22-12M32 32v24"/>
    {%- when 'check' -%}
      <path d="M12 34l12 12 28-28"/>
    {%- else -%}
      <circle cx="32" cy="32" r="20"/>
  {%- endcase -%}
</svg>
