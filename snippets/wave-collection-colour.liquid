{%- doc -%}
  Brings the FY27 collection colour (Wave Lite / Lush / Luxe) into the PDP, after the FY27 catalogue pages.
  Sets --wf-tier / --wf-tier-ink / --wf-tier-rgb on the page and uses them for: the collection icon to the
  left of the title, and the collection word in the title ("Garda Lush"); the Product Highlights as a white
  card with icons in the collection colour; the variant picker's selections, step numbers and ticks; the
  FY27 sections' accent (eyebrows, setup ring and step numbers, question tags); the buy button; and the
  Compatible accessories tabs.
  The hot / cold / air diagram colours and the dark FY27 sections keep their own colours. Theme section
  subtitles take --wf-tier-ink in wave-fy27-pdp-layout.

  The collection comes from the product's Lite / Lush / Luxe tag, else its handle (lite-…, lush-…, luxe-…).
  Renders nothing for other products. --wf-tier-ink (and --wf-tier-rgb-ink) is the text-safe shade (Lite's
  slate is too light for small or white text on white); the buy button uses it.

  @param {object} product - Product being viewed
{%- enddoc -%}
{%- liquid
  assign tier = blank
  if product.tags contains 'Lite'
    assign tier = 'lite'
  elsif product.tags contains 'Lush'
    assign tier = 'lush'
  elsif product.tags contains 'Luxe'
    assign tier = 'luxe'
  else
    assign handle_start = product.handle | split: '-' | first
    if handle_start == 'lite' or handle_start == 'lush' or handle_start == 'luxe'
      assign tier = handle_start
    endif
  endif

  case tier
    when 'lite'
      assign collection_name = 'Lite'
      assign collection_colour = '#728BA3'
      assign collection_ink = '#61768B'
      assign collection_rgb = '114 139 163'
      assign collection_ink_rgb = '97 118 139'
      assign icon_filter = 'brightness(0) saturate(100%) invert(42%) sepia(88%) saturate(218%) hue-rotate(167deg) brightness(112%) contrast(48%)'
    when 'lush'
      assign collection_name = 'Lush'
      assign collection_colour = '#9F3C1E'
      assign collection_ink = '#9F3C1E'
      assign collection_rgb = '159 60 30'
      assign collection_ink_rgb = '159 60 30'
      assign icon_filter = 'brightness(0) saturate(100%) invert(51%) sepia(78%) saturate(9062%) hue-rotate(17deg) brightness(75%) contrast(77%)'
    when 'luxe'
      assign collection_name = 'Luxe'
      assign collection_colour = '#56223B'
      assign collection_ink = '#56223B'
      assign collection_rgb = '86 34 59'
      assign collection_ink_rgb = '86 34 59'
      assign icon_filter = 'brightness(0) saturate(100%) invert(12%) sepia(45%) saturate(4031%) hue-rotate(-49deg) brightness(65%) contrast(80%)'
  endcase
-%}
{%- if tier != blank -%}
  {%- assign title_last_word = product.title | split: ' | ' | first | strip | split: ' ' | last -%}
  <style>
    :root {
      --wf-tier: {{ collection_colour }};
      --wf-tier-ink: {{ collection_ink }};
      --wf-tier-rgb: {{ collection_rgb }};
      --wf-tier-rgb-ink: {{ collection_ink_rgb }};
    }

    /* FY27 sections: collection colour as the accent */
    :root .wf:not(.wf--dark) {
      --wf-accent: var(--wf-tier);
      --wf-accent-ink: var(--wf-tier-ink);
    }
    :root .wf .wf-su__steps li::before {
      background: var(--wf-tier-ink);
    }

    /* Collection icon to the left of the title */
    .product__info .product__title > .heading {
      display: flex;
      align-items: center;
      gap: 0.3em;
    }
    .product__info .product__title > .heading::before {
      content: '';
      flex: none;
      width: 0.9em;
      height: 0.9em;
      border-radius: 0.16em;
      background: var(--wf-tier) url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' fill='none' stroke='white' stroke-width='3' stroke-linecap='round'><defs><clipPath id='c'><circle cx='24' cy='24' r='18'/></clipPath></defs><path d='M3.33 16.48A22 22 0 0 1 44.67 16.48M44.67 31.52A22 22 0 0 1 3.33 31.52'/><g clip-path='url(%23c)' stroke-width='2.6'><path d='M0 15q4-3 8 0t8 0 8 0 8 0 8 0 8 0'/><path d='M0 21q4-3 8 0t8 0 8 0 8 0 8 0 8 0'/><path d='M0 27q4-3 8 0t8 0 8 0 8 0 8 0 8 0'/><path d='M0 33q4-3 8 0t8 0 8 0 8 0 8 0 8 0'/></g></svg>") center / 70% no-repeat;
    }

    /* Product Highlights: white catalogue card, icons in the collection colour */
    .product .product__highlights.with-heading {
      border: 1px solid rgb(var(--color-foreground) / 0.1);
      background-color: rgb(var(--color-background));
    }
    .product .product__highlights.with-heading > p {
      position: static;
      padding: 0;
      transform: none;
      background: none;
      font-weight: var(--font-heading-weight);
    }
    .product .product__highlights.with-heading .product-card__icons {
      gap: var(--sp-5) 0;
    }
    .product .product__highlights.with-heading .product-card__icon {
      padding: 0 var(--sp-5);
      border-radius: 0;
      border-inline-start: 1px solid rgb(var(--color-foreground) / 0.1);
      background: none;
    }
    .product .product__highlights.with-heading .product-card__icon:first-child {
      padding-inline-start: 0;
      border-inline-start: 0;
    }
    .product .product__highlights.with-heading .product-card__icon figure {
      width: var(--sp-6);
    }
    .product .product__highlights.with-heading .product-card__icon img {
      filter: {{ icon_filter }};
    }
    @media screen and (min-width: 1024px) {
      .product .product__gallery-container .product__highlights.with-heading .product-card__icons {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      .product .product__gallery-container .product__highlights.with-heading .product-card__icon:nth-child(3n + 1) {
        padding-inline-start: 0;
        border-inline-start: 0;
      }
    }

    /* Buy button (also the sticky one) in the collection colour */
    .product__info .product-form__submit.button--primary {
      --color-button-background: var(--wf-tier-rgb-ink);
      --color-button-border: var(--wf-tier-rgb-ink);
      --color-button-text: 255 255 255;
      transition: background-color 0.3s;
    }
    .product__info .product-form__submit.button--primary:not([disabled]):is(:hover, :focus-visible) {
      color: #fff;
      background-color: color-mix(in srgb, rgb(var(--wf-tier-rgb-ink)) 82%, #000);
    }

    /* Compatible accessories tabs: selected tab in the collection colour, the rest tinted */
    .shopify-section:has([id^='CompatV2Tabs-']) .tab__item {
      transition: background-color 0.3s, color 0.3s;
    }
    .shopify-section:has([id^='CompatV2Tabs-']) .tab__item[aria-selected='true'] {
      --color-button-background: var(--wf-tier-rgb-ink);
      --color-button-border: var(--wf-tier-rgb-ink);
      --color-button-text: 255 255 255;
      opacity: 1;
    }
    .shopify-section:has([id^='CompatV2Tabs-']) .tab__item[aria-selected='false'] {
      background-color: rgb(var(--wf-tier-rgb) / 0.08);
    }
    .shopify-section:has([id^='CompatV2Tabs-']) .tab__item[aria-selected='false']:is(:hover, :focus-visible) {
      background-color: rgb(var(--wf-tier-rgb) / 0.16);
    }

    /* Variant picker: selections, step numbers and ticks */
    .product .vpa {
      --vpa-accent: var(--wf-tier-ink);
      --vpa-accent-soft: rgb(var(--wf-tier-rgb) / 0.1);
      --vpa-border-selected: var(--wf-tier);
      --vpa-surface-selected: rgb(var(--wf-tier-rgb) / 0.05);
      --vpa-border-strong: var(--wf-tier);
    }
    .product .vpa__step--complete .vpa__num {
      border-color: var(--wf-tier);
      background: var(--wf-tier);
      color: #fff;
    }
    {%- if title_last_word == collection_name %}
      .product__info .product__title split-words > .word:last-child { color: var(--wf-tier); }
    {%- endif %}
  </style>
{%- endif -%}
