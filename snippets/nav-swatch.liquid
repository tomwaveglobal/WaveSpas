{%- doc -%}
  Renders a colour swatch for a mega menu tab.

  Prefers Shopify's own swatch (the one Search & Discovery and the PDP draw from)
  when the merchant has populated it, and otherwise resolves the colour through
  the same `settings.swatch_config` mapping the product pages use, so a nav swatch
  is the identical texture or colour a customer sees on the PDP. Falls back to the
  tab's own colour picker when the name is blank or unmapped.

  Reuses the theme's `.color-swatch` styling (`--swatch-background`,
  `--swatch-background-image`); only the size and radius are overridden, via
  `.mega-menu__nav-swatch`.

  @param {object} [swatch] - A native Shopify swatch, e.g. `filter_value.swatch`. Wins over `name`.
  @param {string} [name] - Colour name to look up, e.g. "Charcoal Black"
  @param {string} [fallback] - Colour value used when name is blank or unmapped

  @example
  {% render 'nav-swatch', name: 'Charcoal Black', fallback: '#1c1c1c' %}
  {% render 'nav-swatch', swatch: filter_value.swatch, name: filter_value.label %}
{%- enddoc -%}

{%- liquid
  assign swatch_background = fallback | default: 'transparent'
  assign swatch_image = blank
  assign mapped_image = blank
  assign mapped_color = blank

  # Resolution order, most specific first: a texture the merchant mapped in
  # Theme settings > Swatches, then that mapping's colour, then whatever Shopify
  # holds on the swatch itself, then a guess from the last word of the name.
  # An explicit theme mapping is a deliberate choice, so it outranks the flat
  # taxonomy colour — three greys all sitting on #808080 is a real case here.
  if name != blank
    assign file_name = name | handle | append: '.png'

    if settings.swatch_config != blank
      assign name_downcase = name | downcase | strip
      assign swatch_config = settings.swatch_config | newline_to_br | split: '<br />'
      for swatch_line in swatch_config
        assign swatch_parts = swatch_line | strip | split: ':'
        assign swatch_name = swatch_parts.first | downcase | strip
        if swatch_name == name_downcase
          assign swatch_value = swatch_parts.last | strip
          if swatch_value contains '#'
            assign mapped_color = swatch_value
          else
            assign file_name = swatch_value
          endif
          break
        endif
      endfor
    endif

    if images[file_name] != blank
      assign mapped_image = images[file_name] | image_url: width: 128
    elsif file_name contains '//cdn.shopify.com/'
      assign mapped_image = file_name
    endif
  endif

  if mapped_image != blank
    assign swatch_image = mapped_image
  elsif swatch.image != blank
    assign swatch_image = swatch.image | image_url: width: 128
  endif

  if swatch_image == blank
    if mapped_color != blank
      assign swatch_background = mapped_color
    elsif swatch.color != blank
      assign swatch_background = swatch.color
    elsif name != blank
      assign swatch_background = name | split: ' ' | last | handle
    endif
  endif
-%}

{%- comment -%}
  `relative` matters: .color-swatch's ::before/::after are absolutely
  positioned, so without it they resolve against the nav item and smear a ring
  across the whole row.
{%- endcomment -%}
<span class="mega-menu__nav-swatch color-swatch{% if swatch_image != blank %} with-image{% endif %} block relative shrink-0" style="--swatch-background: {{ swatch_background }};{% if swatch_image != blank %}--swatch-background-image: url({{ swatch_image }});{% endif %}"></span>
