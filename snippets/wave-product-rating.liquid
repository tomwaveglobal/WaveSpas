{%- doc -%}
  Star rating row under the PDP title: five amber stars (partly filled for the average), the average
  ("4.9"), a hairline divider and the review count ("364 reviews"). Links to the Reviews section.
  Reads this product's stats from the public REVIEWS.io API by variant SKU, the same source as the
  reviews.io rating snippet it replaces. With no reviews it shows empty stars and "No reviews yet".
  Keeps its height while loading so the page doesn't jump, and collapses if the API fails.

  @param {object} product - Product being viewed
  @param {string} [section_id] - The calling section's ID (section.id), needed with target
  @param {string} [target] - Section key to link to (e.g. 'rich_text_XazzCf'); its section must be on the same template
  @param {string} [store] - REVIEWS.io store ID, defaults to wave-spas

  @example
  {% render 'wave-product-rating', product: product, section_id: section.id, target: 'rich_text_XazzCf' %}
{%- enddoc -%}
{%- liquid
  assign skus = product.variants | map: 'sku' | compact | uniq | join: ';'
  assign href = '#'
  if target != blank and section_id != blank
    assign href = section_id | split: '__' | first | append: '__' | append: target | prepend: '#shopify-section-'
  endif
-%}
{%- capture star -%}
  <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 1.2l2.7 5.5 6 .9-4.35 4.25 1.03 6-5.38-2.83-5.38 2.83 1.03-6L1.3 7.6l6-.9z"/></svg>
{%- endcapture -%}
{%- if skus != blank -%}
  <wave-product-rating class="wpr" data-store="{{ store | default: 'wave-spas' | escape }}" data-skus="{{ skus | escape }}">
    <a class="wpr__link" href="{{ href }}">
      <span class="wpr__stars" aria-hidden="true">
        <span class="wpr__row wpr__row--empty">{% for i in (1..5) %}{{ star }}{% endfor %}</span>
        <span class="wpr__row wpr__row--full" data-wpr-fill>{% for i in (1..5) %}{{ star }}{% endfor %}</span>
      </span>
      <span class="wpr__average" data-wpr-average></span>
      <span class="wpr__count" data-wpr-count></span>
    </a>
  </wave-product-rating>
  <style>
    .wpr { display: block; margin-block: 0.5rem 0.25rem; min-height: 1.5rem; visibility: hidden; }
    .wpr.is-ready { visibility: visible; }
    .wpr[hidden] { display: none; }
    .wpr .wpr__link { display: inline-flex; align-items: center; gap: 0.75rem; color: rgb(var(--color-foreground)); text-decoration: none; line-height: 1; }
    /* the liquid block wraps this in .rte, whose links get an underline background */
    .wpr .wpr__link { background-image: none !important; }
    .wpr .wpr__link * { text-decoration: none; }
    .wpr__stars { position: relative; display: inline-block; flex: none; }
    .wpr__row { display: flex; gap: 0.125rem; }
    .wpr__row svg { display: block; flex: none; width: 1.375rem; height: 1.375rem; }
    .wpr__row--empty svg { fill: rgb(var(--color-foreground) / 0.12); }
    .wpr__row--full { position: absolute; inset: 0 auto 0 0; width: 0; overflow: hidden; }
    .wpr__row--full svg { fill: #f59e0b; }
    .wpr__average { font-size: 1.0625rem; font-variant-numeric: tabular-nums; }
    .wpr__average:empty { display: none; }
    .wpr__count { padding-inline-start: 0.75rem; border-inline-start: 1px solid rgb(var(--color-foreground) / 0.15); font-size: 1.0625rem; }
    .wpr__average:empty + .wpr__count { padding-inline-start: 0; border: 0; }
    .wpr .wpr__link:is(:hover, :focus-visible) .wpr__count { text-decoration: underline; text-underline-offset: 0.2em; }
    @media screen and (max-width: 767px) {
      .wpr__link { gap: 0.6rem; }
      .wpr__row svg { width: 1.125rem; height: 1.125rem; }
      .wpr__average, .wpr__count { font-size: 0.9375rem; }
      .wpr__count { padding-inline-start: 0.6rem; }
    }
  </style>
  <script>
    if (!customElements.get('wave-product-rating')) {
      customElements.define('wave-product-rating', class extends HTMLElement {
        connectedCallback() {
          const url = new URL('https://api.reviews.io/product/review');
          url.searchParams.set('store', this.dataset.store);
          url.searchParams.set('sku', this.dataset.skus);
          url.searchParams.set('per_page', 1);
          url.searchParams.set('page', 0);
          fetch(url)
            .then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
            .then((data) => this.render((data && data.stats) || {}))
            .catch(() => { this.hidden = true; });
          const link = this.querySelector('.wpr__link');
          link.addEventListener('click', (event) => {
            const target = link.hash.length > 1 && document.getElementById(link.hash.slice(1));
            if (!target) return;
            event.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        }
        render(stats) {
          const count = Number(stats.count) || 0;
          const average = Math.min(5, Math.max(0, Number(stats.average) || 0));
          const label = this.querySelector('.wpr__link');
          if (count > 0) {
            this.querySelector('[data-wpr-fill]').style.width = (average / 5) * 100 + '%';
            this.querySelector('[data-wpr-average]').textContent = average.toFixed(1);
            this.querySelector('[data-wpr-count]').textContent = count.toLocaleString('en-GB') + (count === 1 ? ' review' : ' reviews');
            label.setAttribute('aria-label', 'Rated ' + average.toFixed(1) + ' out of 5 from ' + count + (count === 1 ? ' review' : ' reviews'));
          } else {
            this.querySelector('[data-wpr-count]').textContent = 'No reviews yet';
          }
          this.classList.add('is-ready');
        }
      });
    }
  </script>
{%- endif -%}
