{%- doc -%}
  Stepped/guided variant picker (Colour → Size → Edition → Add-Ons).

  Step display order is derived from option name ("colour"/"size"/
  "edition|bundle|version") regardless of Shopify's option positions.
  Numbered badges (1/2/3/4) follow display order. All earlier steps stay
  interactive — changing an earlier step (e.g. colour) re-resolves the
  variant live AND resets the later steps, so a previously-picked size or
  edition that doesn't exist for the new colour can't leave the picker stuck
  on an unavailable combination.

  Feature summary
  ---------------
  • Variant-level Most Popular pill — gated on the resolved variant's
    inventory > most_popular_min_stock.
  • Sold Out treatment on every tile step, evaluated at the variant the tile
    resolves to under the current selection (so a size that's sold out in the
    chosen colour is badged even when another colour still has it). Colours
    are struck through only when every one of their variants is unsellable,
    and stay clickable so availability keeps cascading.
  • Edition tiles prefixed with the resolved size ("6 Person Standard"),
    everything after the first "|" stripped. Toggle in admin.
  • Per-tile pre-order chip from variant.metafields.custom.
    pre_order_date_{uk|eu|usa}, market-aware.
  • Auto-shown Energy-Saving Bundle blurb when the value name contains
    "energy"/"saving"/"eco". Copy editable in admin.
  • Step 4 (Add-Ons) hidden until all earlier steps are picked, then
    fades in. Reads product.metafields.custom.popular_upgrades.
  • Add-on variant resolution: explicit SKU map → SKU-prefix match →
    keyword/title match fallback.
  • Add-on visibility is per stock state (in-stock / pre-order / out-of-stock),
    each an admin checkbox. Pre-order is detected from the market-aware
    metafield, which wins over `available`. A revealed out-of-stock row is
    struck through and unselectable.
  • Subscriptions: per-row delivery-frequency selector when the add-on
    has selling_plan_groups. Subscription pre-selected by default.
  • Cart submit: capture-phase click intercept on the host form, routes
    through /cart/add.js sequentially (reliable with selling plans).

  @param {object} product
  @param {object} block - The main-product variant_picker_advanced block
  @param {string} product_form_id - host form id (so we can update its `id` input)
  @param {string} product_id
  @param {string} section_id
{%- enddoc -%}

{%- liquid
  # ─── Market-aware pre-order metafield key ───────────────────────────
  case localization.market.metafields.country.code
    when 'UK'
      assign pre_order_key = 'pre_order_date_uk'
    when 'EU'
      assign pre_order_key = 'pre_order_date_eu'
    when 'US'
      assign pre_order_key = 'pre_order_date_usa'
    else
      assign pre_order_key = 'pre_order_date_uk'
  endcase

  # ─── Derived values ────────────────────────────────────────────────
  assign vpa_id = 'vpa-' | append: section_id | append: '-' | append: product_id
  assign popular_upgrades = product.metafields.custom.popular_upgrades.value
  assign addons_enabled = block.settings.addons_enabled
  if popular_upgrades == blank
    assign addons_enabled = false
  endif
  assign size_chart = block.settings.size_chart
  assign most_popular_min_stock = block.settings.most_popular_min_stock | default: 0
  assign prefix_edition_with_size = block.settings.prefix_edition_with_size

  # ─── Badge colours (theme settings) ────────────────────────────────
  # Emitted as custom properties on the picker root ONLY when the merchant
  # actually picked a colour. A blank setting emits nothing, so the CSS
  # fallback — the value the badge had before these settings existed —
  # applies and stays adaptive to the section colour scheme. Shopify
  # renders an unset colour as blank or as the fully-transparent
  # rgba(0,0,0,0), so both are treated as "not set".
  assign vpa_badge_css = ''
  assign badge_ids = 'bs_bg,bs_text,so_bg,so_text,disc_bg,disc_text,chip_bg,chip_text' | split: ','
  for badge_id in badge_ids
    assign setting_key = 'vpa_badge_' | append: badge_id
    assign badge_value = settings[setting_key] | default: '' | append: ''
    if badge_value != '' and badge_value != 'rgba(0,0,0,0)'
      assign css_name = badge_id | replace: '_', '-'
      assign vpa_badge_css = vpa_badge_css | append: '--vpa-badge-' | append: css_name | append: ': ' | append: badge_value | append: '; '
    endif
  endfor

  # ─── Size option position ──────────────────────────────────────────
  # Resolved up front because the Edition step renders BEFORE Size in
  # Shopify's option order on some products (Pacific is Colour / Edition /
  # Size), so the step loop can't discover it lazily. 0 = product has no
  # size option, in which case edition tiles keep their bare names.
  assign size_option_pos = 0
  for _opt in product.options_with_values
    assign _opt_name = _opt.name | downcase
    if _opt_name contains 'size'
      assign size_option_pos = forloop.index
      break
    endif
  endfor

  # ─── Per-element font-size scale mappings ──────────────────────────
  # Theme-level settings (config/settings_schema.json → "Variant picker
  # (advanced)") give the merchant XS/S/M/L/XL labels per element.
  # Translate to a numeric multiplier applied via calc() in the CSS.
  assign vpa_step_s = '1'
  case settings.vpa_step_size
    when 'xs'
    when 's'
    when 'l'
    when 'xl'
  endcase
  assign vpa_name_s = '1'
  case settings.vpa_name_size
    when 'xs'
    when 's'
    when 'l'
    when 'xl'
  endcase
  assign vpa_price_s = '1'
  case settings.vpa_price_size
    when 'xs'
    when 's'
    when 'l'
    when 'xl'
  endcase

  assign vpa_step_w  = settings.vpa_step_weight  | default: '700'
  assign vpa_name_w  = settings.vpa_name_weight  | default: '700'
  assign vpa_price_w = settings.vpa_price_weight | default: '700'
  assign vpa_tag_w   = settings.vpa_tag_weight   | default: '700'
-%}

{%- unless product.has_only_default_variant -%}

{{ 'product-variant-picker-advanced.css' | asset_url | stylesheet_tag }}

<div class="vpa"
  id="{{ vpa_id }}"
  data-vpa-root
  data-vpa-size="{{ settings.vpa_size | default: 's' }}"
  data-vpa-visual="{{ settings.vpa_style | default: 'card' }}"
  data-vpa-selected-bg="{% if settings.vpa_selected_bg == false %}off{% else %}on{% endif %}"
  data-vpa-color-layout="{{ block.settings.colour_layout | default: 'wrap' }}"
  data-vpa-color-label="{{ block.settings.colour_label | default: 'always' }}"
  {%- if template.suffix == 'product-flow' or template.suffix == 'product-flow-new' or template.suffix == 'product-new-fy27' or template.suffix == 'product-new-inflatables' or template.suffix == 'product-sauna-fy27' %} data-vpa-swatch-shape="rounded-square"{% endif %}
  style="--vpa-step-w: {{ vpa_step_w }}; --vpa-name-w: {{ vpa_name_w }}; --vpa-price-w: {{ vpa_price_w }}; --vpa-tag-w: {{ vpa_tag_w }}; --vpa-step-s: {{ vpa_step_s }}; --vpa-name-s: {{ vpa_name_s }}; --vpa-price-s: {{ vpa_price_s }}; padding-block-end: {{ settings.vpa_bottom_padding | default: 0 }}px; {{ vpa_badge_css }}"
  data-form-id="{{ product_form_id }}"
  data-dynamic="{{ block.settings.enable_dynamic_variants }}"
  data-product-title="{{ product.title | escape }}"
  data-product-handle="{{ product.handle }}"
  data-product-url="{{ product.url }}"
  data-section-id="{{ section_id }}"
  {{ block.shopify_attributes }}
>
  {%- comment -%}
    ═══ Step rendering loop ════════════════════════════════════════
    Iterates through product.options_with_values. Each option gets a
    fieldset with a CSS `order` value derived from its name (colour=1,
    size=2, edition=3, anything else=10+). JS uses the same data
    attributes to renumber badges 1..N in display order.
  {%- endcomment -%}
  {%- for option in product.options_with_values -%}
    {%- liquid
      assign option_pos = forloop.index
      assign name_lower = option.name | downcase
      assign is_color = false
      assign is_size = false
      assign is_edition = false

      if name_lower contains 'color' or name_lower contains 'colour'
        assign display_order = 1
        assign is_color = true
        assign step_label = block.settings.step1_label | default: 'Pick your colour'
      elsif name_lower contains 'size'
        assign display_order = 2
        assign is_size = true
        assign step_label = block.settings.step2_label | default: 'Pick your size'
      elsif name_lower contains 'edition' or name_lower contains 'bundle' or name_lower contains 'version'
        assign display_order = 3
        assign is_edition = true
        assign step_label = block.settings.step3_label | default: 'Pick your edition'
      else
        assign display_order = option_pos | plus: 10
        assign step_label = 'Pick your ' | append: option.name | downcase
      endif

      assign render_swatches = block.settings.enable_color_swatches
    -%}

    {%- comment -%} Hide the colour step entirely if disabled via setting. {%- endcomment -%}
    {%- if is_color and block.settings.show_colour_buttons == false -%}{%- continue -%}{%- endif -%}

    <fieldset
      class="vpa__step{% if display_order > 1 %} vpa__step--locked{% endif %}"
      style="order: {{ display_order }};"
      data-step-num="{{ display_order }}"
      data-option-position="{{ option_pos }}"
      data-option-name="{{ option.name | escape }}"
      data-is-size="{{ is_size }}"
      data-is-color="{{ is_color }}"
    >
      <legend class="sr-only">{{ step_label | escape }}</legend>
      <div class="vpa__head">
        <span class="vpa__num" data-num-label>{{ display_order }}</span>
        <span class="vpa__title">{{ step_label }}</span>
        <span class="vpa__status" data-status></span>
        {%- if is_size and size_chart != blank -%}
          <button type="button" class="vpa__size-chart-link" aria-controls="SizeChart-{{ vpa_id }}" aria-expanded="false">
            {%- render 'icon', icon: 'ruler', size: 'xs', class: 'stroke-1' -%}
            {{ 'products.general.size_chart' | t }}
          </button>
        {%- endif -%}
      </div>

      <div class="vpa__choices vpa__choices--{% if is_color and render_swatches %}swatch{% elsif is_color %}text{% else %}tile{% endif %}">
        {%- for value in option.values -%}
          {%- liquid
            assign value_string = value | default: value.name
            # Find all variants for this option value
            assign all_for_value = nil
            case option_pos
              when 1
                assign all_for_value = product.variants | where: 'option1', value_string
              when 2
                assign all_for_value = product.variants | where: 'option2', value_string
              when 3
                assign all_for_value = product.variants | where: 'option3', value_string
            endcase

            # Resolve rep_variant against `product.selected_or_first_available_variant`
            # so the OTHER options match the URL-selected variant — not just the
            # first variant in product order. Without this, every tile after the
            # first option showed the colour-1 price (e.g. the EnergySave Bundle
            # tile rendered Charcoal Black's price even when the URL pointed at
            # a Pebble White variant). When the section is re-rendered via the
            # section-rendering API with the new option_values, the resolver
            # naturally picks the right variant for the new selection too.
            # `| money` is already Markets / B2B-catalog-aware, so this single
            # change makes ALL tile prices respect the active price list.
            # Normalise (strip + downcase) so subtle merchant-data
            # inconsistencies (e.g. one variant stores "Pebble White" and
            # another stores "Pebble White " or "pebble white") don't make
            # the resolver silently fall back to the wrong colour. Same
            # reason JS does normOpt on its side.
            assign cv = product.selected_or_first_available_variant
            assign cv_o1 = cv.option1 | default: '' | strip | downcase
            assign cv_o2 = cv.option2 | default: '' | strip | downcase
            assign cv_o3 = cv.option3 | default: '' | strip | downcase
            assign rep_variant = nil
            for _v in all_for_value
              assign _ok = true
              if option_pos != 1
                assign _v_o1 = _v.option1 | default: '' | strip | downcase
                if _v_o1 != cv_o1
                  assign _ok = false
                endif
              endif
              if option_pos != 2
                assign _v_o2 = _v.option2 | default: '' | strip | downcase
                if _v_o2 != cv_o2
                  assign _ok = false
                endif
              endif
              if option_pos != 3
                assign _v_o3 = _v.option3 | default: '' | strip | downcase
                if _v_o3 != cv_o3
                  assign _ok = false
                endif
              endif
              if _ok
                assign rep_variant = _v
                break
              endif
            endfor
            if rep_variant == nil
              # Fallback for variant combinations that don't exist (e.g. an
              # unavailable colour × size pairing) — pick any variant for this
              # value so the tile still has a price to show.
              assign rep_variant = all_for_value | first
            endif

            # Tile media: only show a thumbnail if the variant has its own
            # dedicated image. Falling back to product.featured_image just
            # renders a tiny clone of the gallery hero in every tile, which
            # reads as placeholder. Blank rep_image → hide the media column.
            assign rep_image = blank
            if rep_variant.featured_image != blank
              assign rep_image = rep_variant.featured_image
            endif

            assign rep_pre_order = rep_variant.metafields.custom[pre_order_key]
            assign rep_tile_info = rep_variant.metafields.custom.tile_info
            assign rep_qty = rep_variant.inventory_quantity | default: 0
            assign value_handle = value_string | handle
            assign input_id = vpa_id | append: '-' | append: option_pos | append: '-' | append: value_handle

            assign rep_discount_pct = 0
            if rep_variant.compare_at_price > rep_variant.price
              assign rep_discount_pct = rep_variant.compare_at_price | minus: rep_variant.price | times: 100.0 | divided_by: rep_variant.compare_at_price | round
            endif

            # Option value is "unavailable" only if NO variant with this value
            # is available AND none have a pre-order metafield for the active market.
            assign value_has_available = false
            for v in all_for_value
              if v.available
                assign value_has_available = true
                break
              endif
              if v.metafields.custom[pre_order_key] != blank
                assign value_has_available = true
                break
              endif
            endfor
            assign value_unavailable = false
            unless value_has_available
              assign value_unavailable = true
            endunless

            # ─── Sold-out state ───────────────────────────────────────
            # Evaluated at rep_variant — the variant this tile resolves to
            # under the CURRENT selection — NOT `value_unavailable`, which
            # asks the much weaker question "is this value available in ANY
            # colour". That weaker test is why "4 Person" rendered
            # un-badged on a Navy landing: Navy/4 Person is sold out in both
            # editions, but Dark Grey/4 Person is in stock, so the value
            # counted as available. It also poisoned the colour-switch path,
            # because refreshSectionFromServer copies this server verdict
            # back over whatever the client had already worked out.
            # Pre-order dates count as sellable (pre-order colours use
            # inventory policy "continue" and read available:true at 0 stock,
            # but a pre-orderable variant is genuinely buyable).
            assign rep_sellable = false
            if rep_variant.available
              assign rep_sellable = true
            elsif rep_variant.metafields.custom[pre_order_key] != blank
              assign rep_sellable = true
            endif
            assign show_sold_out_treatment = false
            if rep_variant != nil and rep_sellable == false
              assign show_sold_out_treatment = true
            endif

            # Most Popular pill: server-side initial state; JS refines per-variant.
            assign show_most_popular = false
            if forloop.first and rep_sellable and block.settings.most_popular_label != blank and option.values.size > 1
              if rep_qty > most_popular_min_stock
                assign show_most_popular = true
              endif
            endif

            # ─── Edition tile name prefix ─────────────────────────────
            # Edition tiles read "6 Person Standard" rather than a bare
            # "Standard". The size comes off rep_variant — the variant this
            # tile resolves to under the current selection — with everything
            # from the first "|" onward dropped ("6 Person | 185x65cm" →
            # "6 Person"), since the dimensions already live on the Size
            # tile and repeating them here just crowds the row.
            assign size_prefix = ''
            if is_edition and prefix_edition_with_size and size_option_pos > 0
              assign rep_size_raw = ''
              case size_option_pos
                when 1
                  assign rep_size_raw = rep_variant.option1
                when 2
                  assign rep_size_raw = rep_variant.option2
                when 3
                  assign rep_size_raw = rep_variant.option3
              endcase
              if rep_size_raw != blank
                assign size_prefix = rep_size_raw | split: '|' | first | strip
              endif
            endif
            assign tile_display_name = value_string
            if size_prefix != ''
              assign tile_display_name = size_prefix | append: ' ' | append: value_string
            endif

            # ─── Discount badge wording ───────────────────────────────
            # Merchant-authored format string; {n} is the discount
            # percentage. No `default:` filter here on purpose — Shopify
            # already supplies the schema default when the key is absent, so
            # omitting it lets a deliberately-blank setting mean "hide",
            # consistent with the other badge labels.
            assign discount_text = ''
            if rep_discount_pct > 0 and block.settings.discount_label != blank
              assign discount_text = block.settings.discount_label | replace: '{n}', rep_discount_pct
            endif

            # Discount pill on a sold-out tile: stacked below Sold Out by
            # default, or suppressed entirely when the merchant would rather
            # the tile say only "Sold Out" (block setting).
            assign hide_discount = false
            if discount_text == ''
              assign hide_discount = true
            elsif show_sold_out_treatment and block.settings.sold_out_hide_discount
              assign hide_discount = true
            endif
          -%}

          {%- if is_color and render_swatches -%}
            {%- comment -%}
              ─── Colour swatch ──────────────────────────────────────
              Resolution order: value.swatch.image (modern Shopify) →
              settings.swatch_config (name:filename or name:#hex) →
              variant.featured_image (when color_swatch_type=variant).
            {%- endcomment -%}
            {%- liquid
              assign sw_image_url = ''
              assign sw_bg = ''
              if value.swatch.image
                assign sw_image_url = value.swatch.image | image_url: width: 128
              elsif value.swatch.color
                assign sw_bg = value.swatch.color
              endif
              if sw_image_url == '' and sw_bg == '' and settings.swatch_config != blank
                assign value_lower = value_string | downcase
                assign cfg_lines = settings.swatch_config | newline_to_br | split: '<br />'
                for line in cfg_lines
                  assign parts = line | strip | split: ':'
                  assign nm = parts.first | downcase | strip
                  if nm == value_lower
                    assign cfg_val = parts.last | strip
                    if cfg_val contains '#'
                      assign sw_bg = cfg_val
                    else
                      if images[cfg_val] != blank
                        assign sw_image_url = images[cfg_val] | image_url: width: 128
                      elsif cfg_val contains '//cdn.shopify.com/'
                        assign sw_image_url = cfg_val
                      endif
                    endif
                    break
                  endif
                endfor
              endif
              if block.settings.color_swatch_type == 'variant' and rep_image != blank
                assign sw_image_url = rep_image | image_url: width: 128
                assign sw_bg = ''
              endif
            -%}
            {%- comment -%}
              Colour swatches are always clickable — stock/availability
              cascades through the size + edition steps. A colour whose
              every variant is unsellable still gets marked (struck through)
              so a fully sold-out colour never reads as buyable;
              `value_unavailable` is exactly that test at option level.
            {%- endcomment -%}
            <label class="vpa__swatch{% if value_unavailable %} vpa__choice--sold-out{% endif %}" for="{{ input_id }}" title="{{ value_string | escape }}">
              <input type="radio" id="{{ input_id }}" name="vpa-{{ vpa_id }}-{{ option_pos }}" value="{{ value_string | escape }}" data-option-position="{{ option_pos }}" data-value="{{ value_string | escape }}" data-option-value="{{ value_string | escape }}" data-option-value-id="{{ value.id }}">
              <span class="vpa__swatch-fill" style="{% if sw_image_url != '' %}background-image: url('{{ sw_image_url }}');{% endif %}{% if sw_bg != '' %}background-color: {{ sw_bg }};{% else %}background-color: rgb(var(--color-foreground)/0.06);{% endif %}"></span>
              <span class="vpa__swatch-label">{{ value_string }}</span>
            </label>

          {%- elsif is_color -%}
            {%- comment -%} Colour text-button (when image swatches disabled) — always clickable too, marked when fully sold out. {%- endcomment -%}
            <label class="vpa__text-btn{% if value_unavailable %} vpa__choice--sold-out{% endif %}" for="{{ input_id }}">
              <input type="radio" id="{{ input_id }}" name="vpa-{{ vpa_id }}-{{ option_pos }}" value="{{ value_string | escape }}" data-option-position="{{ option_pos }}" data-value="{{ value_string | escape }}" data-option-value="{{ value_string | escape }}" data-option-value-id="{{ value.id }}">
              {{ value_string }}
            </label>

          {%- else -%}
            {%- comment -%}
              ─── Tile card (Size / Edition / other) ─────────────────
              Both Sold Out and Most Popular tags are rendered when
              applicable. Visibility comes from rep_variant initially,
              then JS refines per-variant on every selection change.
            {%- endcomment -%}
            <label
              class="vpa__tile{% if show_sold_out_treatment %} vpa__tile--sold-out{% endif %}"
              for="{{ input_id }}"
              data-tile-option-position="{{ option_pos }}"
              data-tile-value="{{ value_string | escape }}"
              data-tile-is-size="{% if is_size %}true{% else %}false{% endif %}"
              data-tile-is-first="{% if forloop.first %}true{% else %}false{% endif %}"
              {%- comment -%}
                Tells the JS to re-derive the "<size> <edition>" name whenever
                the size selection changes. data-tile-value stays the RAW
                option value ("Standard") — it's the variant-matching key, so
                the prefix must never be baked into it.
              {%- endcomment -%}
              data-tile-prefix-size="{% if is_edition and prefix_edition_with_size and size_option_pos > 0 %}true{% else %}false{% endif %}"
            >
              {%- comment -%}
                Emitted on EVERY tile step, not just Size. Gating the markup
                on `is_size` meant the Edition tiles had no [data-sold-out]
                element at all, so no amount of client-side work could ever
                badge an unbuyable edition.
              {%- endcomment -%}
              {%- if block.settings.sold_out_label != blank -%}
                <span class="vpa__tag vpa__tag--sold-out" data-sold-out{% unless show_sold_out_treatment %} hidden{% endunless %}>{{ block.settings.sold_out_label }}</span>
              {%- endif -%}
              {%- if forloop.first and block.settings.most_popular_label != blank and option.values.size > 1 -%}
                <span class="vpa__tag" data-most-popular{% unless show_most_popular %} hidden{% endunless %}>{{ block.settings.most_popular_label }}</span>
              {%- endif -%}
              {%- comment -%}
                Discount pill is always emitted (hidden when no discount)
                so refreshSectionFromServer can copy text + hidden state
                across by [data-tile-discount] selector — different
                colours can have different discount %.
              {%- endcomment -%}
              <span class="vpa__discount" data-tile-discount data-has-discount="{% if discount_text != '' %}true{% else %}false{% endif %}"{% if hide_discount %} hidden{% endif %}>{{ discount_text }}</span>
              <input type="radio" id="{{ input_id }}" name="vpa-{{ vpa_id }}-{{ option_pos }}" value="{{ value_string | escape }}" data-option-position="{{ option_pos }}" data-value="{{ value_string | escape }}" data-option-value="{{ value_string | escape }}" data-option-value-id="{{ value.id }}">
              <div class="vpa__tile-body{% if rep_image == blank %} vpa__tile-body--no-media{% endif %}">
                {%- if rep_image != blank -%}
                  <div class="vpa__tile-media">
                    {{ rep_image | image_url: width: 128 | image_tag:
                         loading: 'lazy',
                         widths: '48, 64, 96, 128, 192',
                         sizes: '64px',
                         width: 64,
                         height: 64,
                         alt: value_string
                    }}
                  </div>
                {%- endif -%}
                <div class="vpa__tile-text">
                  <div class="vpa__tile-name">{{ tile_display_name }}</div>
                  {%- if rep_variant -%}
                    {%- comment -%}
                      Tile prices are pure Liquid — Markets / B2B-catalog
                      adjustments come through `| money`. On selection
                      change, refreshSectionFromServer replaces the whole
                      `.vpa__tile-price` innerHTML from a fresh
                      section-render so the values stay in sync.
                    {%- endcomment -%}
                    <div class="vpa__tile-price">
                      <span>{{ rep_variant.price | money }}</span>
                      {%- if rep_variant.compare_at_price > rep_variant.price -%}
                        <del>{{ rep_variant.compare_at_price | money }}</del>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  {%- comment -%}
                    Pre-order chip — strip a leading "Pre Order"/"Pre-order" from
                    the metafield value so it doesn't double up with the chip prefix.
                  {%- endcomment -%}
                  {%- if block.settings.show_per_tile_chip -%}
                    {%- comment -%}
                      Apply the merchant's "Trim from metafield" patterns
                      (one per line). Each is removed from the metafield
                      value (everywhere it appears) so the prefix and the
                      cleaned date can be combined without duplicates.
                    {%- endcomment -%}
                    {%- assign cleaned_pre_order = rep_pre_order -%}
                    {%- assign _trim_lines = block.settings.pre_order_chip_trim | default: '' | newline_to_br | split: '<br />' -%}
                    {%- for _raw_pat in _trim_lines -%}
                      {%- assign _pat = _raw_pat | strip -%}
                      {%- if _pat != blank -%}
                        {%- assign cleaned_pre_order = cleaned_pre_order | replace: _pat, '' -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- assign cleaned_pre_order = cleaned_pre_order | strip -%}
                    <span class="vpa__chip" data-pre-order-chip{% if rep_pre_order == blank %} hidden{% endif %}>
                      {%- render 'icon', icon: 'calendar', size: 'xs', class: 'icon' -%}
                      <span class="vpa__chip-text" data-pre-order-chip-text>
                        {%- if rep_pre_order != blank -%}
                          {%- if block.settings.pre_order_chip_prefix != blank %}{{ block.settings.pre_order_chip_prefix }} {% endif -%}{{ cleaned_pre_order }}
                        {%- endif -%}
                      </span>
                    </span>
                  {%- endif -%}

                  {%- comment -%} Energy-Saving Bundle blurb (auto-shown on matching value names). {%- endcomment -%}
                  {%- liquid
                    assign value_lc = value_string | downcase
                    assign is_energy_value = false
                    if value_lc contains 'energy' or value_lc contains 'saving' or value_lc contains 'eco'
                      assign is_energy_value = true
                    endif
                  -%}
                  {%- if is_energy_value and block.settings.energy_saving_text != blank -%}
                    <span class="vpa__tile-info">{{ block.settings.energy_saving_text }}</span>
                  {%- elsif rep_tile_info != blank -%}
                    <span class="vpa__tile-info">{{ rep_tile_info }}</span>
                  {%- endif -%}
                </div>
              </div>
            </label>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </fieldset>
  {%- endfor -%}

  {%- comment -%}
    ═══ Step 4 — Add-Ons ═════════════════════════════════════════════
    Hidden until all earlier steps have a value (JS reveals via
    [data-revealed]). Add-on rows render in original metafield order;
    priority keywords push matching entries to the top via CSS `order`.
  {%- endcomment -%}
  {%- if addons_enabled -%}
    {%- liquid
      assign priority_kw_raw = block.settings.addon_priority_keywords | default: ''
      assign priority_keywords = priority_kw_raw | downcase | split: ','
    -%}
    <fieldset class="vpa__step vpa__step--addons" style="order: 50;" data-addons-step data-addon-text-size="{{ block.settings.addon_text_size | default: 'm' }}" aria-hidden="true">
      <div class="vpa__head">
        <span class="vpa__num" data-num-label>4</span>
        <span class="vpa__title">{{ block.settings.addons_heading | default: 'Popular Add-Ons' }}</span>
        <span class="vpa__status" data-status>{{ block.settings.addons_optional_label | default: 'Optional' }}</span>
      </div>
      <div class="vpa__addon-list">
        {%- for addon in popular_upgrades -%}
          {%- liquid
            assign addon_variant = addon.selected_or_first_available_variant
            assign addon_image = addon.featured_image
            assign addon_id = 'vpa-addon-' | append: vpa_id | append: '-' | append: forloop.index
            # `selling_plan_groups` includes pre-order / deferred-purchase
            # groups as well as true subscriptions. Only treat the add-on as
            # subscribable when at least one plan has recurring deliveries —
            # otherwise a Pre-Order plan would render under "Subscribe & Save".
            assign has_subs = false
            for group in addon.selling_plan_groups
              for plan in group.selling_plans
                if plan.recurring_deliveries
                  assign has_subs = true
                  break
                endif
              endfor
              if has_subs
                break
              endif
            endfor

            # Score against pin-to-top keywords. First matching keyword wins;
            # its position becomes the CSS order. Non-matches → order 99.
            assign addon_title_lc = addon.title | downcase
            assign sort_order = 99
            for kw in priority_keywords
              assign kw_trim = kw | strip
              if kw_trim != blank and addon_title_lc contains kw_trim
                assign sort_order = forloop.index
                break
              endif
            endfor
          -%}
          <label class="vpa__addon" for="{{ addon_id }}" style="order: {{ sort_order }};" data-addon-handle="{{ addon.handle }}">
            <input type="checkbox" id="{{ addon_id }}" class="vpa__addon-check" data-addon-variant-id="{{ addon_variant.id }}" data-addon-price="{{ addon_variant.price }}">
            <div class="vpa__addon-media" data-addon-media>
              {%- if addon_image != blank -%}
                {%- comment -%}
                  Eager-load add-on thumbnails. The add-ons step starts
                  collapsed (max-height: 0) and browsers treat lazy
                  images inside a collapsed parent as off-screen — so
                  they don't fetch until the step reveals, then all
                  fire at once and the user sees blank cards. Eager
                  loading fetches them as part of normal page load so
                  they're already there when the step opens.
                {%- endcomment -%}
                {{ addon_image | image_url: width: 96 | image_tag:
                     loading: 'eager',
                     fetchpriority: 'low',
                     widths: '48, 96, 144',
                     sizes: '48px',
                     width: 48,
                     height: 48,
                     alt: addon.title
                }}
              {%- endif -%}
            </div>
            <div class="vpa__addon-name-wrap">
              <span class="vpa__addon-name">{{ addon.title }}</span>
              {%- if addon.variants.size > 1 -%}
                <span class="vpa__addon-variant" data-addon-variant-label>{{ addon_variant.title }}</span>
              {%- endif -%}
              {%- comment -%}
                Both markers are always emitted (hidden by default) so the JS can
                fill them in by selector as the resolved variant changes — the
                add-on row's variant is re-matched on every spa selection.
              {%- endcomment -%}
              <span class="vpa__addon-status" data-addon-status hidden></span>
              <span class="vpa__addon-chip" data-addon-chip hidden></span>
            </div>
            <span class="vpa__addon-price" data-addon-price-display>{{ addon_variant.price | money }}</span>

            {%- if has_subs -%}
              {%- comment -%}
                Subscription panel — plans rendered first so the browser
                pre-selects a subscription by default; "one-time" sits at
                the bottom as an opt-out. Plan name is verbatim (merchants
                put the discount in the name in the subs app).
              {%- endcomment -%}
              <div class="vpa__addon-sub">
                <div class="vpa__addon-sub-head">
                  <span class="vpa__addon-sub-icon" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" role="presentation">
                      <path d="M14 8a6 6 0 1 1-1.76-4.24"/>
                      <path d="M14 2v3.5h-3.5"/>
                    </svg>
                  </span>
                  <span class="vpa__addon-sub-savings">{{ block.settings.subscribe_savings_label | default: 'Subscribe & Save' }}</span>
                </div>
                {%- if block.settings.subscribe_description != blank -%}
                  <div class="vpa__addon-sub-desc">{{ block.settings.subscribe_description }}</div>
                {%- endif -%}
                <select class="vpa__addon-plan" aria-label="Delivery frequency for {{ addon.title | escape }}">
                  {%- for group in addon.selling_plan_groups -%}
                    {%- for plan in group.selling_plans -%}
                      {%- if plan.recurring_deliveries -%}
                        <option value="{{ plan.id }}" data-selling-group="{{ group.id }}">{{ plan.name }}</option>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endfor -%}
                  <option value="">{{ block.settings.addon_onetime_label | default: 'No, thanks — one-time only' }}</option>
                </select>
              </div>
            {%- endif -%}
          </label>
        {%- endfor -%}
      </div>
    </fieldset>
  {%- endif -%}
</div>

{%- comment -%}
  Fresh pre-order data block. JS reads this on every page load (and on
  every Section Rendering API refetch) so chip text stays in sync with
  the metafield even when the page HTML is served from CDN cache.
{%- endcomment -%}
<script type="application/json" data-vpa-preorder-map="{{ vpa_id }}">
{
  {%- assign _emit = false -%}
  {%- for v in product.variants -%}
    {%- assign po = v.metafields.custom[pre_order_key] -%}
    {%- if po != blank -%}{%- if _emit %},{% endif -%}"{{ v.id }}": {{ po | json }}{%- assign _emit = true -%}{%- endif -%}
  {%- endfor -%}
}
</script>

{%- comment -%} ═══ Size-chart modal (matches the theme's existing pattern) ═══ {%- endcomment -%}
{%- if size_chart != blank -%}
  <x-modal id="SizeChart-{{ vpa_id }}" class="x-modal drawer z-30 fixed bottom-0 left-0 h-full w-full pointer-events-none" role="dialog" aria-modal="true" aria-label="{{ size_chart.title | escape }}" hidden>
    <overlay-element class="overlay fixed-modal invisible opacity-0 fixed bottom-0 left-0 w-full h-screen pointer-events-none" aria-controls="SizeChart-{{ vpa_id }}" aria-expanded="false"></overlay-element>
    <div class="drawer__inner z-10 absolute top-0 flex flex-col w-full h-full overflow-hidden">
      <gesture-element class="drawer__header flex justify-between opacity-0 invisible relative" tabindex="0">
        <span class="drawer__title heading title-md">{{ size_chart.title | escape }}</span>
        <button class="button button--secondary button--close drawer__close hidden sm:flex items-center justify-center" type="button" is="hover-button" aria-controls="SizeChart-{{ vpa_id }}" aria-expanded="false" aria-label="{{ 'general.accessibility.close' | t | escape }}">
          <span class="btn-fill" data-fill></span>
          <span class="btn-text">{%- render 'icon', icon: 'close', size: 'sm' -%}</span>
        </button>
      </gesture-element>
      <div class="drawer__content opacity-0 invisible flex flex-col h-full grow shrink">
        <div class="drawer__scrollable relative flex flex-col gap-5 md:gap-7 grow shrink">
          <div class="rte text-base md:text-lg">{{ size_chart.content }}</div>
        </div>
      </div>
    </div>
  </x-modal>
{%- endif -%}

<script src="{{ 'product-variant-picker-advanced.js' | asset_url }}" defer></script>
<script>
(window.WaveVPA = window.WaveVPA || []).push({
  id: {{ vpa_id | json }},
  optionCount: {{ product.options.size }},
  productId: '{{ product.id }}',
  chipPrefix: {{ block.settings.pre_order_chip_prefix | default: 'Pre-order · ships' | json }},
  chipTrimRaw: {{ block.settings.pre_order_chip_trim | default: '' | json }},
  moneyFormat: {{ shop.money_format | json }},
  skuPrefixLength: {{ block.settings.addon_match_sku_prefix_length | default: 4 }},
  skuMatchingEnabled: {{ block.settings.addon_match_by_sku_prefix | default: true }},
  mostPopularMinStock: {{ most_popular_min_stock | default: 0 }},
  soldOutHideDiscount: {% if block.settings.sold_out_hide_discount %}true{% else %}false{% endif %},
  addonsShowInStock: {% if block.settings.addons_show_in_stock == false %}false{% else %}true{% endif %},
  addonsShowPreOrder: {% if block.settings.addons_show_pre_order == false %}false{% else %}true{% endif %},
  addonsShowOOS: {% if block.settings.addons_show_out_of_stock %}true{% else %}false{% endif %},
  addonSoldOutLabel: {{ block.settings.addon_sold_out_label | default: 'Sold out' | json }},
  currentMainVariantId: {{ product.selected_or_first_available_variant.id }},
  addonSkuMatchMap: {{ block.settings.addon_sku_match_map | default: '' | json }},
  addonVariantMatchMap: {{ block.settings.addon_variant_match_map | default: '' | json }},
  variants: {{ product.variants | json }},
  preOrderByVariant: {
    {%- assign _emit = false -%}
    {%- for v in product.variants -%}
      {%- assign po = v.metafields.custom[pre_order_key] -%}
      {%- if po != blank -%}{%- if _emit %},{% endif -%}"{{ v.id }}": {{ po | json }}{%- assign _emit = true -%}{%- endif -%}
    {%- endfor -%}
  },
  variantImageUrl: {
    {%- assign _emit = false -%}
    {%- for v in product.variants -%}
      {%- if v.featured_image -%}{%- if _emit %},{% endif -%}"{{ v.id }}": {{ v.featured_image | image_url: width: 128 | json }}{%- assign _emit = true -%}{%- endif -%}
    {%- endfor -%}
  },
  inventoryByVariant: {
    {%- assign _emit = false -%}
    {%- for v in product.variants -%}
      {%- if _emit %},{% endif -%}"{{ v.id }}": {{ v.inventory_quantity | default: 0 }}{%- assign _emit = true -%}
    {%- endfor -%}
  },
  spaVariantSku: {
    {%- assign _emit = false -%}
    {%- for v in product.variants -%}
      {%- if _emit %},{% endif -%}"{{ v.id }}": {{ v.sku | default: '' | json }}{%- assign _emit = true -%}
    {%- endfor -%}
  },
  gangMediaByVariant: {
    {%- assign _emit = false -%}
    {%- for v in product.variants -%}
      {%- assign _gm = v.metafields.theme.gang_media.value -%}
      {%- if _gm and _gm.size > 0 -%}
        {%- if _emit %},{% endif -%}"{{ v.id }}": {{ _gm | first | json }}{%- assign _emit = true -%}
      {%- endif -%}
    {%- endfor -%}
  },
  addonVariants: {
    {%- assign _emit_a = false -%}
    {%- for addon in popular_upgrades -%}
      {%- if _emit_a %},{% endif -%}
      {{ addon.handle | json }}: [
        {%- assign _emit_v = false -%}
        {%- for v in addon.variants -%}
          {%- if _emit_v %},{% endif -%}
          {
            "id": {{ v.id }},
            "title": {{ v.title | json }},
            "sku": {{ v.sku | default: '' | json }},
            "price": {{ v.price }},
            "available": {{ v.available }},
            {%- comment -%}
              Market-aware pre-order date, same key the size tiles read. Without
              it a pre-orderable add-on is indistinguishable from an in-stock
              one: policy "continue" reports available:true at zero stock.
            {%- endcomment -%}
            "preOrder": {{ v.metafields.custom[pre_order_key] | default: '' | strip | json }},
            "image": {% if v.featured_image %}{{ v.featured_image | image_url: width: 96 | json }}{% else %}null{% endif %}
          }
          {%- assign _emit_v = true -%}
        {%- endfor -%}
      ]
      {%- assign _emit_a = true -%}
    {%- endfor -%}
  }
});
</script>
{%- endunless -%}
