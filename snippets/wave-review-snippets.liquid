{%- doc -%}
  Compact rotating review snippets for the product info column: one quote at a time, two lines at most, with the customer's name.
  Pulls this product's reviews from the public REVIEWS.io API (by variant SKU) and tops up with store reviews when there are too few.
  Shows 5-star reviews only, skips anonymous ones, and prefers short ones that fit in two lines. The rating is the average across all reviews, not only the ones shown.
  A progress bar times each review; it pauses on hover, off screen, in a background tab, or when paused. Stays hidden if nothing loads.

  @param {object} product - Product being viewed
  @param {string} [store] - REVIEWS.io store ID, defaults to wave-spas
{%- enddoc -%}
{{ 'wave-pdp.css' | asset_url | stylesheet_tag }}
{%- assign skus = product.variants | map: 'sku' | compact | uniq | join: ';' -%}
<wave-review-snippets class="wpdp wrs" hidden data-store="{{ store | default: 'wave-spas' | escape }}" data-skus="{{ skus | escape }}">
  <div class="wrs__head">
    <p class="wrs__title">What our customers are saying</p>
    <p class="wrs__score" data-wrs-rating hidden>
      <strong class="wrs__average" data-wrs-average></strong>
      <span class="wrs__stars" aria-hidden="true">★★★★★</span>
      <span class="wrs__total" data-wrs-total></span>
    </p>
  </div>

  <div class="wrs__slide">
    <p class="wrs__text" data-wrs-text></p>
    <div class="wrs__who">
      <span class="wrs__avatar" data-wrs-initials aria-hidden="true"></span>
      <span class="wrs__person">
        <span class="wrs__name" data-wrs-name></span>
        <span class="wrs__verified" data-wrs-verified hidden>
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="6"/><path d="m3.4 6.2 1.8 1.8 3.5-3.6" fill="none" stroke="#fff" stroke-width="1.5"/></svg>
          Verified buyer
        </span>
      </span>
    </div>
  </div>

  <div class="wrs__foot" data-wrs-controls>
    <div class="wrs__progress" aria-hidden="true"><span data-wrs-bar></span></div>
    <span class="wrs__count" data-wrs-count></span>
    <div class="wrs__controls">
      <button type="button" class="wrs__btn" data-wrs-prev aria-label="Previous review">
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M7.5 2 3.5 6l4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button type="button" class="wrs__btn" data-wrs-toggle aria-label="Pause reviews">
        <svg data-icon-pause width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><rect x="2.5" y="2" width="2.6" height="8" rx=".8"/><rect x="6.9" y="2" width="2.6" height="8" rx=".8"/></svg>
        <svg data-icon-play hidden width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 2.2v7.6c0 .4.4.6.7.4l6-3.8a.5.5 0 0 0 0-.8l-6-3.8a.5.5 0 0 0-.7.4z"/></svg>
      </button>
      <button type="button" class="wrs__btn" data-wrs-next aria-label="Next review">
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="m4.5 2 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>
</wave-review-snippets>
<style>
  /* built on the wave-pdp.css tokens so it sits as a quiet sibling of the finance panel above */
  .wrs { --wrs-delay: 6s; display: block; margin: 0.75rem 0 0; padding: 1rem 1.15rem; border: 1px solid var(--wpdp-hair); border-radius: var(--wpdp-radius); background: rgb(var(--wpdp-paper)); }
  .wrs[hidden] { display: none; }
  .wrs__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.35rem 1rem; margin-bottom: 0.75rem; }
  .wrs__title { margin: 0; font-size: 0.95rem; font-weight: 600; line-height: 1.4; }
  .wrs__score { display: inline-flex; align-items: center; gap: 0.4rem; margin: 0; font-size: 0.8125rem; color: rgb(var(--color-foreground) / 0.55); }
  .wrs__average { font-size: 0.95rem; font-weight: 700; color: rgb(var(--wpdp-ink)); font-variant-numeric: tabular-nums; }
  .wrs__stars { color: rgb(var(--wpdp-accent)); letter-spacing: 1px; }
  .wrs__text, .wrs__who { transition: opacity 0.35s ease, transform 0.35s ease; }
  .wrs.is-leaving .wrs__text, .wrs.is-leaving .wrs__who { opacity: 0; transform: translateX(calc(var(--wrs-dir, 1) * -10px)); }
  .wrs.is-entering .wrs__text, .wrs.is-entering .wrs__who { opacity: 0; transform: translateX(calc(var(--wrs-dir, 1) * 10px)); transition: none; }
  .wrs__text { margin: 0; font-size: 1rem; line-height: 1.45; color: rgb(var(--wpdp-ink)); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.9em; }
  .wrs__who { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.75rem; }
  .wrs__avatar { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 2rem; height: 2rem; border-radius: 50%; background: rgb(var(--wpdp-aqua) / 0.45); color: rgb(var(--wpdp-aqua-ink)); font-size: 0.75rem; font-weight: 700; }
  .wrs__person { display: flex; flex-direction: column; min-width: 0; line-height: 1.3; }
  .wrs__name { font-size: 0.875rem; font-weight: 600; }
  .wrs__verified { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.75rem; color: rgb(var(--color-foreground) / 0.55); }
  .wrs__verified svg { fill: rgb(var(--wpdp-aqua-ink)); }
  .wrs__foot { display: flex; align-items: center; gap: 0.75rem; margin-top: 0.9rem; padding-top: 0.75rem; border-top: 1px solid var(--wpdp-hair); }
  .wrs__foot[hidden] { display: none; }
  .wrs__progress { flex: 1; height: 2px; border-radius: 2px; background: var(--wpdp-hair); overflow: hidden; }
  .wrs__progress span { display: block; height: 100%; width: 100%; background: rgb(var(--wpdp-ink)); transform: scaleX(0); transform-origin: left; }
  .wrs.is-timing .wrs__progress span { animation: wrs-fill var(--wrs-delay) linear forwards; }
  .wrs.is-held .wrs__progress span { animation-play-state: paused; }
  @keyframes wrs-fill { to { transform: scaleX(1); } }
  .wrs__count { font-family: var(--font-button-family); font-size: 0.8125rem; font-weight: 500; color: rgb(var(--color-foreground) / 0.55); font-variant-numeric: tabular-nums; min-width: 3em; text-align: center; }
  .wrs__controls { display: flex; gap: 0.35rem; }
  .wrs__btn { display: inline-flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; padding: 0; border: 1px solid var(--wpdp-hair); border-radius: 999px; background: transparent; color: inherit; fill: currentColor; cursor: pointer; transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease; }
  .wrs__btn:hover { background: rgb(var(--color-foreground)); border-color: rgb(var(--color-foreground)); color: rgb(var(--color-background)); }
  .wrs__btn:focus-visible { outline: 2px solid rgb(var(--color-keyboard-focus, 245 158 11)); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .wrs__text, .wrs__who { transition: none; }
    .wrs.is-leaving .wrs__text, .wrs.is-leaving .wrs__who { transform: none; }
  }
</style>
<script>
  if (!customElements.get('wave-review-snippets')) {
    customElements.define('wave-review-snippets', class extends HTMLElement {
      connectedCallback() {
        this.toggle = this.querySelector('[data-wrs-toggle]');
        this.bar = this.querySelector('[data-wrs-bar]');
        this.index = 0;
        this.userPaused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.hovered = false;
        this.visible = false;
        this.load().catch(() => {});
      }
      disconnectedCallback() {
        clearTimeout(this.fade);
        if (this.observer) this.observer.disconnect();
        document.removeEventListener('visibilitychange', this.onVisibility);
      }
      api(path, params) {
        const url = new URL('https://api.reviews.io/' + path);
        Object.entries(params).forEach(([key, value]) => url.searchParams.set(key, value));
        return fetch(url).then((res) => (res.ok ? res.json() : Promise.reject(res.status)));
      }
      async load() {
        const store = this.dataset.store;
        /* 5-star only, named, long enough to say something */
        const named = (who) => who && who.first_name && !/^anonymous$/i.test(who.first_name.trim());
        const keep = (rating, text, who) => Number(rating) === 5 && text && text.trim().length >= 25 && named(who);
        const shape = (text, reviewer) => ({ text: text.trim().replace(/\s+/g, ' '), reviewer: reviewer || {} });
        let reviews = [];
        let stats = null;
        if (this.dataset.skus) {
          const data = await this.api('product/review', { store, sku: this.dataset.skus, per_page: 50, page: 0 });
          reviews = ((data.reviews && data.reviews.data) || []).filter((r) => keep(r.rating, r.review, r.reviewer)).map((r) => shape(r.review, r.reviewer));
          if (data.stats && Number(data.stats.count) > 0) stats = { average: data.stats.average, total: data.stats.count };
        }
        if (reviews.length < 3) {
          const data = await this.api('merchant/reviews', { store, per_page: 50, page: 0 });
          reviews = reviews.concat((data.reviews || []).filter((r) => keep(r.rating, r.comments, r.reviewer)).map((r) => shape(r.comments, r.reviewer)));
          if (!stats && data.stats) stats = { average: data.stats.average_rating, total: data.stats.total_reviews };
        }
        /* short reviews first so most quotes fit in two lines without being cut */
        const short = reviews.filter((r) => r.text.length <= 140);
        reviews = short.concat(reviews.filter((r) => r.text.length > 140)).slice(0, 10);
        if (!reviews.length) return;
        this.reviews = reviews;
        if (stats) {
          this.querySelector('[data-wrs-average]').textContent = Number(stats.average).toFixed(1);
          this.querySelector('[data-wrs-total]').textContent = Number(stats.total).toLocaleString('en-GB') + ' reviews';
          this.querySelector('[data-wrs-rating]').hidden = false;
        }
        this.show(0);
        this.hidden = false;
        this.bind();
      }
      show(index) {
        const review = this.reviews[index];
        const who = review.reviewer;
        /* names typed in capitals read as shouting, so 'TERI' becomes 'Teri' */
        const first = who.first_name.trim();
        const name = first === first.toUpperCase() ? first.charAt(0) + first.slice(1).toLowerCase() : first;
        const initial = who.last_name ? who.last_name.trim().charAt(0).toUpperCase() : '';
        this.querySelector('[data-wrs-text]').textContent = '“' + review.text + '”';
        this.querySelector('[data-wrs-name]').textContent = initial ? name + ' ' + initial + '.' : name;
        this.querySelector('[data-wrs-initials]').textContent = name.charAt(0).toUpperCase() + initial;
        this.querySelector('[data-wrs-verified]').hidden = who.verified_buyer !== 'yes';
        this.querySelector('[data-wrs-count]').textContent = (index + 1) + ' / ' + this.reviews.length;
        this.index = index;
      }
      go(direction) {
        const count = this.reviews.length;
        const target = (this.index + direction + count) % count;
        this.index = target;
        this.style.setProperty('--wrs-dir', direction);
        clearTimeout(this.fade);
        this.classList.add('is-leaving');
        this.fade = setTimeout(() => {
          this.show(target);
          this.classList.remove('is-leaving');
          this.classList.add('is-entering');
          this.offsetWidth;
          this.classList.remove('is-entering');
        }, 350);
        this.restart();
      }
      /* the progress bar is the timer: when it fills, the next review comes in */
      restart() {
        this.classList.remove('is-timing');
        this.bar.offsetWidth;
        if (!this.userPaused) this.classList.add('is-timing');
      }
      bind() {
        if (this.reviews.length < 2) {
          this.querySelector('[data-wrs-controls]').hidden = true;
          return;
        }
        this.querySelector('[data-wrs-prev]').addEventListener('click', () => this.go(-1));
        this.querySelector('[data-wrs-next]').addEventListener('click', () => this.go(1));
        this.bar.addEventListener('animationend', () => this.go(1));
        this.toggle.addEventListener('click', () => {
          this.userPaused = !this.userPaused;
          if (this.userPaused) this.classList.remove('is-timing');
          else this.restart();
          this.sync();
        });
        this.addEventListener('pointerenter', () => { this.hovered = true; this.sync(); });
        this.addEventListener('pointerleave', () => { this.hovered = false; this.sync(); });
        /* keyboard focus holds the timer; a mouse click on an arrow shouldn't leave it stuck */
        this.addEventListener('focusin', (event) => { if (event.target.matches(':focus-visible')) { this.focused = true; this.sync(); } });
        this.addEventListener('focusout', () => { this.focused = false; this.sync(); });
        this.onVisibility = () => this.sync();
        document.addEventListener('visibilitychange', this.onVisibility);
        this.observer = new IntersectionObserver(([entry]) => { this.visible = entry.isIntersecting; this.sync(); });
        this.observer.observe(this);
        this.restart();
        this.sync();
      }
      /* hold the timer while off screen, in a background tab, or while someone is hovering or focused */
      sync() {
        this.classList.toggle('is-held', this.hovered || this.focused || !this.visible || document.hidden);
        this.toggle.setAttribute('aria-label', this.userPaused ? 'Play reviews' : 'Pause reviews');
        this.toggle.querySelector('[data-icon-pause]').hidden = this.userPaused;
        this.toggle.querySelector('[data-icon-play]').hidden = !this.userPaused;
      }
    });
  }
</script>
