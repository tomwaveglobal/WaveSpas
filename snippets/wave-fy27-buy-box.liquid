{%- doc -%}
  Clean buy box for the product-flow-new template: restyles the stepped variant picker
  (product-variant-picker-advanced) and the buy buttons. CSS only; the picker's markup and JS are shared
  with the other PDP templates and stay as they are.

  Picker ("Refined" from the picker lab): small uppercase step names (Colour, Size, Edition; block settings)
  with the chosen option after them in grey; no step numbers or boxes. Colour swatches are rounded squares
  with a black ring on the chosen one. Size and edition are white tiles with a hairline border, the name
  and price (no images, % off or badges); the chosen tile gets a black ring and a soft lift. Out of stock
  swatches are faded and crossed through; unavailable tiles turn soft grey with faint text. The add-ons
  step is a soft panel and, as before, only appears once every option is chosen.
  Buttons: buy button (theme default black) full width, with Contona's "Visualise in Garden" and Restock
  Rocket's "Notify me when available" side by side underneath, styled to match it. Whichever of the two
  is on its own takes the full width.

  {% render 'wave-fy27-buy-box' %}
{%- enddoc -%}
<style>
  /* ═══ Picker: "Refined" (picker lab) ════════════════════════════════
     .vpa[data-vpa-root] keeps these above the picker's own stylesheet, which loads later in the page. */
  .product__info .vpa[data-vpa-root] {
    gap: var(--sp-6);
    --vpa-border: rgb(var(--color-foreground) / 0.1);
    --vpa-border-selected: rgb(var(--color-foreground));
    --vpa-border-strong: rgb(var(--color-foreground));
    --vpa-surface-selected: rgb(var(--color-background));
    --vpa-accent: rgb(var(--color-foreground));
    --wf-line: rgb(var(--color-foreground) / 0.1);
    --wf-line-2: rgb(var(--color-foreground) / 0.18);
    --wf-muted: rgb(var(--color-foreground) / 0.55);
    --wf-faint: rgb(var(--color-foreground) / 0.36);
    --wf-soft: rgb(var(--color-foreground) / 0.035);
    --wf-lift: 0 1px 2px rgb(0 0 0 / 0.04), 0 8px 24px -12px rgb(0 0 0 / 0.18);
  }
  .product__info .vpa[data-vpa-root] .vpa__step,
  .product__info .vpa[data-vpa-root] .vpa__step--complete {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
  }
  .product__info .vpa[data-vpa-root] .vpa__step--locked { opacity: 0.4; }
  /* Step headings: small uppercase name ("COLOUR") with the chosen option after it in grey. No numbers. */
  .product__info .vpa[data-vpa-root] .vpa__head {
    gap: 8px;
    margin-block-end: 12px;
    flex-wrap: nowrap;
    align-items: baseline;
    line-height: 1.25;
  }
  .product__info .vpa[data-vpa-root] .vpa__num { display: none; }
  .product__info .vpa[data-vpa-root] .vpa__title {
    font-size: 11.5px;
    font-weight: var(--font-semibold, 600);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground));
  }
  .product__info .vpa[data-vpa-root] .vpa__status {
    min-width: 0;
    margin-inline-start: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 14px;
    font-weight: var(--font-regular, 400);
    color: var(--wf-muted);
  }
  .product__info .vpa[data-vpa-root] .vpa__status::before { content: none; }

  /* ═══ Colour: rounded-square swatches, black ring on the chosen one ═══ */
  .product__info .vpa[data-vpa-root] .vpa__choices--swatch {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 12px;
  }
  .product__info .vpa[data-vpa-root] .vpa__swatch {
    position: relative;
    width: auto;
    max-width: none;
    gap: 0;
    padding: 3px;
    border-radius: 15px;
    box-shadow: 0 0 0 1px transparent;
    transition: box-shadow 0.18s ease;
  }
  .product__info .vpa[data-vpa-root] .vpa__swatch:has(input:checked) { box-shadow: 0 0 0 2px rgb(var(--color-foreground)); }
  .product__info .vpa[data-vpa-root] .vpa__swatch .vpa__swatch-fill,
  .product__info .vpa[data-vpa-root] .vpa__swatch input:checked + .vpa__swatch-fill {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background-size: cover;
    background-position: center;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08);
    transform: none;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }
  @media screen and (min-width: 768px) {
    .product__info .vpa[data-vpa-root] .vpa__swatch .vpa__swatch-fill,
    .product__info .vpa[data-vpa-root] .vpa__swatch input:checked + .vpa__swatch-fill { width: 58px; height: 58px; }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .product__info .vpa[data-vpa-root] .vpa__swatch:hover .vpa__swatch-fill { transform: translateY(-2px); }
  }
  /* The heading names the chosen colour, so the labels under the swatches are for screen readers only
     (each swatch also has a title tooltip). */
  .product__info .vpa[data-vpa-root] .vpa__swatch-label {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  /* ═══ Size and edition: white tiles with a hairline border and the price; black ring + soft lift when chosen ═══ */
  .product__info .vpa[data-vpa-root] .vpa__choices--tile {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    padding-block-start: 0;
  }
  .product__info .vpa[data-vpa-root] .vpa__choices--tile .vpa__tile {
    padding: 16px 18px;
    border: 0;
    border-radius: 14px;
    background: rgb(var(--color-background));
    box-shadow: inset 0 0 0 1px var(--wf-line);
    transition: box-shadow 0.18s ease, background-color 0.18s ease;
  }
  @media (hover: hover) {
    .product__info .vpa[data-vpa-root] .vpa__choices--tile .vpa__tile:hover { box-shadow: inset 0 0 0 1px var(--wf-line-2); }
  }
  .product__info .vpa[data-vpa-root] .vpa__choices--tile .vpa__tile:has(input:checked),
  .product__info .vpa[data-vpa-root] .vpa__choices--tile .vpa__tile:has(input:checked):hover {
    background: rgb(var(--color-background));
    box-shadow: inset 0 0 0 2px rgb(var(--color-foreground)), var(--wf-lift);
  }
  .product__info .vpa[data-vpa-root] .vpa__tile-media,
  .product__info .vpa[data-vpa-root] .vpa__tile-info,
  .product__info .vpa[data-vpa-root] .vpa__tile .vpa__tag,
  .product__info .vpa[data-vpa-root] .vpa__discount,
  .product__info .vpa[data-vpa-root] .vpa__tile-price del { display: none !important; }
  .product__info .vpa[data-vpa-root] .vpa__tile-body { display: block; }
  .product__info .vpa[data-vpa-root] .vpa__tile-text { display: flex; flex-direction: column; gap: 4px; }
  .product__info .vpa[data-vpa-root] .vpa__tile-name {
    margin: 0;
    font-size: 15px;
    font-weight: var(--font-medium, 500);
    line-height: 1.3;
  }
  .product__info .vpa[data-vpa-root] .vpa__tile-price {
    margin: 0;
    font-size: 13px;
    font-weight: var(--font-regular, 400);
    color: var(--wf-muted);
    font-variant-numeric: tabular-nums;
  }
  /* Pre-order date as small grey text, no pill */
  .product__info .vpa[data-vpa-root] .vpa__chip {
    margin-block-start: 2px;
    padding: 0;
    border-radius: 0;
    background: none;
    color: var(--wf-muted);
    font-size: 11px;
    font-weight: var(--font-regular, 400);
  }
  .product__info .vpa[data-vpa-root] .vpa__chip .icon { display: none; }

  /* ═══ Out of stock ═══
     Swatches: faded and crossed through in grey. Tiles (sold out, or not available with the choices so
     far): soft grey with faint text and no border. */
  .product__info .vpa[data-vpa-root] .vpa__choice--sold-out .vpa__swatch-fill::after { content: none; }
  .product__info .vpa[data-vpa-root] .vpa__swatch.vpa__choice--sold-out .vpa__swatch-fill { opacity: 0.45; filter: grayscale(0.5); }
  .product__info .vpa[data-vpa-root] .vpa__swatch.vpa__choice--sold-out::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 12px;
    background: linear-gradient(to top right, transparent calc(50% - 0.75px), rgb(0 0 0 / 0.45) calc(50% - 0.75px), rgb(0 0 0 / 0.45) calc(50% + 0.75px), transparent calc(50% + 0.75px));
    pointer-events: none;
  }
  .product__info .vpa[data-vpa-root] .vpa__choices--tile .vpa__tile:is(.vpa__tile--sold-out, .vpa__choice--unavailable):not(:has(input:checked)) {
    background: var(--wf-soft);
    box-shadow: none;
  }
  .product__info .vpa[data-vpa-root] .vpa__tile:is(.vpa__tile--sold-out, .vpa__choice--unavailable) :is(.vpa__tile-name, .vpa__tile-price, .vpa__chip) { color: var(--wf-faint); }
  .product__info .vpa[data-vpa-root] .vpa__tile:is(.vpa__tile--sold-out, .vpa__choice--unavailable)::after { content: none; }
  .product__info .vpa[data-vpa-root] .vpa__tile--sold-out .vpa__tile-name,
  .product__info .vpa[data-vpa-root] .vpa__choice--sold-out .vpa__swatch-label { text-decoration: none; }

  /* ═══ 4. Optional add-ons: soft panel, shown once 1-3 are chosen ════ */
  .product__info .vpa[data-vpa-root] .vpa__step--addons .vpa__status { display: none; }
  /* X in the add-ons heading folds the list away and leaves the heading; it turns into + to open it again */
  .product__info .vpa[data-vpa-root] .vpa__step--addons .vpa__head { align-items: center; }
  .product__info .vpa[data-vpa-root] .vpa__step--addons[data-collapsed] .vpa__head { margin-block-end: 0; }
  .product__info .vpa[data-vpa-root] .vpa__step--addons[data-collapsed] .vpa__addon-list { display: none; }
  .wf-addons-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 32px;
    height: 32px;
    margin-inline-start: auto;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: rgb(var(--color-foreground));
    cursor: pointer;
    transition: background-color 0.15s;
  }
  .wf-addons-toggle:hover { background: rgb(var(--color-foreground) / 0.06); }
  .wf-addons-toggle:focus-visible { outline: 2px solid rgb(var(--color-foreground)); outline-offset: 2px; }
  .wf-addons-toggle svg { width: 14px; height: 14px; transform: rotate(45deg); transition: transform 0.2s; }
  .vpa__step--addons[data-collapsed] .wf-addons-toggle svg { transform: rotate(0deg); }
  .product__info .vpa[data-vpa-root] .vpa__step--addons .vpa__title { cursor: pointer; }
  .product__info .vpa[data-vpa-root] .vpa__step--addons[data-revealed='true'] {
    padding: var(--sp-5);
    border: 0;
    border-radius: var(--rounded-card, 14px);
    background: rgb(var(--color-foreground) / 0.03);
  }
  .product__info .vpa[data-vpa-root] .vpa__addon {
    border: 0;
    border-radius: 10px;
    padding: var(--sp-3) var(--sp-4);
    background: rgb(var(--color-background));
  }
  .product__info .vpa[data-vpa-root] .vpa__addon:has(input.vpa__addon-check:checked) {
    background: rgb(var(--color-background));
    box-shadow: inset 0 0 0 1.5px rgb(var(--color-foreground));
  }
  .product__info .vpa[data-vpa-root] .vpa__addon-check { border-width: 1.5px; border-color: rgb(var(--color-foreground) / 0.35); }
  .product__info .vpa[data-vpa-root] .vpa__addon-check:checked { border-color: rgb(var(--color-foreground)); }
  .product__info .vpa[data-vpa-root] .vpa__addon-media { background: rgb(var(--color-foreground) / 0.03); }
  .product__info .vpa[data-vpa-root] .vpa__addon-name { font-weight: var(--font-medium, 500); }
  .product__info .vpa[data-vpa-root] .vpa__addon-price { font-weight: var(--font-regular, 400); }

  /* ═══ Buy buttons ═══════════════════════════════════════════════════
     Buy button full width; Visualise (Contona, in a shadow root styled through its --ctn-* variables)
     and Notify me (Restock Rocket) share the row underneath at the same height, shape and type. */
  .product__info .buy-buttons.grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-3);
  }
  .product__info .buy-buttons > contona-slot > .product-form__submit,
  .product__info .buy-buttons > .product-form__submit {
    grid-column: 1 / -1;
  }
  /* Contona puts its host either beside the buy button (in <contona-slot>) or straight into the info
     column after the buy buttons, depending on the page; style both. */
  .product__info [data-contona-host] {
    margin: var(--sp-3) 0 0 !important;
    --ctn-bg: rgb(var(--color-button-background, 0 0 0)) !important;
    --ctn-fg: rgb(var(--color-button-text, 255 255 255)) !important;
    --ctn-radius: var(--buttons-radius, 999px) !important;
    --ctn-font: var(--font-body-family) !important;
    --ctn-width: 100% !important;
    /* !important: Contona sets these inline on the host. It fixes the button at 44px tall; a border in the button colour brings it to 60px like the others */
    --ctn-border-width: 9px !important;
    --ctn-border: rgb(var(--color-button-background, 0 0 0)) !important;
  }
  .product__info .buy-buttons > contona-slot > [data-contona-host] { grid-column: auto; margin: 0 !important; }
  .product__info .buy-buttons > .restock-rocket-button-container { margin: 0 !important; min-width: 0; }
  .product__info .buy-buttons .restock-rocket-button {
    width: 100% !important;
    min-height: 60px !important;
    height: 60px !important;
    margin: 0 !important;
    padding: 0 var(--sp-4) !important;
    border: 0 !important;
    border-radius: var(--buttons-radius, 999px) !important;
    background: rgb(var(--color-button-background, 0 0 0)) !important;
    color: rgb(var(--color-button-text, 255 255 255)) !important;
    font-family: var(--font-body-family) !important;
    font-size: 15px !important;
    font-weight: 600 !important;
    line-height: 1.2 !important;
  }
  /* Phones: too narrow for two buttons side by side without wrapping, so all three stack full width */
  @media screen and (max-width: 599px) {
    .product__info .buy-buttons.grid { grid-template-columns: minmax(0, 1fr); }
  }
  /* On its own (in stock: no Notify me; no Contona button: Notify me alone), take the full width */
  .product__info .buy-buttons:not(:has(> .restock-rocket-button-container .restock-rocket-button)) > contona-slot > [data-contona-host],
  .product__info .buy-buttons:not(:has(> contona-slot > [data-contona-host]:not([hidden]))) > .restock-rocket-button-container {
    grid-column: 1 / -1;
  }
</style>
<script>
  /* X in the add-ons heading folds the list (it becomes + to open it again); the heading stays, and any ticked
     add-ons stay ticked. The picker's markup is shared with other templates, so the button is added here
     (product-flow-new only). Clicking the heading toggles too. */
  (() => {
    const add = () => {
      document.querySelectorAll('.product__info .vpa__step--addons .vpa__head').forEach((head) => {
        if (head.querySelector('.wf-addons-toggle')) return;
        const step = head.closest('.vpa__step--addons');
        const list = step.querySelector('.vpa__addon-list');
        if (list && !list.id) list.id = 'WfAddons-' + Math.random().toString(36).slice(2, 8);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'wf-addons-toggle';
        if (list) btn.setAttribute('aria-controls', list.id);
        btn.innerHTML = '<svg viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>';
        const sync = () => {
          const collapsed = step.hasAttribute('data-collapsed');
          btn.setAttribute('aria-expanded', String(!collapsed));
          btn.setAttribute('aria-label', collapsed ? 'Show add-ons' : 'Hide add-ons');
        };
        const toggle = () => { step.toggleAttribute('data-collapsed'); sync(); };
        btn.addEventListener('click', toggle);
        head.querySelector('.vpa__title')?.addEventListener('click', toggle);
        head.appendChild(btn);
        sync();
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', add);
    else add();
  })();
</script>
