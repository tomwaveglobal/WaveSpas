{%- doc -%}
  FY27 collection page (new-collection-fy27), styled to match the product-flow-new PDP:
  - Same layout inset as the PDP from 1536px, and theme subtitles as FY27 eyebrows (wave-fy27-pdp-layout)
  - Collection colour (Lite / Lush / Luxe) from the collection handle, as on the PDP (wave-collection-colour)
  - Product tiles: light grey behind the product images (multiplied, as on the PDP's tiles), price on top
    with the compare-at price underneath, no "Save £x"
  - Banner title: keeps the space between the bold first word and the rest ("Lush Collection"); the
    theme's split-words animation drops it
  - Banner with a photo grows to fit its text (it was clipping the title on phones); the editor's
    image height is the minimum

  - ItemList structured data for the products in the collection, so search engines read the page as a
    product category (nothing is output while the collection has no published products)

  Rendered from the template's custom liquid section, so it only affects this template.

  {% render 'wave-fy27-collection-clean' %}
{%- enddoc -%}
{%- render 'wave-fy27-pdp-layout' -%}
{%- render 'wave-collection-colour', handle: collection.handle -%}
{%- if collection.products.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": {{ collection.title | json }},
      "url": {{ request.origin | append: collection.url | json }},
      "numberOfItems": {{ collection.products.size }},
      "itemListElement": [
        {%- for p in collection.products limit: 50 -%}
          {
            "@type": "ListItem",
            "position": {{ forloop.index }},
            "name": {{ p.title | json }},
            "url": {{ request.origin | append: p.url | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
<style>
  /* ═══ Banner title: "Lush Collection", not "LushCollection" ══════════ */
  [id$='__main-collection-banner'] .wf-title-light { margin-inline-start: 0.24em; }

  /* ═══ Banner with a photo: grows to fit its text instead of clipping it ═══
     The theme fixes the banner height and lays the text over it with overflow hidden, which cut off
     the badge and title on phones and the second paragraph on desktop. Here the height chosen in the
     editor (Image height / Mobile image height) becomes a minimum, using the theme's own scale, the
     photo fills the banner, and the text sits at the bottom with room to breathe. */
  [id$='__main-collection-banner'] .banner[class*='media--'] {
    display: flex;
    height: auto;
  }
  [id$='__main-collection-banner'] .banner[class*='media--'] > .banner__media {
    position: absolute;
    inset: 0;
  }
  [id$='__main-collection-banner'] .banner[class*='media--'] > .banner__content {
    position: relative;
    flex: 1 1 auto;
    display: flex;
    height: auto;
  }
  [id$='__main-collection-banner'] .banner[class*='media--'] > .banner__content > .page-width {
    height: auto;
    padding-block: clamp(32px, 4vw, 56px);
  }
  {%- liquid
    assign banner_sizes = '300,400,450,500,550,600,650,700,750,800,850,900' | split: ','
    assign mobile_sizes = '200,250,300,400,500,600' | split: ','
  -%}
  {%- comment -%} Phones (theme: 65% of the setting; "auto"/"adapt" mobile heights keep that, never under 320px) {%- endcomment -%}
  {%- for h in banner_sizes -%}
    {%- assign n = h | times: 1 -%}
  [id$='__main-collection-banner'] .banner.media--{{ h }}px { min-height: max(320px, {{ n | times: 0.65 }}px); }
  {%- endfor %}
  [id$='__main-collection-banner'] .banner.media--100vh { min-height: 100svh; }
  @media screen and (max-width: 767px) {
    {%- for h in mobile_sizes %}
    [id$='__main-collection-banner'] .banner.mobile\:media--{{ h }}px { min-height: {{ h }}px; }
    {%- endfor %}
    [id$='__main-collection-banner'] .banner.mobile\:media--100vh { min-height: 100svh; }
  }
  @media screen and (min-width: 768px) {
    {%- for h in banner_sizes -%}
      {%- assign n = h | times: 1 %}
    [id$='__main-collection-banner'] .banner.media--{{ h }}px { min-height: {{ n | times: 0.85 }}px; }
    {%- endfor %}
  }
  @media screen and (min-width: 1536px) {
    {%- for h in banner_sizes %}
    [id$='__main-collection-banner'] .banner.media--{{ h }}px { min-height: {{ h }}px; }
    {%- endfor %}
  }

  /* ═══ Product tiles: price, then compare-at price; no "Save £x" ═════ */
  [id$='__main-collection'] .price--on-sale,
  [id$='__recently-viewed'] .price--on-sale {
    flex-direction: column;
    flex-wrap: nowrap;
    gap: 2px;
  }
  main .price .price__save { display: none !important; }

  /* ═══ Product tiles: light grey behind the product images (display only) ═══ */
  main .product-card__media .media:not(quick-view .media) {
    background-color: #f4f4f4;
  }
  main .product-card__media .media:not(quick-view .media) img {
    mix-blend-mode: multiply;
  }

</style>
