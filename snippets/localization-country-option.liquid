{%- liquid
  assign link_override = ''
  if country.market.metafields.country.code == 'EU'
    assign link_override = eu_override
  elsif country.market.metafields.country.code == 'US'
    assign link_override = us_override
  elsif country.market.metafields.country.code == 'UK'
    assign link_override = uk_override
  endif

  comment
    Short term: only the US market uses Shopify's lowercase locale slug (/en-us).
    Other markets keep their existing uppercase link until we roll the change out fully.
  endcomment
  assign country_slug = country.iso_code
  if country.iso_code == 'US'
    assign country_slug = 'us'
  endif

  comment
    Keep the visitor on the page they are viewing when they switch market.
    Without this every market link points at that market's homepage, so
    switching country from a product, collection, page or blog lost the page.

    Order of preference:
      1. the market's override metafield, for products listed separately per
         region (e.g. garda-hot-tub -> garda-hot-tub-etl)
      2. the current path, which resolves for any product or page published to
         the target market
      3. the market root, if we are already at the root

    Products carrying a region-specific listing rely on (1), or on a URL
    redirect from the shared handle to the regional one. Without one of those a
    product that is missing from the target market's catalog will bounce.
  endcomment
  assign target_path = ''
  if link_override != blank
    assign target_path = '/' | append: link_override
  else
    assign current_path = request.path
    assign market_root = routes.root_url
    if market_root != '/'
      assign current_path = current_path | remove_first: market_root
    endif
    unless current_path == '/' or current_path == blank
      assign target_path = current_path
    endunless
  endif
-%}
<li class="opacity-0">
  <p>
    <a
      class="reversed-link"
      {% unless country.market.metafields.default.market == true %}
        href="{{ shop.url }}/{{ localization.language.iso_code }}-{{ country_slug }}{{ target_path }}"
      {% else %}
        href="{{ shop.url }}{{ target_path }}"
      {% endunless %}
      title="{{ country.name | escape }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})"
      data-no-instant
    >
      {{- country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
    </a>
  </p>
</li>
