{%- doc -%}
  Renders one country as a market-switcher entry, in whichever shape the host
  control needs.

  Every country selector in the theme routes through here — the announcement
  bar, the mobile header selector, the menu drawer, the header icons dropdown
  and the footer — so they all resolve the same target via
  `localization-market-url` and honour the same per-product regional overrides.
  Previously each mode built its own destination, and the two form-based ones
  (footer, header icons) posted the *current* market's path as `return_to`,
  which bounced the visitor to the homepage.

  @param {object} country - Entry from `localization.available_countries`
  @param {string} [render_as] - `market_links` (default) | `form_anchors` | `select_options`
  @param {string} [current_iso] - Selected country ISO, for active/selected state
  @param {string} [eu_override] - Product URL path override for the EU market
  @param {string} [us_override] - Product URL path override for the US market
  @param {string} [uk_override] - Product URL path override for the UK market
{%- enddoc -%}

{%- capture market_url -%}
  {%- render 'localization-market-url',
    country: country,
    eu_override: eu_override,
    us_override: us_override,
    uk_override: uk_override
  -%}
{%- endcapture -%}
{%- liquid
  assign market_url = market_url | strip
  assign entry_mode = render_as | default: 'market_links'
  assign is_current = false
  if current_iso != blank and country.iso_code == current_iso
    assign is_current = true
  endif
  assign entry_label = country.name | append: ' (' | append: country.currency.iso_code | append: ' ' | append: country.currency.symbol | append: ')'
-%}

{%- case entry_mode -%}
  {%- when 'select_options' -%}
    <option value="{{ country.iso_code }}" data-url="{{ market_url }}"{% if is_current %} selected{% endif %}>
      {{- entry_label -}}
    </option>

  {%- else -%}
    {%- comment -%}
      `market_links` and `form_anchors` render the same thing now: a plain link
      to the resolved market URL. `data-value` is kept so any host still wiring
      up Shopify's localization form can read the ISO code, but the href is a
      real destination rather than "#", so the link works without JavaScript.
    {%- endcomment -%}
    <li class="opacity-0">
      <p>
        {%- comment -%}
          `aria-current` only. The current country deliberately stays a working
          link: marking it `pointer-events-none` (as the old form_anchors mode
          did, where the href was just "#") turns the entry for the market you
          are already in into a dead tap — you press "United Kingdom" while on
          the UK site and nothing happens at all, which reads as a broken
          selector. Main let it navigate; so do we.
        {%- endcomment -%}
        <a
          class="reversed-link"
          href="{{ market_url }}"
          {%- if is_current %} aria-current="true"{% endif %}
          data-value="{{ country.iso_code }}"
          data-url="{{ market_url }}"
          title="{{ entry_label | escape }}"
          data-no-instant
        >
          {{- entry_label -}}
        </a>
      </p>
    </li>
{%- endcase -%}
