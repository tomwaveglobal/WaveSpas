{%- doc -%}
  Black, white and grey clean-up for the product-flow-new page sections (rendered from the template's
  main-product liquid block, so it only affects that template):
  - Compatible accessories tabs styled as the section navigation bar: a grey pill bar, the chosen tab a
    black pill (the bar's grey comes from the scroll-spy section's background setting, #ececec)
  - "Included in the box" images as rounded squares instead of circles
  - Prices (the product's own and the tiles'): price on top, the compare-at price underneath, no "Save £x"
  - Description (collage) as the theme's default: wider text column (2:3) with larger body copy, image
    captions as a small eyebrow over a bold heading (block settings: plain subheading, no highlight)

  {% render 'wave-fy27-pdp-clean' %}
{%- enddoc -%}
<style>
  /* ═══ Compatible accessories tabs, as the nav bar ═══════════════════ */
  [id^='CompatV2Tabs-'] [role='tablist'] {
    display: inline-flex;
    gap: var(--sp-1);
    padding: var(--sp-1);
    border-radius: var(--buttons-radius, 999px);
    background: #ececec;
  }
  [id^='CompatV2Tabs-'] .tab__item.button {
    --color-button-background: 0 0 0 / 0;
    --color-button-border: 0 0 0 / 0;
    --color-button-text: var(--color-foreground);
    min-height: 0;
    height: var(--sp-10d5);
    padding-inline: var(--sp-5);
    border: 0;
    background: transparent;
    color: rgb(var(--color-foreground));
    font-size: var(--text-sm);
    font-weight: var(--font-medium, 500);
  }
  [id^='CompatV2Tabs-'] .tab__item.button[aria-selected='true'] {
    --color-button-background: var(--color-foreground);
    --color-button-border: var(--color-foreground);
    --color-button-text: var(--color-background);
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }
  @media (hover: hover) {
    [id^='CompatV2Tabs-'] .tab__item.button[aria-selected='false']:hover { background: rgb(var(--color-foreground) / 0.06); }
  }
  @media screen and (min-width: 768px) {
    [id^='CompatV2Tabs-'] .tab__item.button { font-size: var(--text-base); }
  }

  /* ═══ Included in the box: rounded squares ══════════════════════════ */
  [id$='__product-details'] .media.rounded-full {
    border-radius: var(--rounded-block, 10px);
  }

  /* ═══ Product tiles: price, then compare-at price; no "Save £x" ═════ */
  main .shopify-section:not([id$='__main-product']) .price--on-sale {
    flex-direction: column;
    flex-wrap: nowrap;
    gap: 2px;
  }
  /* No "Save £x" anywhere on the page: the product's own price (and the sticky bar) as well as the tiles */
  .price .price__save { display: none !important; }
  /* Product price: price, then the compare-at price underneath it */
  .product__info .product__title .price--on-sale {
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: flex-end;
    gap: 2px;
  }

  /* ═══ Description (collage): the theme's default layout and type ════ */
  @media screen and (min-width: 1024px) {
    [id$='__collage'] .collage.on-scroll {
      grid-template-columns: 2fr 3fr;
      gap: clamp(var(--sp-10), 4vw, var(--sp-20));
    }
  }
  [id$='__collage'] .collage .title-wrapper .rte,
  [id$='__collage'] .collage .title-wrapper .rte p {
    font-size: var(--text-base);
    line-height: 1.6;
  }
  @media screen and (min-width: 768px) {
    [id$='__collage'] .collage .title-wrapper .rte,
    [id$='__collage'] .collage .title-wrapper .rte p { font-size: var(--text-lg); }
  }
  [id$='__collage'] .collage.on-scroll .banner__box p { max-width: min(100%, 22rem); }
  [id$='__collage'] .collage .banner__box .text-base:first-child {
    font-size: 15px;
    font-weight: var(--font-medium, 500);
    opacity: 0.9;
  }
  [id$='__collage'] .collage .banner__box .heading {
    font-size: clamp(1.5rem, 2vw, 2rem);
    line-height: 1.05;
  }
</style>
