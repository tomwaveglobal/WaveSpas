    "wf_questions": {
      "type": "wave-fy27-questions",
      "blocks": {
        "q_tier": {
          "type": "question",
          "settings": {
            "topic": "Choosing",
            "question": "Lite, Lush or Luxe: which is right for me?",
            "answer": "<p>Lite is the simple way in, with an open floor to stretch out, bubble massage and a cover included. Lush adds moulded seats and WiFi app control. Luxe adds four hydro-massage jets you can run with the bubbles or on their own. Every spa has WaveFlow™ dual filtration.</p>"
          }
        },
        "q_build": {
          "type": "question",
          "settings": {
            "topic": "Choosing",
            "question": "What's the difference between inflatable, drop stitch, eco foam and frame?",
            "answer": "<p>Inflatable spas are the lightest and pack away easily. Drop stitch walls are firmer, with straighter sides. Eco foam spas have insulated foam walls. Frame spas sit inside a wood-effect frame. Each spa's page shows its size, heater and what's in the box.</p>"
          }
        },
        "q_cost": {
          "type": "question",
          "settings": {
            "topic": "Running costs",
            "question": "How much will it cost to run?",
            "answer": "<p>It depends on the spa, how often you use it and what you pay for electricity. Every spa page has a running-cost calculator, so you can put in your own numbers before you buy.</p>"
          }
        },
        "q_fit": {
          "type": "question",
          "settings": {
            "topic": "",
            "question": "Will it fit in my garden?",
            "answer": "<p>Check the footprint in the size options and leave about a metre around it. It needs flat, firm, level ground. A filled spa can weigh a tonne or more, so decking must be rated for it.</p>"
          }
        },
        "q_winter": {
          "type": "question",
          "settings": {
            "topic": "",
            "question": "Can I use it in winter?",
            "answer": "<p>Yes, all year round. Keep the cover on between soaks. Models with frost protection switch it on by themselves below 5°C.</p>"
          }
        },
        "q_finance": {
          "type": "question",
          "settings": {
            "topic": "Paying",
            "question": "Can I spread the cost?",
            "answer": "<p>Yes. You can pay in 3 or spread the cost monthly at checkout, subject to status. 18+, UK residents only.</p>"
          }
        },
        "q_delivery": {
          "type": "question",
          "settings": {
            "topic": "Delivery",
            "question": "When will it arrive?",
            "answer": "<p>Order by 6:30pm for free next-day delivery with a one-hour DPD window. Saturday delivery is £9.99.</p>"
          }
        },
        "q_planning": {
          "type": "question",
          "settings": {
            "topic": "",
            "question": "Do I need planning permission?",
            "answer": "<p>Usually not in a UK garden. Check with your council if you live in a listed building, a conservation area or a flat, or if your decking is over 30cm high.</p>"
          }
        }
      },
