    "wave_fy27_questions_zCr8mk": {
      "type": "wave-fy27-questions",
      "blocks": {
        "q_where": {
          "type": "question",
          "settings": {
            "topic": "",
            "question": "Can it go indoors or outdoors?",
            "answer": "<p>The infrared sauna is for indoor use only. The barrel and cube are built for the garden, from thermally modified spruce.</p>",
            "only_tag": ""
          }
        },
        "q_diff": {
          "type": "question",
          "settings": {
            "topic": "",
            "question": "What's the difference between infrared and a stove sauna?",
            "answer": "<p>Infrared panels warm you while the air around you stays milder. A stove sauna heats the air and the stones, and a ladle of water on the stones makes steam.</p>",
            "only_tag": ""
          }
        },
        "q_socket": {
          "type": "question",
          "settings": {
            "topic": "",
            "question": "What do I need to plug it in?",
            "answer": "<p>It comes with its power cord. Talk to us before you order and we'll confirm the socket your size needs.</p>",
            "only_tag": "Indoor Sauna"
          }
        },
        "q_floor": {
          "type": "question",
          "settings": {
            "topic": "",
            "question": "Where in the house can it go?",
            "answer": "<p>Any dry room with a level floor and space to open the door. Check your size in the Dimensions tab, including the height.</p>",
            "only_tag": "Indoor Sauna"
          }
        },
        "q_stove": {
          "type": "question",
          "settings": {
            "topic": "",
            "question": "Is the stove included?",
            "answer": "<p>No. The Harvia Vega stove and the sauna stones are sold separately, so you can add them with the sauna. Your size shows the stove output we recommend.</p>",
            "only_tag": "Outdoor Sauna"
          }
        },
        "q_elec": {
          "type": "question",
          "settings": {
            "topic": "",
            "question": "Do I need an electrician?",
            "answer": "<p>Yes. The stove must be installed by a qualified electrician, on its own supply.</p>",
            "only_tag": "Outdoor Sauna"
          }
        },
        "q_base": {
          "type": "question",
          "settings": {
            "topic": "",
            "question": "What does it stand on?",
            "answer": "<p>A flat, level, firm base such as a concrete pad or paving. Check the footprint in the Dimensions tab and leave room to walk around it.</p>",
            "only_tag": "Outdoor Sauna"
          }
        },
        "q_planning": {
          "type": "question",
          "settings": {
            "topic": "",
            "question": "Do I need planning permission?",
            "answer": "<p>Usually not for a garden building this size. Check with your council if you live in a listed building, a conservation area or a flat.</p>",
            "only_tag": "Outdoor Sauna"
          }
        },
        "q_delivery_in": {
          "type": "question",
          "settings": {
            "topic": "",
            "question": "How does it arrive?",
            "answer": "<p>Flat-packed in three cartons, with the glass front already framed.</p>",
            "only_tag": "Indoor Sauna"
          }
        },
        "q_delivery_out": {
          "type": "question",
          "settings": {
            "topic": "",
            "question": "How does it arrive?",
            "answer": "<p>In one wooden crate. The crate size is in the tech specs, so check it against your gate or side access.</p>",
            "only_tag": "Outdoor Sauna"
          }
        }
      },
